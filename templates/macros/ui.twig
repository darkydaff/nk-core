{# templates/macros/ui.twig #}

{% macro status_badge(status, label = null, id = null) %}
    {% set status = status|lower %}
    {% set label = label ?: status|capitalize %}
    
    {% set colors = {
        'active': 'bg-sky-500/10 text-sky-500 border-sky-500/20',
        'online': 'bg-sky-500/10 text-sky-500 border-sky-500/20',
        'offline': 'bg-red-500/10 text-red-400 border-red-500/20',
        'error': 'bg-red-500/10 text-red-400 border-red-500/20',
        'disabled': 'bg-amber-500/10 text-amber-500 border-amber-500/20',
        'never': 'bg-slate-500/10 text-slate-400 border-slate-500/20',
        'deploying': 'bg-primary/10 text-primary border-primary/20',
        'provisioning': 'bg-primary/10 text-primary border-primary/20'
    } %}

    {% set class = colors[status] ?: 'bg-slate-500/10 text-slate-400 border-slate-500/20' %}
    
    <span {% if id %}id="{{ id }}"{% endif %} class="inline-flex items-center justify-center px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wide border {{ class }} leading-none h-fit">
        {% if status in ['online', 'deploying', 'provisioning'] %}
            <span class="w-1 h-1 rounded-full bg-current mr-1.5 animate-pulse flex-shrink-0"></span>
        {% endif %}
        {{ label }}
    </span>
{% endmacro %}

{% macro icon_button(icon, action, title = null, class = 'btn-secondary') %}
    <button onclick="{{ action }}" class="{{ class }} p-2 rounded-lg transition-all" title="{{ title }}">
        <i class="fas {{ icon }}"></i>
    </button>
{% endmacro %}

{% macro alert(type, message, icon = null) %}
    {% set types = {
        'success': { 'bg': 'bg-green-500/10', 'border': 'border-green-500/20', 'text': 'text-green-500', 'icon': 'fa-check-circle' },
        'error': { 'bg': 'bg-red-500/10', 'border': 'border-red-500/20', 'text': 'text-red-400', 'icon': 'fa-exclamation-circle' },
        'warning': { 'bg': 'bg-amber-500/10', 'border': 'border-amber-500/20', 'text': 'text-amber-500', 'icon': 'fa-exclamation-triangle' },
        'info': { 'bg': 'bg-sky-500/10', 'border': 'border-sky-500/20', 'text': 'text-sky-400', 'icon': 'fa-info-circle' }
    } %}
    {% set config = types[type] ?: types.info %}
    {% set icon = icon ?: config.icon %}

    <div class="mb-6 {{ config.bg }} {{ config.border }} {{ config.text }} border px-4 py-3 rounded-xl flex items-center transition-all animate-in fade-in slide-in-from-top-2">
        <i class="fas {{ icon }} mr-3 text-sm opacity-80"></i>
        <p class="text-xs font-bold uppercase tracking-widest">{{ message }}</p>
    </div>
{% endmacro %}
