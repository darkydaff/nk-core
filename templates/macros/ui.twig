{# templates/macros/ui.twig #}

{# 1. Status Badges #}
{% macro status_badge(status, label = null, id = null) %}
    {% set status = status|lower %}
    {% set label = label ?: status|capitalize %}
    
    {% set colors = {
        'active': 'bg-sky-500/10 text-sky-500 border-sky-500/20',
        'online': 'bg-sky-500/10 text-sky-500 border-sky-500/20',
        'offline': 'bg-red-500/10 text-red-400 border-red-500/20',
        'error': 'bg-red-500/10 text-red-400 border-red-500/20',
        'disabled': 'bg-amber-500/10 text-amber-500 border-amber-500/20',
        'never': 'bg-slate-500/10 text-slate-400 border-slate-500/20',
        'deploying': 'bg-primary/10 text-primary border-primary/20',
        'provisioning': 'bg-primary/10 text-primary border-primary/20'
    } %}

    {% set class = colors[status] ?: 'bg-slate-500/10 text-slate-400 border-slate-500/20' %}
    
    <span {% if id %}id="{{ id }}"{% endif %} class="inline-flex items-center justify-center px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wide border {{ class }} leading-none h-fit">
        {% if status in ['online', 'deploying', 'provisioning'] %}
            <span class="w-1 h-1 rounded-full bg-current mr-1.5 animate-pulse flex-shrink-0"></span>
        {% endif %}
        {{ label }}
    </span>
{% endmacro %}

{# 2. Accessible Buttons #}
{% macro button(label, action = null, type = 'button', variant = 'primary', icon = null, class = '', id = '', disabled = false) %}
    {% set variants = {
        'primary': 'btn-primary',
        'secondary': 'btn-secondary',
        'destructive': 'bg-red-500 hover:bg-red-600 text-white font-semibold transition-all shadow-sm rounded-lg hover:shadow-lg focus:ring-4 focus:ring-red-500/20'
    } %}
    
    {% set baseClass = variants[variant] ?: 'btn-primary' %}
    
    <button 
        type="{{ type }}" 
        {% if action %}onclick="{{ action }}"{% endif %}
        {% if id %}id="{{ id }}"{% endif %}
        class="{{ baseClass }} px-4 py-2 text-xs font-semibold rounded-lg flex items-center justify-center gap-2 transition-all {{ class }}"
        {% if disabled %}disabled{% endif %}
    >
        {% if icon %}<i class="fas {{ icon }} text-xs opacity-90"></i>{% endif %}
        {{ label }}
    </button>
{% endmacro %}

{% macro panel(content, title = null, subtitle = null, class = '', padding = 'p-6') %}
    <div class="panel overflow-hidden transition-all {{ padding }} {{ class }}">
        {% if title %}
            <div class="mb-4 border-b border-surface-border/40 pb-3">
                <h3 class="text-sm font-semibold tracking-tight text-primary uppercase">{{ title }}</h3>
                {% if subtitle %}
                    <p class="text-[11px] text-secondary mt-0.5 font-medium">{{ subtitle }}</p>
                {% endif %}
            </div>
        {% endif %}
        <div class="panel-body leading-relaxed text-sm text-secondary">
            {{ content|raw }}
        </div>
    </div>
{% endmacro %}

{# 4. Accessible Text Input Controls #}
{% macro input(name, label = null, placeholder = '', value = '', type = 'text', required = false, class = '', id = '', icon = null) %}
    <div class="flex flex-col gap-1.5 w-full">
        {% if label %}
            <label for="{{ id|default(name) }}" class="text-[10px] text-muted uppercase font-bold tracking-widest">{{ label }}{% if required %}<span class="text-red-500 ml-0.5">*</span>{% endif %}</label>
        {% endif %}
        <div class="relative w-full">
            {% if icon %}
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-muted pointer-events-none">
                    <i class="fas {{ icon }} text-xs"></i>
                </span>
            {% endif %}
            <input 
                type="{{ type }}" 
                name="{{ name }}" 
                placeholder="{{ placeholder }}" 
                value="{{ value }}" 
                {% if required %}required{% endif %}
                class="input-field {{ icon ? 'pl-9' : '' }} {{ class }}"
            id="{{ id|default(name) }}"
            />
        </div>
    </div>
{% endmacro %}

{# 5. Accessible Select Controls #}
{% macro select(name, options = [], label = null, selected = '', required = false, class = '', id = '') %}
    <div class="flex flex-col gap-1.5 w-full">
        {% if label %}
            <label for="{{ id|default(name) }}" class="text-[10px] text-muted uppercase font-bold tracking-widest">{{ label }}</label>
        {% endif %}
        <select 
            name="{{ name }}"
            id="{{ id|default(name) }}"
            {% if required %}required{% endif %}
            class="input-field cursor-pointer {{ class }}"
        >
            {% for opt in options %}
                <option value="{{ opt.value }}" {% if opt.value == selected %}selected{% endif %}>{{ opt.label }}</option>
            {% endfor %}
        </select>
    </div>
{% endmacro %}

{# 6. Rich Spacing Alerts #}
{% macro alert(type, message, icon = null) %}
    {% set types = {
        'success': { 'bg': 'bg-green-500/10', 'border': 'border-green-500/20', 'text': 'text-green-500', 'icon': 'fa-check-circle' },
        'error': { 'bg': 'bg-red-500/10', 'border': 'border-red-500/20', 'text': 'text-red-400', 'icon': 'fa-exclamation-circle' },
        'warning': { 'bg': 'bg-amber-500/10', 'border': 'border-amber-500/20', 'text': 'text-amber-500', 'icon': 'fa-exclamation-triangle' },
        'info': { 'bg': 'bg-sky-500/10', 'border': 'border-sky-500/20', 'text': 'text-sky-400', 'icon': 'fa-info-circle' }
    } %}
    {% set config = types[type] ?: types.info %}
    {% set icon = icon ?: config.icon %}

    <div class="mb-6 {{ config.bg }} {{ config.border }} {{ config.text }} border px-4 py-3 rounded-xl flex items-center transition-all animate-in fade-in slide-in-from-top-2">
        <i class="fas {{ icon }} mr-3 text-sm opacity-80"></i>
        <p class="text-xs font-bold uppercase tracking-widest">{{ message }}</p>
    </div>
{% endmacro %}

{# 7. Shimmering Skeleton Loaders #}
{% macro skeleton_loader(count = 1, height = 'h-16', class = '') %}
    <div class="flex flex-col gap-4 w-full">
        {% for i in 1..count %}
            <div class="w-full {{ height }} bg-surface-hover/30 rounded-xl animate-pulse border border-surface-border/20 flex items-center justify-between px-4 {{ class }}">
                <div class="flex items-center gap-3 w-2/3">
                    <div class="w-10 h-10 bg-surface-hover/60 rounded-lg flex-shrink-0"></div>
                    <div class="flex flex-col gap-2 w-full">
                        <div class="w-1/3 h-3 bg-surface-hover/80 rounded"></div>
                        <div class="w-1/2 h-2.5 bg-surface-hover/60 rounded"></div>
                    </div>
                </div>
                <div class="w-16 h-5 bg-surface-hover/70 rounded-md"></div>
            </div>
        {% endfor %}
    </div>
{% endmacro %}

{# 8. Standard Empty State Component #}
{% macro empty_state(title, message, icon = 'fa-folder-open', buttonLabel = '', buttonAction = '', buttonIcon = '') %}
    <div class="flex flex-col items-center justify-center p-12 text-center rounded-2xl border border-dashed border-surface-border/60 bg-surface-panel/10">
        <div class="w-16 h-16 rounded-full bg-surface-hover flex items-center justify-center text-muted mb-4 border border-surface-border/40">
            <i class="fas {{ icon }} text-2xl"></i>
        </div>
        <h3 class="text-sm font-semibold text-primary uppercase">{{ title }}</h3>
        <p class="text-xs text-secondary mt-1.5 max-w-sm leading-relaxed">{{ message }}</p>
        {% if buttonLabel and buttonAction %}
            <div class="mt-5">
                <button 
                    type="button" 
                    onclick="{{ buttonAction }}"
                    class="btn-primary px-4 py-2 text-xs font-semibold rounded-lg flex items-center justify-center gap-2 transition-all"
                >
                    {% if buttonIcon %}<i class="fas {{ buttonIcon }} text-xs opacity-90"></i>{% endif %}
                    {{ buttonLabel }}
                </button>
            </div>
        {% endif %}
    </div>
{% endmacro %}
