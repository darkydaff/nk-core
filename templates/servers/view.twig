                    <td class="px-5 py-4">
                        <div class="flex flex-col">
                            <div class="flex items-center gap-1.5 mb-1">
                                <div class="flex items-center px-1.5 py-1 rounded ${isDisabled ? 'bg-orange-500/10' : (client.connection_status === 'online' ? 'bg-sky-500/10' : (client.connection_status === 'never' ? 'bg-slate-500/10' : 'bg-red-500/10'))} border ${isDisabled ? 'border-orange-500/20' : (client.connection_status === 'online' ? 'border-sky-500/20' : (client.connection_status === 'never' ? 'border-slate-500/20' : 'border-red-500/20'))} h-5">
                                    <span class="w-1 h-1 rounded-full ${isDisabled ? 'bg-orange-500' : (client.connection_status === 'online' ? 'bg-sky-500 animate-pulse' : (client.connection_status === 'never' ? 'bg-slate-400' : 'bg-red-500'))} mr-1.5"></span>
                                    <span class="text-[9px] uppercase tracking-wider ${isDisabled ? 'text-orange-500' : (client.connection_status === 'online' ? 'text-sky-500' : (client.connection_status === 'never' ? 'text-slate-500' : 'text-red-500'))} font-bold leading-none">
                                        ${isDisabled ? labels.revoked : (client.connection_status === 'online' ? labels.online : (client.connection_status === 'never' ? labels.never : labels.offline))}
                                    </span>
                                </div>
