                            <div class="flex gap-2">
                                <span class="text-[9px] dark:text-sky-400 text-sky-600 font-bold flex items-center bg-sky-500/10 px-1.5 py-0.5 rounded border border-sky-500/20"><i class="fas fa-arrow-down mr-1 opacity-70"></i>${client.speed_down}</span>
                                <span class="text-[9px] dark:text-indigo-400 text-indigo-600 font-bold flex items-center bg-indigo-500/10 px-1.5 py-0.5 rounded border border-indigo-500/20"><i class="fas fa-arrow-up mr-1 opacity-70"></i>${client.speed_up}</span>
