document.addEventListener('DOMContentLoaded', function () {
const searchInput = document.getElementById('clientSearch');
const resultsContainer = document.getElementById('searchResults');
const statusFilter = document.getElementById('statusFilter');
const trafficFilter = document.getElementById('trafficFilter');
const sortFilter = document.getElementById('sortFilter');
const batchActionBar = document.getElementById('batchActionBar');
const selectedCountText = document.getElementById('selectedCountText');

let searchTimeout = null;

let transitionPoll = null;

function performSearch(isAutoRefresh = false) {
    const query = searchInput.value.trim();
    const serverId = {{ server.id }};
    const status = statusFilter.value;
    const traffic = trafficFilter.value;
    const sort = sortFilter.value;
    
    // Save selected checkboxes
    const selectedIds = Array.from(document.querySelectorAll('.client-checkbox:checked')).map(cb => cb.value);
    
    clearTimeout(transitionPoll);
    
    const url = `/api/search-clients?q=${encodeURIComponent(query)}&server_id=${serverId}&status=${status}&traffic=${traffic}&sort=${sort}`;
    
    // Only show spinner if container is empty and it's NOT an auto-refresh
    if (resultsContainer.innerHTML.trim() === '' && !isAutoRefresh) {
        resultsContainer.innerHTML = `
            <div class="flex items-center justify-center h-64">
                <div class="text-center">
                    <div class="animate-spin text-primary text-2xl mb-3">
                        <i class="fas fa-circle-notch"></i>
                    </div>
                    <p class="text-sm text-muted">${labels.searching}</p>
                </div>
            </div>
        `;
    }

    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(response => response.json())
        .then(data => {
            if (data.error) throw new Error(data.error);
            renderResults(data.results);
            
            // Restore selected checkboxes
            document.querySelectorAll('.client-checkbox').forEach(cb => {
                if (selectedIds.includes(cb.value)) cb.checked = true;
            });
            updateBatchBar();

            // Update Summary Stats
            if (data.summary) {
                const s = data.summary;
                document.getElementById('summary-total').innerText = s.total;
                document.getElementById('summary-online').innerText = s.online;
                document.getElementById('summary-inbound').innerText = (s.traffic.received / 1073741824).toFixed(2);
                document.getElementById('summary-outbound').innerText = (s.traffic.sent / 1073741824).toFixed(2);
            }

            // Schedule next refresh (every 10s if tab is active)
            const refreshDelay = 10000;
            transitionPoll = setTimeout(() => {
                // Only auto-refresh if user isn't searching or if it's the server view
                if (document.visibilityState === 'visible') {
                    performSearch(true);
                } else {
                    // If tab hidden, wait longer
                    transitionPoll = setTimeout(() => performSearch(true), refreshDelay);
                }
            }, refreshDelay);
        })
        .catch(err => {
            if (!isAutoRefresh) {
                resultsContainer.innerHTML = `<div class="p-10 text-center text-red-500">Error: ${err.message}</div>`;
            }
        });
}

