function updateBatchBar() {
    const selected = document.querySelectorAll('.client-checkbox:checked');
    if (selected.length > 0) {
        batchActionBar.classList.remove('hidden');
        selectedCountText.innerText = labels.selected.replace('%s', selected.length);
    } else {
        batchActionBar.classList.add('hidden');
    }
}

window.handleBatchAction = async function(action) {
    const selected = Array.from(document.querySelectorAll('.client-checkbox:checked')).map(cb => cb.value);
    if (selected.length === 0) return;

    const confirmMsg = action === 'delete' ? labels.confirmDelete : null;
    if (confirmMsg && !confirm(confirmMsg)) return;

    handleAjaxAction('/clients/batch', { ids: selected, action: action }, null);
};

window.clientAction = async function (id, action, btn) {
    const confirmMsg = action === 'delete' ? labels.confirmDelete : null;
    handleAjaxAction(`/clients/${id}/${action}`, {}, confirmMsg);
};

// Event Listeners
searchInput.addEventListener('input', function (e) {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => performSearch(), 300);
});

[statusFilter, trafficFilter, sortFilter].forEach(el => {
    if (el) el.addEventListener('change', () => performSearch());
});

// Initial load
performSearch();
});

function initBeszel(ip) {
if (! ip) 
return;


fetch('/api/monitoring/beszel/' + ip).then(response => response.json()).then(res => {
if (res.success && res.data) {
const data = res.data;
const info = data.info || {};

document.getElementById('beszel-health-section').classList.remove('hidden');

// Update Hub Link to specific system
const hubLink = document.querySelector('a[title="Open Beszel Hub"]');
if (hubLink && data.id) {
const baseUrl = '{{ beszel_config.url }}'.replace(/\/$/, '');
hubLink.href = `${baseUrl}/system/${
data.id
}`;
}

// CPU
const cpu = info.cpu || 0;
document.getElementById('beszel-cpu-val').innerText = cpu.toFixed(1) + '%';
document.getElementById('beszel-cpu-bar').style.width = cpu + '%';
document.getElementById('beszel-cpu-info').innerText = (info.t || '?') + ' {{ t('monitoring.threads') }}';

// RAM
const ram = info.mp || 0;
document.getElementById('beszel-ram-val').innerText = ram.toFixed(1) + '%';
document.getElementById('beszel-ram-bar').style.width = ram + '%';
// Try to find memory capacity (in stats.m or data.m)
const stats = data.stats || {};
const totalMem = stats.m || data.m || info.m;
if (totalMem) {
document.getElementById('beszel-ram-info').innerText = totalMem.toFixed(1) + ' GB {{ t('monitoring.capacity') }}';
}

// Disk
const disk = info.dp || 0;
document.getElementById('beszel-disk-val').innerText = disk.toFixed(1) + '%';
document.getElementById('beszel-disk-bar').style.width = disk + '%';
// Try to find disk capacity (in stats.d or data.d)
const totalDisk = stats.d || data.d || info.d;
if (totalDisk) {
document.getElementById('beszel-disk-info').innerText = totalDisk.toFixed(0) + ' GB {{ t('monitoring.total_space') }}';
}

// Bandwidth calculation (Mbps)
// Use 'bb' (Bytes per second) from info if available
let rx_mbps = 0,
tx_mbps = 0,
total_mbps = 0;

if (info.bb) {
total_mbps = (info.bb * 8) / 1000000;
// For split RX/TX, we still need ns/nr or b
if (stats.nr || stats.ns) {
rx_mbps = (stats.nr || 0) * 8;
tx_mbps = (stats.ns || 0) * 8;
} else if (stats.b && Array.isArray(stats.b)) {
tx_mbps = (stats.b[0] * 8) / (15 * 1000000);
rx_mbps = (stats.b[1] * 8) / (15 * 1000000);
}
} else {
if (stats.nr || stats.ns) {
rx_mbps = (stats.nr || 0) * 8;
tx_mbps = (stats.ns || 0) * 8;
} else if (stats.b && Array.isArray(stats.b)) {
tx_mbps = (stats.b[0] * 8) / (15 * 1000000);
rx_mbps = (stats.b[1] * 8) / (15 * 1000000);
}
total_mbps = rx_mbps + tx_mbps;
}

const fmtBw = (val) => val >= 1000 ? (val / 1000).toFixed(2) + ' {{ t('common.gbps') }}' : val.toFixed(1) + ' {{ t('common.mbps') }}';

document.getElementById('beszel-bw-rx').innerText = fmtBw(rx_mbps);
document.getElementById('beszel-bw-tx').innerText = fmtBw(tx_mbps);
document.getElementById('beszel-bw-total').innerText = fmtBw(total_mbps);

// Load & Uptime
if (info.la) {
document.getElementById('beszel-load').innerText = info.la.map(l => l.toFixed(2)).join(' ');
}

if (info.u) {
const days = Math.floor(info.u / 86400);
const hours = Math.floor((info.u % 86400) / 3600);
document.getElementById('beszel-uptime').innerText = `{{ t('monitoring.uptime') }}: ${days}d ${hours}h`;
}
}
}).catch(err => console.error('Beszel error:', err));
}

document.addEventListener('DOMContentLoaded', function () {
initBeszel('{{ server.host }}');
// Refresh every 15 seconds to match Beszel agent
setInterval(() => initBeszel('{{ server.host }}'), 15000);
});

// ===== Smart Polling (deploying state) =====
(function () {
	const currentStatus = '{{ server.status }}';
	if (currentStatus !== 'deploying') return;

	const serverId = {{ server.id }};
	let pollTimer = null;

	function pollStatus() {
		fetch(`/servers/${serverId}/status`, {
			headers: { 'X-Requested-With': 'XMLHttpRequest' }
		})
		.then(r => r.json())
		.then(data => {
			if (data.status && data.status !== 'deploying') {
				// Server finished — clear saved scroll so reload starts at top
				localStorage.removeItem('globalScrollPos');
				clearInterval(pollTimer);
				window.location.reload();
			}
		})
		.catch(() => { /* ignore transient errors, keep polling */ });
	}

	// Start polling every 2.5 seconds
	pollTimer = setInterval(pollStatus, 2500);
})();

// ===== Log Modal =====
let _logsServerId = null;
let _logsRefreshTimer = null;

window.openLogsModal = function (serverId) {
	_logsServerId = serverId;
	// Clear any stale timer from a previous open (prevents double-interval accumulation)
	if (_logsRefreshTimer !== null) {
		clearTimeout(_logsRefreshTimer);
		_logsRefreshTimer = null;
	}
	document.getElementById('logsModal').classList.remove('hidden');
	document.body.style.overflow = 'hidden';
	fetchLogs();
};

window.closeLogsModal = function () {
	document.getElementById('logsModal').classList.add('hidden');
	document.body.style.overflow = '';
	if (_logsRefreshTimer !== null) {
		clearTimeout(_logsRefreshTimer);
		_logsRefreshTimer = null;
	}
};

window.refreshLogs = function () {
	// Cancel any pending auto-refresh before manual refresh
	if (_logsRefreshTimer !== null) {
		clearTimeout(_logsRefreshTimer);
		_logsRefreshTimer = null;
	}
	fetchLogs();
};

function fetchLogs() {
	if (!_logsServerId) return;
	fetch(`/servers/${_logsServerId}/logs`, {
		headers: { 'X-Requested-With': 'XMLHttpRequest' }
	})
	.then(r => r.json())
	.then(data => {
		renderLogs(data.logs || []);
		// Schedule next refresh AFTER this one completes (eliminates overlapping fetches)
		if (document.getElementById('logsModal') &&
			!document.getElementById('logsModal').classList.contains('hidden')) {
			_logsRefreshTimer = setTimeout(fetchLogs, 5000);
		}
	})
	.catch(err => {
		document.getElementById('logsBody').innerHTML =
			`<p class="text-red-400">${labels.logsFailed}: ${err.message}</p>`;
		// Retry after 8s on error
		if (document.getElementById('logsModal') &&
			!document.getElementById('logsModal').classList.contains('hidden')) {
			_logsRefreshTimer = setTimeout(fetchLogs, 8000);
		}
	});
}

function renderLogs(logs) {
	const body    = document.getElementById('logsBody');
	const countEl = document.getElementById('logsCount');

	if (!logs || logs.length === 0) {
		body.innerHTML = `<p class="text-slate-500 italic">${labels.noLogs}</p>`;
		countEl.textContent = `0 ${labels.logEntries}`;
		return;
	}

	countEl.textContent = logs.length + ' ' + labels.logEntries;

	const lines = logs.map(entry => {
		const level   = (entry.level_name || 'INFO').toUpperCase();
		const channel = entry.channel_source || entry.channel || '';
		const msg     = entry.message || '';
		const ctx     = entry.context || {};

		// Timestamp — keep only HH:MM:SS portion
		const rawDt  = entry.datetime || '';
		const dtPart = rawDt.includes('T')
			? rawDt.split('T')[1]?.split('+')[0]?.split('-')[0]?.substring(0,8)
			: rawDt.substring(11,19);

		// Color-code by level
		let levelClass = 'text-slate-400';
		if (['ERROR','CRITICAL','ALERT','EMERGENCY'].includes(level)) {
			levelClass = 'text-red-400 font-bold';
		} else if (level === 'WARNING') {
			levelClass = 'text-yellow-400';
		} else if (level === 'INFO') {
			levelClass = (channel === 'ssh' || ctx.command) ? 'text-blue-400' : 'text-cyan-400';
		} else if (level === 'DEBUG') {
			levelClass = 'text-slate-500';
		}

		// Build context snippet (skip server_id — always the same)
		const ctxFiltered = Object.fromEntries(
			Object.entries(ctx).filter(([k]) => k !== 'server_id')
		);
		const ctxStr = Object.keys(ctxFiltered).length
			? ' <span class="text-slate-600">' + escapeHtml(JSON.stringify(ctxFiltered)) + '</span>'
			: '';

		// Override color for SSH command results
		let finalClass = levelClass;
		if (ctx.exit_code === 0 || (ctx.output && ctx.exit_code === undefined)) {
			finalClass = 'text-green-400';
		} else if (ctx.exit_code !== undefined && ctx.exit_code !== 0) {
			finalClass = 'text-red-400 font-bold';
		}

		const channelBadge = `<span class="text-[9px] px-1 py-0.5 rounded bg-slate-800 text-slate-500 mr-1.5 uppercase tracking-wider">${escapeHtml(channel)}</span>`;

		return `<div class="py-0.5 flex flex-wrap gap-1 items-baseline border-b border-slate-800/40">`
			+ `<span class="text-slate-600 flex-shrink-0 mr-1">${escapeHtml(dtPart || '??:??:??')}</span>`
			+ channelBadge
			+ `<span class="${finalClass} flex-shrink-0">[${level}]</span> `
			+ `<span class="text-slate-200 break-all">${escapeHtml(msg)}</span>`
			+ ctxStr
			+ `</div>`;
	});

	body.innerHTML = lines.join('');

	// Auto-scroll to bottom if checkbox is checked
	if (document.getElementById('logsAutoScroll')?.checked) {
		body.scrollTop = body.scrollHeight;
	}
}

function escapeHtml(str) {
	if (typeof str !== 'string') str = JSON.stringify(str);
	return str
		.replace(/&/g, '&amp;')
		.replace(/</g, '&lt;')
		.replace(/>/g, '&gt;')
		.replace(/"/g, '&quot;');
}

// Close modal on Escape key
document.addEventListener('keydown', e => {
	if (e.key === 'Escape') closeLogsModal();
});
	</script>
{% endblock %}
