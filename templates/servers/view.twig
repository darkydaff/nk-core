{% extends "layout.twig" %}
{% block title %}
	{{ server.name }}
{% endblock %}

{% block breadcrumbs %}
    <li class="flex items-center">
        <a href="/servers" class="hover:text-primary">{{ t('menu.servers') }}</a>
    </li>
    <li class="flex items-center">
        <i class="fas fa-chevron-right mx-2 opacity-30"></i>
        <span>{{ server.name }}</span>
    </li>
{% endblock %}

{% block content %}
	<div class="w-full mx-auto max-w-7xl">
		<div class="mb-6 flex flex-col md:flex-row md:items-start justify-between gap-4">
			<div>
				<h1 class="text-3xl font-bold flex items-center tracking-tight">
					<div class="w-12 h-12 rounded-xl bg-surface-hover text-primary flex items-center justify-center mr-4 shadow-inner overflow-hidden">
						{% if server.country_code %}
							<span class="text-5xl">{{ getFlag(server.country_code)|raw }}</span>
						{% else %}
							<i class="fas fa-server"></i>
						{% endif %}
					</div>
					{{ server.name }}
				</h1>
				<div class="mt-2 ml-13 flex flex-wrap items-center gap-3">
					<code class="text-xs text-secondary bg-panel px-2 py-1 rounded">{{ server.host }}</code>
					{% if server.city or server.isp %}
						<div class="flex items-center gap-1.5 px-2 py-1 rounded bg-panel/40 border border-white/5">
							<i class="fas fa-map-marker-alt text-[10px] text-primary opacity-70"></i>
							<span class="text-[10px] font-bold text-muted uppercase tracking-tight">
								{% if server.city %}{{ server.city }}{% endif %}
								{% if server.city and server.isp %} • {% endif %}
								{% if server.isp %}{{ server.isp }}{% endif %}
							</span>
						</div>
					{% endif %}
					{% if server.status == 'active' %}
						<span class="badge-active text-xs px-2 py-1 rounded-md flex items-center">
							<span class="w-1.5 h-1.5 rounded-full bg-cyan-400 mr-1.5"></span>
							{{ t('status.active') }}
						</span>
					{% elseif server.status == 'deploying' %}
						<span class="text-xs px-2 py-1 rounded-md flex items-center bg-amber-500/15 border border-amber-500/30 text-amber-400">
							<i class="fas fa-spinner fa-spin text-[8px] mr-1.5"></i>
							{{ t('status.deploying')|default('Deploying…') }}
						</span>
					{% else %}
						<div class="flex items-center gap-2">
							<span class="badge-error text-xs px-2 py-1 rounded-md flex items-center">
								<span class="w-1.5 h-1.5 rounded-full bg-red-400 mr-1.5"></span>
								{{ t('status.' ~ server.status)|default(server.status) }}
							</span>
							{% if server.error_message %}
								<div class="group relative inline-block">
									<i class="fas fa-exclamation-triangle text-amber-500 text-xs cursor-help animate-pulse"></i>
									<div class="absolute left-0 bottom-full mb-2 w-72 p-3 bg-slate-900 border border-red-500/30 rounded-lg text-[10px] text-red-200 shadow-2xl opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-[100] font-mono leading-relaxed">
										<div class="text-red-400 font-bold mb-1 uppercase tracking-tighter border-b border-red-500/20 pb-1">Last Deployment Error:</div>
										{{ server.error_message }}
									</div>
								</div>
							{% endif %}
							<button onclick="window.serverView.syncStats({{ server.id }})" class="w-6 h-6 rounded-full bg-surface-hover flex items-center justify-center text-muted hover:text-primary transition-all border border-surface-border/50" title="{{ t('common.recheck')|default('Recheck Connectivity') }}">
								<i class="fas fa-redo-alt text-[10px]"></i>
							</button>
						</div>
					{% endif %}
					{% if server.last_check_at %}
						<span class="text-[10px] text-muted flex items-center bg-panel/50 px-2 py-1 rounded border border-surface-border/30" title="{{ t('common.last_sync') }}">
							<i class="fas fa-clock mr-1.5 opacity-50"></i>
							{{ t('common.last_sync') }}: {{ server.last_check_at|date('H:i:s') }}
						</span>
					{% endif %}
				</div>
			</div>
			<div class="flex gap-2 items-center flex-wrap">
				<button onclick="window.serverView.syncStats({{ server.id }})" id="syncBtn" class="btn-secondary px-4 py-2 text-sm flex items-center">
					<i class="fas fa-sync-alt mr-2" id="syncIcon"></i>
					{{ t('servers.sync_stats') }}
				</button>
				<button onclick="window.serverView.openLogsModal({{ server.id }})" id="viewLogsBtn" class="px-4 py-2 rounded-lg bg-slate-500/10 hover:bg-slate-500/20 text-slate-300 border border-slate-500/30 transition-colors text-sm flex items-center">
					<i class="fas fa-terminal mr-2"></i>
					{{ t('servers.view_logs')|default('View Logs') }}
				</button>
				<button onclick="window.serverView.handleDeleteServer({{ server.id }}, '{{ server.name|e('js') }}')" class="px-4 py-2 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 transition-colors text-sm">
					<i class="fas fa-trash-alt mr-2"></i>
					{{ t('servers.delete') }}
				</button>
			</div>
		</div>

		{% if import_message %}
			<div class="mb-6 {% if import_message.type == 'success' %}bg-primary/10 border-primary/30 text-cyan-300{% else %}bg-red-500/10 border-red-500/50 text-red-300{% endif %} border px-4 py-3 rounded-lg flex items-center mb-4">
				<i class="fas {% if import_message.type == 'success' %}fa-check-circle text-primary{% else %}fa-exclamation-circle text-red-400{% endif %} mr-3"></i>
				<span>{{ import_message.text }}</span>
			</div>
		{% endif %}

		<!-- Mini Dashboard -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
			<div class="panel p-5 border-l-4 border-primary">
				<div class="flex items-center justify-between mb-2">
					<span class="text-xs font-semibold text-muted uppercase tracking-wider">{{ t('dashboard.total_clients')|default('Total Clients') }}</span>
					<i class="fas fa-users text-muted text-xs"></i>
				</div>
				<div class="flex items-end gap-2">
					<span class="text-2xl font-bold" id="summary-total">{{ stats_summary.total }}</span>
				</div>
			</div>
			<div class="panel p-5 border-l-4 border-primary">
				<div class="flex items-center justify-between mb-2">
					<span class="text-xs font-semibold text-muted uppercase tracking-wider">{{ t('dashboard.online_now')|default('Online Now') }}</span>
					<i class="fas fa-signal text-cyan-900 text-xs"></i>
				</div>
				<div class="flex items-end gap-2">
					<span class="text-2xl font-bold text-primary" id="summary-online">{{ stats_summary.online }}</span>
					<span class="text-[10px] text-cyan-600 mb-1 font-bold animate-pulse">LIVE</span>
				</div>
			</div>
			<div class="panel p-5 border-l-4 border-blue-500">
				<div class="flex items-center justify-between mb-2">
					<span class="text-xs font-semibold text-muted uppercase tracking-wider">{{ t('clients.inbound')|default('Inbound') }}</span>
					<i class="fas fa-arrow-down text-blue-900 text-xs"></i>
				</div>
				<div class="flex items-end gap-2">
					<span class="text-2xl font-bold text-blue-400" id="summary-inbound">{{ (stats_summary.traffic.received / 1024 / 1024 / 1024)|number_format(2) }}</span>
					<span class="text-[10px] text-muted mb-1 font-bold">GB</span>
				</div>
			</div>
			<div class="panel p-5 border-l-4 border-purple-500">
				<div class="flex items-center justify-between mb-2">
					<span class="text-xs font-semibold text-muted uppercase tracking-wider">{{ t('clients.outbound')|default('Outbound') }}</span>
					<i class="fas fa-arrow-up text-purple-900 text-xs"></i>
				</div>
				<div class="flex items-end gap-2">
					<span class="text-2xl font-bold text-purple-400" id="summary-outbound">{{ (stats_summary.traffic.sent / 1024 / 1024 / 1024)|number_format(2) }}</span>
					<span class="text-[10px] text-muted mb-1 font-bold">GB</span>
				</div>
			</div>
		</div>

		<!-- Beszel Monitoring Card -->
		<div id="beszel-health-section" class="hidden mb-6">
			<div class="panel p-5 border-l-4 border-amber-500 overflow-hidden">
				<div class="flex items-center justify-between mb-4">
					<div class="flex items-center">
						<div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center mr-4 shadow-inner">
							<i class="fas fa-microchip text-lg"></i>
						</div>
						<div>
							<h3 class="text-sm font-bold tracking-wide uppercase">{{ t('monitoring.beszel_health') }}</h3>
							<p class="text-[10px] text-muted font-medium" id="beszel-uptime">{{ t('common.loading') }}</p>
						</div>
					</div>
					<div class="flex items-center gap-6">
						{% if beszel_config.url %}
							<a href="{{ beszel_config.url }}" target="_blank" class="w-8 h-8 rounded-full bg-surface-hover flex items-center justify-center text-amber-500 hover:bg-amber-500 hover:text-white transition-all shadow-sm" title="{{ t('monitoring.open_hub') }}">
								<i class="fas fa-external-link-alt text-xs"></i>
							</a>
						{% endif %}
					</div>
				</div>

				<div
					class="grid grid-cols-1 md:grid-cols-4 gap-6">
					<!-- CPU -->
					<div class="space-y-2">
						<div class="flex justify-between items-center text-[10px] font-bold uppercase tracking-wider">
							<span class="text-muted">{{ t('monitoring.cpu_usage') }}</span>
							<span id="beszel-cpu-val">0%</span>
						</div>
						<div class="h-2 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
							<div id="beszel-cpu-bar" class="h-full bg-amber-500 transition-all duration-500" style="width: 0%"></div>
						</div>
						<p id="beszel-cpu-info" class="text-[9px] text-muted italic">{{ t('common.loading') }}</p>
					</div>

					<!-- RAM -->
					<div class="space-y-2">
						<div class="flex justify-between items-center text-[10px] font-bold uppercase tracking-wider">
							<span class="text-muted">{{ t('monitoring.memory_usage') }}</span>
							<span id="beszel-ram-val">0%</span>
						</div>
						<div class="h-2 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
							<div id="beszel-ram-bar" class="h-full bg-cyan-500 transition-all duration-500" style="width: 0%"></div>
						</div>
						<p id="beszel-ram-info" class="text-[9px] text-muted italic">{{ t('common.loading') }}</p>
					</div>

					<!-- Disk -->
					<div class="space-y-2">
						<div class="flex justify-between items-center text-[10px] font-bold uppercase tracking-wider">
							<span class="text-muted">{{ t('monitoring.disk_usage') }}</span>
							<span id="beszel-disk-val">0%</span>
						</div>
						<div class="h-2 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
							<div id="beszel-disk-bar" class="h-full bg-purple-500 transition-all duration-500" style="width: 0%"></div>
						</div>
						<p id="beszel-disk-info" class="text-[9px] text-muted italic">{{ t('common.loading') }}</p>
					</div>

					<!-- Bandwidth -->
					<div class="space-y-2 flex flex-col justify-center">
						<div class="flex justify-between items-center text-[10px] font-bold uppercase tracking-wider">
							<span class="text-muted">{{ t('monitoring.bandwidth') }}</span>
							<span id="beszel-bw-total" class="font-bold">0 {{ t('common.mbps') }}</span>
						</div>
						<div class="flex justify-between items-center bg-slate-50 dark:bg-surface-hover/30 rounded-lg px-3 py-2 border border-slate-100 dark:border-surface-border/30">
							<div class="flex flex-col">
								<span class="text-[9px] dark:text-slate-400 text-slate-500 uppercase font-bold tracking-wider">{{ t('monitoring.download') }}</span>
								<span id="beszel-bw-rx" class="text-xs dark:text-emerald-400 text-emerald-600 font-mono">0 {{ t('common.mbps') }}</span>
							</div>
							<div class="w-px h-6 bg-slate-200 dark:bg-surface-border/50"></div>
							<div class="flex flex-col text-right">
								<span class="text-[9px] dark:text-slate-400 text-slate-500 uppercase font-bold tracking-wider">{{ t('monitoring.upload') }}</span>
								<span id="beszel-bw-tx" class="text-xs dark:text-sky-400 text-sky-600 font-mono">0 {{ t('common.mbps') }}</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Deployment Progress UI (Visible only when deploying) -->
		{% if server.status == 'deploying' %}
			<div class="panel p-6 mb-6 border-l-4 border-sky-500 animate-pulse">
				<div class="flex items-center justify-between mb-4">
					<div class="flex items-center">
						<div class="w-10 h-10 rounded-lg bg-sky-500/10 text-sky-500 flex items-center justify-center mr-4">
							<i class="fas fa-rocket text-lg"></i>
						</div>
						<div>
							<h3 class="text-sm font-bold uppercase tracking-widest text-sky-400">{{ t('servers.deployment_in_progress')|default('Deployment In Progress') }}</h3>
							<p class="text-[10px] text-muted font-medium uppercase">{{ t('servers.deploying_to')|default('Provisioning node:') }} {{ server.host }}</p>
						</div>
					</div>
					<div class="text-right">
						<span class="text-xs font-mono text-sky-500 bg-sky-500/5 px-2 py-1 rounded border border-sky-500/20" id="deploy-percentage">65%</span>
					</div>
				</div>
				
				<div class="relative pt-1">
					<div class="flex mb-2 items-center justify-between">
						<div class="flex gap-4">
							<div class="flex items-center gap-1.5 opacity-100">
								<div class="w-2 h-2 rounded-full bg-sky-500 shadow-[0_0_8px_rgba(14,165,233,0.5)]"></div>
								<span class="text-[10px] font-bold uppercase text-sky-400">Initialize</span>
							</div>
							<div class="flex items-center gap-1.5 opacity-100">
								<div class="w-2 h-2 rounded-full bg-sky-500 shadow-[0_0_8px_rgba(14,165,233,0.5)]"></div>
								<span class="text-[10px] font-bold uppercase text-sky-400">Environment</span>
							</div>
							<div class="flex items-center gap-1.5 opacity-50">
								<div class="w-2 h-2 rounded-full bg-slate-500"></div>
								<span class="text-[10px] font-bold uppercase text-muted">Orchestration</span>
							</div>
							<div class="flex items-center gap-1.5 opacity-30">
								<div class="w-2 h-2 rounded-full bg-slate-700"></div>
								<span class="text-[10px] font-bold uppercase text-muted">Finalize</span>
							</div>
						</div>
					</div>
					<div class="overflow-hidden h-1.5 mb-4 text-xs flex rounded bg-surface-hover border border-white/5">
						<div style="width:65%" class="shadow-none flex flex-col text-center whitespace-nowrap text-white justify-center bg-sky-500"></div>
					</div>
				</div>
				<p class="text-[10px] text-muted font-mono leading-relaxed mt-2">
					<i class="fas fa-chevron-right mr-2 text-sky-500/50"></i>{{ t('servers.deploy_step_hint')|default('Tailoring kernel parameters for high-performance VPN throughput...') }}
				</p>
			</div>
		{% endif %}

		<div
			class="grid grid-cols-1 lg:grid-cols-4 gap-6 mb-8"
            id="server-view-container"
            data-config="{{ {
                serverId: server.id,
                serverName: server.name,
                serverHost: server.host,
                serverStatus: server.status,
                beszelUrl: beszel_config.url,
                csrfToken: csrf_token,
                currentJobId: server.current_job_id,
                centrifugoUrl: centrifugo_url,
                connectionToken: connection_token,
                subscriptionToken: subscription_token,
                labels: {
                    clientServer: t('clients.list', [], 'Client'),
                    statusIp: t('common.status', [], 'Status') ~ '/ IP',
                    trafficSeen: t('common.traffic', [], 'Traffic') ~ '/ ' ~ t('clients.last_seen', [], 'Last seen'),
                    actions: t('servers.actions', [], 'Actions'),
                    online: t('status.online'),
                    offline: t('status.offline'),
                    never: t('status.never')|default('Never Connected'),
                    searching: t('common.searching'),
                    noMatches: t('common.no_matches'),
                    sync: t('common.sync'),
                    revoke: t('common.revoke'),
                    restore: t('common.restore'),
                    delete: t('common.delete'),
                    confirmDelete: t('common.confirm_delete'),
                    revoked: t('status.revoked', [], 'Revoked'),
                    provisioning: t('status.provisioning', [], 'Provisioning'),
                    deleting: t('status.deleting', [], 'Deleting'),
                    error: t('status.error', [], 'Error'),
                    verifying: t('status.verifying', [], 'Verifying'),
                    edit: t('common.edit'),
                    selected: t('common.selected_count', [], '%s items selected'),
                    traffic: t('common.traffic'),
                    lastSeenLabel: t('common.last_seen'),
                    noLogs: t('servers.no_logs'),
                    logEntries: t('servers.log_entries'),
                    logsFailed: t('servers.logs_failed')
                }
            }|json_encode|e('html_attr') }}">

			<!-- Quick Info & Add Client -->
			<div class="lg:col-span-1 space-y-6">
				<div class="panel p-5">
					<h3 class="text-sm font-semibold mb-4 uppercase tracking-wider opacity-70">{{ t('servers.server_info') }}</h3>
					<div class="space-y-4">
						<div>
							<span class="text-[10px] text-muted block uppercase font-bold">{{ t('servers.vpn_port') }}</span>
							<span class="text-sm font-mono">{{ server.vpn_port }}</span>
						</div>
						<div>
							<span class="text-[10px] text-muted block uppercase font-bold">{{ t('servers.subnet') }}</span>
							<span class="text-sm font-mono">{{ server.vpn_subnet }}</span>
						</div>
						<div>
							<span class="text-[10px] text-muted block uppercase font-bold">{{ t('servers.protocol') }}</span>
							<span class="text-sm font-mono uppercase">{{ server.awg_params.mimicry_type|default('quic') }}</span>
						</div>
					</div>
				</div>

				<div class="panel p-5">
					<h3 class="text-sm font-semibold mb-4 uppercase tracking-wider opacity-70">{{ t('clients.add') }}</h3>
					<form onsubmit="handleAjaxForm(event, '/servers/{{ server.id }}/clients/create')" id="createClientForm">
						<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
						<div class="mb-3">
							<input name="name" required class="input-field" placeholder="{{ t('clients.client_name') }}" id="clientName">
						</div>
						<button type="submit" class="btn-primary w-full py-2.5 text-sm" id="createClientBtn">
							<i class="fas fa-plus mr-2"></i>
							<span id="createClientText">{{ t('clients.create_client') }}</span>
						</button>
					</form>
					<p class="text-[10px] text-muted mt-3 leading-relaxed">{{ t('clients.name_hint') }}</p>
				</div>
			</div>

			<!-- Global Search Localized for this Server -->
			<div class="lg:col-span-3">
				<div class="panel overflow-hidden flex flex-col min-h-[500px]">
					<div class="px-5 py-4 border-b border-default bg-panel/30 flex items-center justify-between gap-4">
						<div class="flex items-center gap-4">
                            <h2 class="text-sm font-semibold uppercase tracking-widest opacity-70">{{ t('dashboard.fleet_search', [], 'Server Clients') }}</h2>
                            <!-- Batch Actions Bar (Responsive) -->
                            <div id="batchActionBar" class="hidden flex items-center gap-2 px-3 py-1 bg-primary/10 border border-primary/20 rounded-full animate-fade-in 
                                 fixed bottom-6 left-4 right-4 md:relative md:bottom-auto md:left-auto md:right-auto md:bg-primary/10 
                                 bg-surface-panel shadow-2xl md:shadow-none p-3 md:p-1 border-primary/40 md:border-primary/20 z-[100]">
                                
                                <div class="flex flex-col md:flex-row items-center w-full gap-3 md:gap-2">
                                    <div class="flex items-center w-full md:w-auto border-b md:border-b-0 border-default/50 pb-2 md:pb-0">
                                        <span class="text-[11px] md:text-[10px] font-bold text-primary uppercase tracking-widest mr-auto md:mr-2" id="selectedCountText">0 SELECTED</span>
                                        <button onclick="document.querySelectorAll('.client-checkbox').forEach(cb => cb.checked = false); window.serverView.updateBatchBar();" class="md:hidden text-[10px] text-muted hover:text-primary uppercase font-bold px-2 py-1">
                                            <i class="fas fa-times mr-1"></i>{{ t('common.clear')|default('Clear') }}
                                        </button>
                                    </div>
                                    
                                    <div class="flex items-center justify-around w-full md:w-auto gap-2">
                                        <button onclick="window.serverView.handleBatchAction('revoke')" class="flex-1 md:flex-none text-[11px] md:text-[10px] font-bold text-orange-400 hover:text-orange-300 uppercase tracking-tight px-3 py-2.5 md:px-2 md:py-1 transition-colors bg-orange-500/10 md:bg-transparent rounded-lg border border-orange-500/20 md:border-0 text-center">
                                            <i class="fas fa-user-slash mr-1.5 md:hidden"></i>{{ t('common.revoke')|default('Revoke') }}
                                        </button>
                                        <button onclick="window.serverView.handleBatchAction('restore')" class="flex-1 md:flex-none text-[11px] md:text-[10px] font-bold dark:text-green-400 text-green-600 hover:dark:text-green-300 hover:text-green-700 uppercase tracking-tight px-3 py-2.5 md:px-2 md:py-1 transition-colors bg-green-500/10 md:bg-transparent rounded-lg border border-green-500/20 md:border-0 text-center">
                                            <i class="fas fa-user-check mr-1.5 md:hidden"></i>{{ t('common.restore')|default('Restore') }}
                                        </button>
                                        <button onclick="window.serverView.handleBatchAction('delete')" class="flex-1 md:flex-none text-[11px] md:text-[10px] font-bold dark:text-red-400 text-red-600 hover:dark:text-red-300 hover:text-red-700 uppercase tracking-tight px-3 py-2.5 md:px-2 md:py-1 transition-colors bg-red-500/10 md:bg-transparent rounded-lg border border-red-500/20 md:border-0 text-center">
                                            <i class="fas fa-trash-alt mr-1.5 md:hidden"></i>{{ t('common.delete')|default('Delete') }}
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>						<div class="flex flex-wrap items-center gap-2">
							<div class="relative w-48 lg:w-64">
								<input type="text" id="clientSearch" class="input-field input-with-icon !py-2 text-sm" placeholder="{{ t('dashboard.search_placeholder', [], 'Search clients...') }}">
								<i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-muted text-xs"></i>
							</div>
							<select id="statusFilter" class="input-field !w-auto !py-2 px-3 text-[11px] font-bold">
								<option value="all">{{ t('common.status_all', [], 'All Status') }}</option>
								<option value="online">{{ t('common.status_online', [], 'Online') }}</option>
								<option value="offline">{{ t('common.status_offline', [], 'Offline') }}</option>
								<option value="revoked">{{ t('status.revoked', [], 'Revoked') }}</option>
							</select>
							<select id="trafficFilter" class="input-field !w-auto !py-2 px-3 text-[11px] font-bold">
								<option value="all">{{ t('common.traffic_all', [], 'All Traffic') }}</option>
								<option value="medium">{{ t('common.traffic_medium', [], '> 100MB') }}</option>
								<option value="high">{{ t('common.traffic_high', [], '> 1GB') }}</option>
							</select>
							<select id="sortFilter" class="input-field !w-auto !py-2 px-3 text-[11px] font-bold">
								<option value="recent">{{ t('common.sort_newest', [], 'Newest') }}</option>
								<option value="handshake">{{ t('common.sort_handshake', [], 'Last Activity') }}</option>
								<option value="traffic">{{ t('common.sort_traffic', [], 'Most Traffic') }}</option>
								<option value="oldest">{{ t('common.sort_oldest', [], 'Oldest') }}</option>
							</select>
						</div>

					</div>

					<div
						id="searchResults" class="flex-grow"><!-- Search results injected here -->
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- ===== Terminal Log Modal ===== -->
	<div id="logsModal" class="fixed inset-0 z-[200] flex items-center justify-center p-4 hidden" role="dialog" aria-modal="true" aria-labelledby="logsModalTitle">
		<!-- Backdrop -->
		<div class="absolute inset-0 bg-black/80" onclick="window.serverView.closeLogsModal()"></div>
		<!-- Panel -->
		<div class="relative w-full max-w-4xl h-[75vh] max-h-[600px] flex flex-col rounded-xl overflow-hidden shadow-2xl border border-slate-700/60">
			<!-- Terminal chrome -->
			<div class="flex items-center gap-2 px-4 py-3 bg-[#1e1e2e] border-b border-slate-700/50 flex-shrink-0">
				<div class="flex gap-1.5">
					<button onclick="window.serverView.closeLogsModal()" class="w-3 h-3 rounded-full bg-red-500 hover:bg-red-400 transition-colors" title="{{ t('common.close') }}"></button>
					<span class="w-3 h-3 rounded-full bg-yellow-500"></span>
					<span class="w-3 h-3 rounded-full bg-green-500"></span>
				</div>
				<span class="ml-3 text-xs font-mono text-slate-400 flex-1" id="logsModalTitle">nk-panel — {{ t('servers.deployment_logs') }}</span>
				<div class="flex items-center gap-2">
					<label class="flex items-center gap-1.5 text-[10px] text-slate-400 cursor-pointer select-none">
						<input type="checkbox" id="logsAutoScroll" checked class="rounded border-slate-600 bg-slate-800 text-cyan-500 focus:ring-cyan-500/20">
						{{ t('common.auto_scroll') }}
					</label>
					<button onclick="window.serverView.refreshLogs()" class="text-[10px] text-slate-400 hover:text-cyan-400 transition-colors px-2 py-1 rounded border border-slate-700 hover:border-cyan-500/40" title="{{ t('common.refresh') }}">
						<i class="fas fa-redo-alt mr-1"></i>{{ t('common.refresh') }}
					</button>
				</div>
			</div>
			<!-- Log body -->
			<div id="logsBody" class="flex-1 overflow-y-auto bg-[#13131f] font-mono text-xs leading-relaxed px-4 py-3">
				<p class="text-slate-500 italic">{{ t('common.loading_logs') }}</p>
			</div>
			<!-- Footer -->
			<div class="flex items-center justify-between px-4 py-2 bg-[#1e1e2e] border-t border-slate-700/50 flex-shrink-0">
				<span class="text-xs font-mono text-slate-500" id="logsCount">0 {{ t('servers.log_entries') }}</span>
				<button onclick="window.serverView.closeLogsModal()" class="text-[10px] px-3 py-1.5 rounded border border-slate-700 text-slate-400 hover:text-white hover:border-slate-500 transition-all">{{ t('common.close') }}</button>
			</div>
		</div>
	</div>
	<script src="https://cdn.jsdelivr.net/npm/centrifuge@3.1.0/dist/centrifuge.min.js"></script>
	<script src="/js/servers/view.js?v=3"></script>

	<script>
		document.addEventListener('DOMContentLoaded', () => {
            const container = document.getElementById('server-view-container');
            if (container) {
                const config = JSON.parse(container.getAttribute('data-config'));
                window.serverView = new ServerView(config);
            }
        });
	</script>
{% endblock %}
