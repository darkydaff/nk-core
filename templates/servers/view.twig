{% extends "layout.twig" %}
{% block title %}
	{{ server.name }}
{% endblock %}

{% block breadcrumbs %}
    <li class="flex items-center">
        <a href="/servers" class="hover:text-primary">{{ t('menu.servers') }}</a>
    </li>
    <li class="flex items-center">
        <i class="fas fa-chevron-right mx-2 opacity-30"></i>
        <span>{{ server.name }}</span>
    </li>
{% endblock %}

{% block content %}
	<div class="w-full mx-auto max-w-7xl">
		<div class="mb-6 flex flex-col md:flex-row md:items-start justify-between gap-4">
			<div>
				<h1 class="text-3xl font-bold flex items-center tracking-tight">
					<div class="w-12 h-12 rounded-xl bg-surface-hover text-primary flex items-center justify-center mr-4 shadow-inner overflow-hidden">
						{% if server.country_code %}
							<span class="text-5xl">{{ getFlag(server.country_code)|raw }}</span>
						{% else %}
							<i class="fas fa-server"></i>
						{% endif %}
					</div>
					{{ server.name }}
				</h1>
				<div class="mt-2 ml-13 flex flex-wrap items-center gap-3">
					<code class="text-xs text-secondary bg-panel px-2 py-1 rounded">{{ server.host }}</code>
					{% if server.city or server.isp %}
						<div class="flex items-center gap-1.5 px-2 py-1 rounded bg-panel/40 border border-white/5">
							<i class="fas fa-map-marker-alt text-[10px] text-primary opacity-70"></i>
							<span class="text-[10px] font-bold text-muted uppercase tracking-tight">
								{% if server.city %}{{ server.city }}{% endif %}
								{% if server.city and server.isp %} • {% endif %}
								{% if server.isp %}{{ server.isp }}{% endif %}
							</span>
						</div>
					{% endif %}
					{% if server.status == 'active' %}
						<span class="badge-active text-xs px-2 py-1 rounded-md flex items-center">
							<span class="w-1.5 h-1.5 rounded-full bg-success mr-1.5 animate-pulse"></span>
							{{ t('status.active') }}
						</span>
					{% elseif server.status == 'deploying' %}
						<span class="badge-primary text-xs px-2 py-1 rounded-md flex items-center">
							<i class="fas fa-spinner fa-spin text-[8px] mr-1.5"></i>
							{{ t('status.deploying')|default('Deploying…') }}
						</span>
					{% else %}
						<div class="flex items-center gap-2">
							<span class="badge-error text-xs px-2 py-1 rounded-md flex items-center">
								<span class="w-1.5 h-1.5 rounded-full bg-error mr-1.5"></span>
								{{ t('status.' ~ server.status)|default(server.status) }}
							</span>
							{% if server.error_message %}
								<div class="group relative inline-block">
									<i class="fas fa-exclamation-triangle text-warning text-xs cursor-help animate-pulse"></i>
									<div class="absolute left-0 bottom-full mb-2 w-72 p-3 bg-surface-panel border border-error/30 rounded-lg text-[10px] text-error shadow-2xl opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-[100] font-mono leading-relaxed">
										<div class="text-error font-bold mb-1 uppercase tracking-tighter border-b border-error/20 pb-1">Last Deployment Error:</div>
										{{ server.error_message }}
									</div>
								</div>
							{% endif %}
							<button onclick="window.serverView.syncStats({{ server.id }})" class="w-6 h-6 rounded-full bg-surface-hover flex items-center justify-center text-muted hover:text-primary transition-all border border-surface-border/50" aria-label="{{ t('common.recheck')|default('Recheck Connectivity') }}" title="{{ t('common.recheck')|default('Recheck Connectivity') }}">								<i class="fas fa-redo-alt text-[10px]"></i>
							</button>
						</div>
					{% endif %}
					{% if server.last_check_at %}
						<span class="text-[10px] text-muted flex items-center bg-panel/50 px-2 py-1 rounded border border-surface-border/30" title="{{ t('common.last_sync') }}">
							<i class="fas fa-clock mr-1.5 opacity-50"></i>
							{{ t('common.last_sync') }}: {{ server.last_check_at|date('H:i:s') }}
						</span>
					{% endif %}
				</div>
			</div>
			<div class="flex gap-2 items-center flex-wrap">
				<button onclick="window.serverView.syncStats({{ server.id }})" id="syncBtn" class="btn-secondary px-4 py-2 text-sm flex items-center" aria-label="{{ t('servers.sync_stats') }}">
					<i class="fas fa-sync-alt mr-2" id="syncIcon"></i>
					{{ t('servers.sync_stats') }}
				</button>
				<button onclick="window.serverView.openLogsModal({{ server.id }})" id="viewLogsBtn" class="px-4 py-2 rounded-lg bg-surface-hover hover:bg-surface-border text-content-secondary border border-surface-border/50 transition-colors text-sm flex items-center" aria-label="{{ t('servers.view_logs')|default('View Logs') }}">
					<i class="fas fa-terminal mr-2"></i>
					{{ t('servers.view_logs')|default('View Logs') }}
				</button>
				<button onclick="window.serverView.handleDeleteServer({{ server.id }}, '{{ server.name|e('js') }}')" class="px-4 py-2 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 transition-colors text-sm" aria-label="{{ t('servers.delete') }}">
					<i class="fas fa-trash-alt mr-2"></i>
					{{ t('servers.delete') }}
				</button>
			</div>
		</div>

		{% if import_message %}
			<div class="mb-6 {% if import_message.type == 'success' %}bg-primary/10 border-primary/30 text-cyan-300{% else %}bg-red-500/10 border-red-500/50 text-red-300{% endif %} border px-4 py-3 rounded-lg flex items-center mb-4" role="alert">
				<i class="fas {% if import_message.type == 'success' %}fa-check-circle text-primary{% else %}fa-exclamation-circle text-red-400{% endif %} mr-3"></i>
				<span>{{ import_message.text }}</span>
			</div>
		{% endif %}

		<!-- Mini Dashboard -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
			<div class="panel p-5 border-l-4 border-primary">
				<div class="flex items-center justify-between mb-2">
					<span class="text-xs font-semibold text-muted uppercase tracking-wider">{{ t('dashboard.total_clients')|default('Total Clients') }}</span>
					<i class="fas fa-users text-muted text-xs"></i>
				</div>
				<div class="flex items-end gap-2">
					<span class="text-2xl font-bold" id="summary-total">{{ stats_summary.total }}</span>
				</div>
			</div>
			<div class="panel p-5 border-l-4 border-primary">
				<div class="flex items-center justify-between mb-2">
					<span class="text-xs font-semibold text-muted uppercase tracking-wider">{{ t('dashboard.online_now')|default('Online Now') }}</span>
					<i class="fas fa-signal text-cyan-900 text-xs"></i>
				</div>
				<div class="flex items-end gap-2">
					<span class="text-2xl font-bold text-primary" id="summary-online">{{ stats_summary.online }}</span>
					<span class="text-[10px] text-cyan-600 mb-1 font-bold animate-pulse">LIVE</span>
				</div>
			</div>
			<div class="panel p-5 border-l-4 border-blue-500">
				<div class="flex items-center justify-between mb-2">
					<span class="text-xs font-semibold text-muted uppercase tracking-wider">{{ t('clients.inbound')|default('Inbound') }}</span>
					<i class="fas fa-arrow-down text-blue-900 text-xs"></i>
				</div>
				<div class="flex items-end gap-2">
					<span class="text-2xl font-bold text-blue-400" id="summary-inbound">{{ (stats_summary.traffic.received / 1024 / 1024 / 1024)|number_format(2) }}</span>
					<span class="text-[10px] text-muted mb-1 font-bold">&nbsp;GB</span>
				</div>
			</div>
			<div class="panel p-5 border-l-4 border-purple-500">
				<div class="flex items-center justify-between mb-2">
					<span class="text-xs font-semibold text-muted uppercase tracking-wider">{{ t('clients.outbound')|default('Outbound') }}</span>
					<i class="fas fa-arrow-up text-purple-900 text-xs"></i>
				</div>
				<div class="flex items-end gap-2">
					<span class="text-2xl font-bold text-purple-400" id="summary-outbound">{{ (stats_summary.traffic.sent / 1024 / 1024 / 1024)|number_format(2) }}</span>
					<span class="text-[10px] text-muted mb-1 font-bold">&nbsp;GB</span>
				</div>
			</div>
		</div>

		<!-- Beszel Monitoring Card -->
		<div id="beszel-health-section" class="hidden mb-6">
			<div class="panel p-5 border-l-4 border-amber-500 overflow-hidden">
				<div class="flex items-center justify-between mb-4">
					<div class="flex items-center">
						<div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center mr-4 shadow-inner">
							<i class="fas fa-microchip text-lg"></i>
						</div>
						<div>
							<h3 class="text-sm font-bold tracking-wide uppercase">{{ t('monitoring.beszel_health') }}</h3>
							<p class="text-[10px] text-muted font-medium" id="beszel-uptime">{{ t('common.loading') }}</p>
						</div>
					</div>
					<div class="flex items-center gap-6">
						{% if beszel_config.url %}
							<a href="{{ beszel_config.url }}" target="_blank" class="w-8 h-8 rounded-full bg-surface-hover flex items-center justify-center text-amber-500 hover:bg-amber-500 hover:text-white transition-all shadow-sm" title="{{ t('monitoring.open_hub') }}">
								<i class="fas fa-external-link-alt text-xs"></i>
							</a>
						{% endif %}
					</div>
				</div>

				<div
					class="grid grid-cols-1 md:grid-cols-4 gap-6">
					<!-- CPU -->
					<div class="space-y-2">
						<div class="flex justify-between items-center text-[10px] font-bold uppercase tracking-wider">
							<span class="text-content-muted">{{ t('monitoring.cpu_usage') }}</span>
							<span id="beszel-cpu-val" class="text-content-primary">0%</span>
						</div>
						<div class="h-2 w-full bg-surface-hover rounded-full overflow-hidden border border-surface-border/30">
							<div id="beszel-cpu-bar" class="h-full bg-warning transition-all duration-500" style="width: 0%"></div>
						</div>
						<p id="beszel-cpu-info" class="text-[9px] text-content-muted italic">{{ t('common.loading') }}</p>
					</div>

					<!-- RAM -->
					<div class="space-y-2">
						<div class="flex justify-between items-center text-[10px] font-bold uppercase tracking-wider">
							<span class="text-content-muted">{{ t('monitoring.memory_usage') }}</span>
							<span id="beszel-ram-val" class="text-content-primary">0%</span>
						</div>
						<div class="h-2 w-full bg-surface-hover rounded-full overflow-hidden border border-surface-border/30">
							<div id="beszel-ram-bar" class="h-full bg-primary transition-all duration-500" style="width: 0%"></div>
						</div>
						<p id="beszel-ram-info" class="text-[9px] text-content-muted italic">{{ t('common.loading') }}</p>
					</div>

					<!-- Disk -->
					<div class="space-y-2">
						<div class="flex justify-between items-center text-[10px] font-bold uppercase tracking-wider">
							<span class="text-content-muted">{{ t('monitoring.disk_usage') }}</span>
							<span id="beszel-disk-val" class="text-content-primary">0%</span>
						</div>
						<div class="h-2 w-full bg-surface-hover rounded-full overflow-hidden border border-surface-border/30">
							<div id="beszel-disk-bar" class="h-full bg-purple-500 transition-all duration-500" style="width: 0%"></div>
						</div>
						<p id="beszel-disk-info" class="text-[9px] text-content-muted italic">{{ t('common.loading') }}</p>
					</div>

					<!-- Bandwidth -->
					<div class="space-y-2 flex flex-col justify-center">
						<div class="flex justify-between items-center text-[10px] font-bold uppercase tracking-wider">
							<span class="text-content-muted">{{ t('monitoring.bandwidth') }}</span>
							<span id="beszel-bw-total" class="font-bold text-content-primary">0 {{ t('common.mbps') }}</span>
						</div>
						<div class="flex justify-between items-center bg-surface-base rounded-lg px-3 py-2 border border-surface-border">
							<div class="flex flex-col">
								<span class="text-[9px] text-content-muted uppercase font-bold tracking-wider">{{ t('monitoring.download') }}</span>
								<span id="beszel-bw-rx" class="text-xs text-success font-mono">0 {{ t('common.mbps') }}</span>
							</div>
							<div class="w-px h-6 bg-surface-border"></div>
							<div class="flex flex-col text-right">
								<span class="text-[9px] text-content-muted uppercase font-bold tracking-wider">{{ t('monitoring.upload') }}</span>
								<span id="beszel-bw-tx" class="text-xs text-primary font-mono">0 {{ t('common.mbps') }}</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Deployment Progress UI (Visible only when deploying) -->
		{% if server.status == 'deploying' %}
			<div class="panel p-6 mb-6 border-l-4 border-sky-500 animate-pulse">
				<div class="flex items-center justify-between mb-4">
					<div class="flex items-center">
						<div class="w-10 h-10 rounded-lg bg-sky-500/10 text-sky-500 flex items-center justify-center mr-4">
							<i class="fas fa-rocket text-lg"></i>
						</div>
						<div>
							<h3 class="text-sm font-bold uppercase tracking-widest text-sky-400">{{ t('servers.deployment_in_progress')|default('Deployment In Progress') }}</h3>
							<p class="text-[10px] text-muted font-medium uppercase">{{ t('servers.deploying_to')|default('Provisioning node:') }} {{ server.host }}</p>
						</div>
					</div>
					<div class="text-right">
						<span class="text-xs font-mono text-sky-500 bg-sky-500/5 px-2 py-1 rounded border border-sky-500/20" id="deploy-percentage">65%</span>
					</div>
				</div>
				
				<div class="relative pt-1">
					<div class="flex mb-2 items-center justify-between">
						<div class="flex gap-4">
							<div class="flex items-center gap-1.5 opacity-100">
								<div class="w-2 h-2 rounded-full bg-sky-500 shadow-[0_0_8px_rgba(14,165,233,0.5)]"></div>
								<span class="text-[10px] font-bold uppercase text-sky-400">Initialize</span>
							</div>
							<div class="flex items-center gap-1.5 opacity-100">
								<div class="w-2 h-2 rounded-full bg-sky-500 shadow-[0_0_8px_rgba(14,165,233,0.5)]"></div>
								<span class="text-[10px] font-bold uppercase text-sky-400">Environment</span>
							</div>
							<div class="flex items-center gap-1.5 opacity-50">
								<div class="w-2 h-2 rounded-full bg-content-muted"></div>
								<span class="text-[10px] font-bold uppercase text-content-muted">Orchestration</span>
							</div>
							<div class="flex items-center gap-1.5 opacity-30">
								<div class="w-2 h-2 rounded-full bg-surface-border"></div>
								<span class="text-[10px] font-bold uppercase text-content-muted">Finalize</span>
							</div>
						</div>
					</div>
					<div class="overflow-hidden h-1.5 mb-4 text-xs flex rounded bg-surface-hover border border-white/5">
						<div style="width:65%" class="shadow-none flex flex-col text-center whitespace-nowrap text-white justify-center bg-sky-500"></div>
					</div>
				</div>
				<p class="text-[10px] text-muted font-mono leading-relaxed mt-2">
					<i class="fas fa-chevron-right mr-2 text-sky-500/50"></i>{{ t('servers.deploy_step_hint')|default('Tailoring kernel parameters for high-performance VPN throughput…') }}
				</p>
			</div>
		{% endif %}

		<div
			class="grid grid-cols-1 lg:grid-cols-4 gap-6 mb-8"
            id="server-view-container"
            data-config="{{ {
                serverId: server.id,
                serverName: server.name,
                serverHost: server.host,
                serverStatus: server.status,
                beszelUrl: beszel_config.url,
                csrfToken: csrf_token,
                currentJobId: server.current_job_id,
                centrifugoUrl: centrifugo_url,
                connectionToken: connection_token,
                subscriptionToken: subscription_token,
                labels: {
                    clientServer: t('clients.list', [], 'Client'),
                    statusIp: t('common.status', [], 'Status') ~ '/ IP',
                    trafficSeen: t('common.traffic', [], 'Traffic') ~ '/ ' ~ t('clients.last_seen', [], 'Last seen'),
                    actions: t('servers.actions', [], 'Actions'),
                    online: t('status.online'),
                    offline: t('status.offline'),
                    never: t('status.never')|default('Never Connected'),
                    searching: t('common.searching'),
                    noMatches: t('common.no_matches'),
                    sync: t('common.sync'),
                    revoke: t('common.revoke'),
                    restore: t('common.restore'),
                    delete: t('common.delete'),
                    confirmDelete: t('common.confirm_delete'),
                    revoked: t('status.revoked', [], 'Revoked'),
                    provisioning: t('status.provisioning', [], 'Provisioning'),
                    deleting: t('status.deleting', [], 'Deleting'),
                    error: t('status.error', [], 'Error'),
                    verifying: t('status.verifying', [], 'Verifying'),
                    edit: t('common.edit'),
                    selected: t('common.selected_count', [], '%s items selected'),
                    traffic: t('common.traffic'),
                    lastSeenLabel: t('common.last_seen'),
                    noLogs: t('servers.no_logs'),
                    logEntries: t('servers.log_entries'),
                    logsFailed: t('servers.logs_failed')
                }
            }|json_encode|e('html_attr') }}">

			<!-- Quick Info & Add Client -->
			<div class="lg:col-span-1 space-y-6">
				<div class="panel p-5">
					<h3 class="text-sm font-semibold mb-4 uppercase tracking-wider opacity-70">{{ t('servers.server_info') }}</h3>
					<div class="space-y-4">
						<div>
							<span class="text-[10px] text-muted block uppercase font-bold">{{ t('servers.vpn_port') }}</span>
							<span class="text-sm font-mono">{{ server.vpn_port }}</span>
						</div>
						<div>
							<span class="text-[10px] text-muted block uppercase font-bold">{{ t('servers.subnet') }}</span>
							<span class="text-sm font-mono">{{ server.vpn_subnet }}</span>
						</div>
						<div>
							<span class="text-[10px] text-muted block uppercase font-bold">{{ t('servers.protocol') }}</span>
							<span class="text-sm font-mono uppercase">{{ server.awg_params.mimicry_type|default('quic') }}</span>
						</div>
						<div class="border-t border-default/30 pt-3 mt-3">
							<span class="text-[10px] text-muted block uppercase font-bold mb-1">{{ t('servers.telemetry_mode')|default('Telemetry Mode') }}</span>
							<div class="flex items-center justify-between">
								<span id="telemetryModeBadge" class="text-xs font-mono font-bold uppercase {{ server.telemetry_mode == 'push' ? 'text-primary' : 'text-slate-400' }}">
									{{ server.telemetry_mode == 'push' ? 'Push (Active)' : 'SSH (Legacy)' }}
								</span>
								<button onclick="window.serverView.toggleTelemetry({{ server.id }})" id="telemetryToggleBtn" class="px-2.5 py-1 rounded bg-surface-hover hover:bg-primary/20 hover:text-primary transition-all text-[10px] font-bold border border-default/60 flex items-center gap-1" aria-label="{{ server.telemetry_mode == 'push' ? 'Reinstall Agent' : 'Enable Push' }}">
									<i class="fas fa-magic" id="telemetryToggleIcon"></i>
									<span id="telemetryToggleText">{{ server.telemetry_mode == 'push' ? 'Reinstall Agent' : 'Enable Push' }}</span>
								</button>
							</div>
						</div>
					</div>
				</div>

				<!-- Cloudflare WARP Panel -->
				<div class="panel p-5" id="warp-panel">
					<div class="flex items-center justify-between mb-4">
						<h3 class="text-sm font-semibold uppercase tracking-wider opacity-70">Cloudflare WARP</h3>
						
						{% if server.warp_status == 'connected' %}
							<span class="badge-active text-[10px] px-2 py-0.5 rounded font-bold flex items-center bg-emerald-500/10 border-emerald-500/20 text-emerald-400 border">
								<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span>
								Connected
							</span>
						{% elseif server.warp_status == 'installing' or server.warp_status == 'initializing' %}
							<span class="badge-primary text-[10px] px-2 py-0.5 rounded font-bold flex items-center bg-sky-500/10 border-sky-500/20 text-sky-400 border">
								<i class="fas fa-spinner fa-spin text-[8px] mr-1.5"></i>
								Setup...
							</span>
						{% elseif server.warp_status == 'degraded' %}
							<span class="badge-warning text-[10px] px-2 py-0.5 rounded font-bold flex items-center bg-amber-500/10 border-amber-500/20 text-amber-400 border">
								<span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-1.5"></span>
								Degraded
							</span>
						{% elseif server.warp_status == 'error' %}
							<span class="badge-error text-[10px] px-2 py-0.5 rounded font-bold flex items-center bg-red-500/10 border-red-500/20 text-red-400 border">
								<span class="w-1.5 h-1.5 rounded-full bg-red-500 mr-1.5"></span>
								Error
							</span>
						{% else %}
							<span class="text-[10px] px-2 py-0.5 rounded font-bold flex items-center bg-slate-500/10 border-slate-500/20 text-slate-400 border">
								Not Installed
							</span>
						{% endif %}
					</div>

					{% if server.warp_status == 'not_installed' or server.warp_status is empty %}
						<p class="text-xs text-muted leading-relaxed mb-4">
							Route client egress traffic through Cloudflare's network. Prevents destination blocking and hides host server IP.
						</p>
						<button onclick="window.serverView.installWarp({{ server.id }})" id="installWarpBtn" class="btn-primary w-full py-2 text-xs font-semibold flex items-center justify-center gap-1.5">
							<i class="fas fa-download"></i>
							Install Cloudflare WARP
						</button>
					{% elseif server.warp_status == 'installing' or server.warp_status == 'initializing' %}
						<div class="py-4 text-center">
							<div class="animate-spin text-primary text-xl mb-2">
								<i class="fas fa-circle-notch"></i>
							</div>
							<p class="text-xs text-muted">Orchestrating Cloudflare WARP backend setup. This might take up to a minute...</p>
						</div>
					{% else %}
						<div class="space-y-3 font-mono text-xs mb-4">
							<div class="flex justify-between items-center pb-2 border-b border-default/10">
								<span class="text-[10px] text-muted uppercase font-bold tracking-tight font-sans">Cloudflare IP</span>
								<span class="font-bold text-content-primary">{{ server.warp_cloudflare_ip|default('—') }}</span>
							</div>
							<div class="flex justify-between items-center pb-2 border-b border-default/10">
								<span class="text-[10px] text-muted uppercase font-bold tracking-tight font-sans">Active Clients</span>
								<span class="font-bold text-content-primary">{{ server.warp_client_count|default(0) }} clients</span>
							</div>
							<div class="flex flex-col gap-0.5 pb-2 border-b border-default/10">
								<span class="text-[10px] text-muted uppercase font-bold tracking-tight font-sans">Health Status</span>
								<span class="font-sans font-medium text-xs {% if server.warp_status == 'connected' %}text-emerald-400{% elseif server.warp_status == 'degraded' %}text-amber-400{% else %}text-red-400{% endif %}">
									{{ server.warp_last_check_status|default('Unknown check status') }}
								</span>
								{% if server.warp_last_check_at %}
									<span class="text-[9px] text-muted font-sans">Checked: {{ server.warp_last_check_at|date('H:i:s') }}</span>
								{% endif %}
							</div>
							{% if server.warp_last_repair_at %}
								<div class="flex flex-col gap-0.5">
									<span class="text-[10px] text-muted uppercase font-bold tracking-tight font-sans">Last Auto Repair</span>
									<span class="text-[10px] text-content-secondary leading-tight font-sans">{{ server.warp_last_repair_result|default('System restored') }}</span>
									<span class="text-[9px] text-muted font-sans">{{ server.warp_last_repair_at|date('Y-m-d H:i') }}</span>
								</div>
							{% endif %}
							{% if server.warp_status == 'error' and server.warp_last_error %}
								<div class="bg-red-500/10 border border-red-500/20 p-2.5 rounded text-[10px] text-red-400 font-sans leading-relaxed max-h-24 overflow-y-auto">
									<strong class="block mb-0.5">Last Error:</strong>
									{{ server.warp_last_error }}
								</div>
							{% endif %}
						</div>

						<div class="space-y-2 border-t border-default/20 pt-3">
							<button onclick="window.serverView.runWarpHealthCheck({{ server.id }})" id="warpHealthBtn" class="w-full py-2 rounded-lg bg-surface-hover hover:bg-surface-border text-content-secondary border border-surface-border/50 text-xs font-semibold transition-all flex items-center justify-center gap-1.5">
								<i class="fas fa-sync-alt" id="warpHealthIcon"></i>
								Run Health Check
							</button>
							<div class="flex gap-2">
								<button onclick="window.serverView.repairWarp({{ server.id }})" id="warpRepairBtn" class="flex-1 py-1.5 rounded-lg bg-surface-hover hover:bg-primary/10 hover:text-primary border border-surface-border/50 text-xs transition-all flex items-center justify-center gap-1">
									<i class="fas fa-tools"></i>
									Repair
								</button>
								<button onclick="window.serverView.reinstallWarp({{ server.id }})" id="warpReinstallBtn" class="flex-1 py-1.5 rounded-lg bg-surface-hover hover:bg-surface-border text-content-secondary border border-surface-border/50 text-xs transition-all flex items-center justify-center gap-1">
									<i class="fas fa-redo"></i>
									Reinstall
								</button>
								<button onclick="window.serverView.uninstallWarp({{ server.id }}, '{{ server.name|e('js') }}')" id="warpUninstallBtn" class="flex-1 py-1.5 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 text-xs transition-all flex items-center justify-center gap-1">
									<i class="fas fa-trash-alt"></i>
									Remove
								</button>
							</div>
						</div>
					{% endif %}
				</div>

				<div class="panel p-5">
					<h3 class="text-sm font-semibold mb-4 uppercase tracking-wider opacity-70">{{ t('clients.add') }}</h3>
					<form onsubmit="handleAjaxForm(event, '/servers/{{ server.id }}/clients/create')" id="createClientForm">
						<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
						<div class="mb-3">
							<label for="clientName" class="sr-only">{{ t('clients.client_name') }}</label>
							<input name="name" required class="input-field" placeholder="{{ t('clients.client_name') }}" id="clientName" aria-label="{{ t('clients.client_name') }}">
						</div>
						<button type="submit" class="btn-primary w-full py-2.5 text-sm" id="createClientBtn">
							<i class="fas fa-plus mr-2"></i>
							<span id="createClientText">{{ t('clients.create_client') }}</span>
						</button>
					</form>
					<p class="text-[10px] text-muted mt-3 leading-relaxed">{{ t('clients.name_hint') }}</p>
				</div>
			</div>

			<!-- Global Search Localized for this Server -->
			<div class="lg:col-span-3">
				<div class="panel overflow-hidden flex flex-col min-h-[500px]">
					<div class="relative">
						<div class="px-5 py-3 border-b border-default bg-panel/30 flex flex-col md:flex-row md:items-center justify-between gap-4">
							<div class="flex items-center gap-4">
                                <h2 class="text-sm font-semibold uppercase tracking-widest opacity-70">{{ t('dashboard.fleet_search', [], 'Server Clients') }}</h2>
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                <div class="relative w-full md:w-48 lg:w-64">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-muted-foreground">
                                        <i class="fas fa-search text-[10px]"></i>
                                    </div>
                                    <input type="text" id="clientSearch" class="input-field input-with-icon !py-1.5 text-xs font-medium" placeholder="{{ t('dashboard.search_placeholder', [], 'Search clients…') }}" aria-label="{{ t('dashboard.search_placeholder', [], 'Search clients…') }}">
                                </div>
                                <select id="statusFilter" class="input-field !w-auto !py-1.5 pl-3 pr-8 text-xs font-medium cursor-pointer" aria-label="{{ t('common.status_all', [], 'Filter by Status') }}">
                                    <option value="all">{{ t('common.status_all', [], 'All Status') }}</option>
                                    <option value="online">{{ t('common.status_online', [], 'Online') }}</option>
                                    <option value="offline">{{ t('common.status_offline', [], 'Offline') }}</option>
                                    <option value="revoked">{{ t('status.revoked', [], 'Revoked') }}</option>
                                </select>
                                <select id="trafficFilter" class="input-field !w-auto !py-1.5 pl-3 pr-8 text-xs font-medium cursor-pointer" aria-label="{{ t('common.traffic_all', [], 'Filter by Traffic') }}">
                                    <option value="all">{{ t('common.traffic_all', [], 'All Traffic') }}</option>
                                    <option value="medium">{{ t('common.traffic_medium', [], '> 100MB') }}</option>
                                    <option value="high">{{ t('common.traffic_high', [], '> 1GB') }}</option>
                                </select>
                                <select id="sortFilter" class="input-field !w-auto !py-1.5 pl-3 pr-8 text-xs font-medium cursor-pointer" aria-label="{{ t('common.sort_newest', [], 'Sort by') }}">
                                    <option value="recent">{{ t('common.sort_newest', [], 'Newest') }}</option>
                                    <option value="handshake">{{ t('common.sort_handshake', [], 'Last Activity') }}</option>
                                    <option value="traffic">{{ t('common.sort_traffic', [], 'Most Traffic') }}</option>
                                    <option value="oldest">{{ t('common.sort_oldest', [], 'Oldest') }}</option>
                                </select>
                            </div>
                        </div>

                        <!-- Batch Action Bar Overlay -->
                        <div id="batchActionBar" class="absolute inset-0 bg-surface-panel z-20 hidden items-center justify-between px-5 py-3 border-b border-default animate-in fade-in duration-200">
                            <div class="flex items-center gap-3">
                                <span id="selectedCountText" class="text-xs font-semibold text-primary uppercase tracking-widest">0 SELECTED</span>
                                <button onclick="document.querySelectorAll('.client-checkbox').forEach(cb => cb.checked = false); window.serverView.updateBatchBar();" class="text-[10px] font-bold text-muted hover:text-primary uppercase tracking-wider ml-2 px-2 py-1 rounded border border-default hover:bg-surface-hover transition-colors">
                                    {{ t('common.clear_selection', [], 'Clear selection') }}
                                </button>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <button onclick="window.serverView.handleBatchAction('revoke')" class="btn-secondary !py-1 !px-2.5 text-xs font-medium text-amber-500 hover:text-amber-400">
                                    {{ t('common.revoke', [], 'Revoke') }}
                                </button>
                                <button onclick="window.serverView.handleBatchAction('restore')" class="btn-secondary !py-1 !px-2.5 text-xs font-medium text-green-500 hover:text-green-400">
                                    {{ t('common.restore', [], 'Restore') }}
                                </button>
                                <button onclick="window.serverView.handleBatchAction('delete')" class="btn-primary !py-1 !px-2.5 text-xs font-medium bg-destructive hover:bg-destructive/90 text-destructive-foreground">
                                    {{ t('common.delete', [], 'Delete') }}
                                </button>
                            </div>
                        </div>
                    </div>

					<div
						id="searchResults" class="flex-grow"><!-- Search results injected here -->
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- ===== Terminal Log Modal ===== -->
	<div id="logsModal" class="fixed inset-0 z-[200] flex items-center justify-center p-4 hidden" role="dialog" aria-modal="true" aria-labelledby="logsModalTitle">
		<!-- Backdrop -->
		<div class="absolute inset-0 bg-black/80" onclick="window.serverView.closeLogsModal()"></div>
		<!-- Panel -->
		<div class="relative w-full max-w-4xl h-[75vh] max-h-[600px] flex flex-col rounded-xl overflow-hidden shadow-2xl border border-surface-border">
			<!-- Terminal chrome -->
			<div class="flex items-center gap-2 px-4 py-3 bg-[#1e1e2e] border-b border-surface-border flex-shrink-0">
				<div class="flex gap-1.5">
					<button onclick="window.serverView.closeLogsModal()" class="w-3 h-3 rounded-full bg-error hover:opacity-85 transition-all" title="{{ t('common.close') }}"></button>
					<span class="w-3 h-3 rounded-full bg-warning"></span>
					<span class="w-3 h-3 rounded-full bg-success"></span>
				</div>
				<span class="ml-3 text-xs font-mono text-content-muted flex-1" id="logsModalTitle">nk-panel — {{ t('servers.deployment_logs') }}</span>
				<div class="flex items-center gap-2">
					<label class="flex items-center gap-1.5 text-[10px] text-content-muted cursor-pointer select-none">
						<input type="checkbox" id="logsAutoScroll" checked class="rounded border-surface-border bg-surface-base text-primary focus:ring-primary/20">
						{{ t('common.auto_scroll') }}
					</label>
					<button onclick="window.serverView.refreshLogs()" class="text-[10px] text-content-muted hover:text-primary transition-colors px-2 py-1 rounded border border-surface-border hover:border-primary/40" title="{{ t('common.refresh') }}">
						<i class="fas fa-redo-alt mr-1"></i>{{ t('common.refresh') }}
					</button>
				</div>
			</div>
			<!-- Log body -->
			<div id="logsBody" class="flex-1 overflow-y-auto bg-surface-base font-mono text-xs leading-relaxed px-4 py-3 text-content-primary">
				<p class="text-content-muted italic">{{ t('common.loading_logs') }}</p>
			</div>
			<!-- Footer -->
			<div class="flex items-center justify-between px-4 py-2 bg-[#1e1e2e] border-t border-surface-border flex-shrink-0">
				<span class="text-xs font-mono text-content-muted" id="logsCount">0 {{ t('servers.log_entries') }}</span>
				<button onclick="window.serverView.closeLogsModal()" class="text-[10px] px-3 py-1.5 rounded border border-surface-border text-content-muted hover:text-content-primary hover:border-surface-hover transition-all">{{ t('common.close') }}</button>
			</div>
		</div>
	</div>
	<script src="https://cdn.jsdelivr.net/npm/centrifuge@3.1.0/dist/centrifuge.min.js"></script>
	<script src="/js/servers/view.js?v=10"></script>

	<script>
		document.addEventListener('DOMContentLoaded', () => {
            const container = document.getElementById('server-view-container');
            if (container) {
                const config = JSON.parse(container.getAttribute('data-config'));
                window.serverView = new ServerView(config);
            }
        });
	</script>
{% endblock %}
