        });
        html += `</tbody></table></div>`;
    }
    
    resultsContainer.innerHTML = html;

    // Re-attach event listeners for checkboxes
    const selectAll = document.getElementById('selectAll');
    const checkboxes = document.querySelectorAll('.client-checkbox');

    if (selectAll) {
        selectAll.addEventListener('change', function() {
            checkboxes.forEach(cb => cb.checked = selectAll.checked);
            updateBatchBar();
        });
    }

    checkboxes.forEach(cb => {
        cb.addEventListener('change', updateBatchBar);
    });
}

function updateBatchBar() {
    const selected = document.querySelectorAll('.client-checkbox:checked');
    if (selected.length > 0) {
        batchActionBar.classList.remove('hidden');
        selectedCountText.innerText = labels.selected.replace('%s', selected.length);
    } else {
        batchActionBar.classList.add('hidden');
    }
}

window.handleBatchAction = async function(action) {
    const selected = Array.from(document.querySelectorAll('.client-checkbox:checked')).map(cb => cb.value);
    if (selected.length === 0) return;

    const confirmMsg = action === 'delete' ? labels.confirmDelete : null;
    if (confirmMsg && !confirm(confirmMsg)) return;

    handleAjaxAction('/clients/batch', { ids: selected, action: action }, null);
};

window.clientAction = async function (id, action, btn) {
    const confirmMsg = action === 'delete' ? labels.confirmDelete : null;
    handleAjaxAction(`/clients/${id}/${action}`, {}, confirmMsg);
};

// Event Listeners
searchInput.addEventListener('input', function (e) {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => performSearch(), 300);
});

[statusFilter, trafficFilter, sortFilter].forEach(el => {
    if (el) el.addEventListener('change', () => performSearch());
});

// Initial load
performSearch();
});

function initBeszel(ip) {
if (! ip) 
return;


fetch('/api/monitoring/beszel/' + ip).then(response => response.json()).then(res => {
if (res.success && res.data) {
const data = res.data;
const info = data.info || {};

document.getElementById('beszel-health-section').classList.remove('hidden');

// Update Hub Link to specific system
const hubLink = document.querySelector('a[title="Open Beszel Hub"]');
if (hubLink && data.id) {
const baseUrl = '{{ beszel_config.url }}'.replace(/\/$/, '');
hubLink.href = `${baseUrl}/system/${
data.id
}`;
}

// CPU
const cpu = info.cpu || 0;
document.getElementById('beszel-cpu-val').innerText = cpu.toFixed(1) + '%';
document.getElementById('beszel-cpu-bar').style.width = cpu + '%';
document.getElementById('beszel-cpu-info').innerText = (info.t || '?') + ' {{ t('monitoring.threads') }}';

// RAM
const ram = info.mp || 0;
document.getElementById('beszel-ram-val').innerText = ram.toFixed(1) + '%';
document.getElementById('beszel-ram-bar').style.width = ram + '%';
// Try to find memory capacity (in stats.m or data.m)
const stats = data.stats || {};
const totalMem = stats.m || data.m || info.m;
if (totalMem) {
document.getElementById('beszel-ram-info').innerText = totalMem.toFixed(1) + ' GB {{ t('monitoring.capacity') }}';
}

// Disk
const disk = info.dp || 0;
document.getElementById('beszel-disk-val').innerText = disk.toFixed(1) + '%';
document.getElementById('beszel-disk-bar').style.width = disk + '%';
// Try to find disk capacity (in stats.d or data.d)
const totalDisk = stats.d || data.d || info.d;
if (totalDisk) {
document.getElementById('beszel-disk-info').innerText = totalDisk.toFixed(0) + ' GB {{ t('monitoring.total_space') }}';
}

// Bandwidth calculation (Mbps)
// Use 'bb' (Bytes per second) from info if available
let rx_mbps = 0,
tx_mbps = 0,
total_mbps = 0;

if (info.bb) {
total_mbps = (info.bb * 8) / 1000000;
// For split RX/TX, we still need ns/nr or b
if (stats.nr || stats.ns) {
rx_mbps = (stats.nr || 0) * 8;
tx_mbps = (stats.ns || 0) * 8;
} else if (stats.b && Array.isArray(stats.b)) {
tx_mbps = (stats.b[0] * 8) / (15 * 1000000);
rx_mbps = (stats.b[1] * 8) / (15 * 1000000);
}
} else {
if (stats.nr || stats.ns) {
rx_mbps = (stats.nr || 0) * 8;
tx_mbps = (stats.ns || 0) * 8;
} else if (stats.b && Array.isArray(stats.b)) {
tx_mbps = (stats.b[0] * 8) / (15 * 1000000);
rx_mbps = (stats.b[1] * 8) / (15 * 1000000);
}
total_mbps = rx_mbps + tx_mbps;
}

const fmtBw = (val) => val >= 1000 ? (val / 1000).toFixed(2) + ' {{ t('common.gbps') }}' : val.toFixed(1) + ' {{ t('common.mbps') }}';

document.getElementById('beszel-bw-rx').innerText = fmtBw(rx_mbps);
document.getElementById('beszel-bw-tx').innerText = fmtBw(tx_mbps);
document.getElementById('beszel-bw-total').innerText = fmtBw(total_mbps);

// Load & Uptime
if (info.la) {
document.getElementById('beszel-load').innerText = info.la.map(l => l.toFixed(2)).join(' ');
}

if (info.u) {
const days = Math.floor(info.u / 86400);
const hours = Math.floor((info.u % 86400) / 3600);
document.getElementById('beszel-uptime').innerText = `{{ t('monitoring.uptime') }}: ${days}d ${hours}h`;
}
}
}).catch(err => console.error('Beszel error:', err));
}

document.addEventListener('DOMContentLoaded', function () {
initBeszel('{{ server.host }}');
// Refresh every 15 seconds to match Beszel agent
setInterval(() => initBeszel('{{ server.host }}'), 15000);
});
	</script>
