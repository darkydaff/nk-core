{% extends "layout.twig" %}

{% block title %}Servers Telemetry Control Room & SLO Diagnostics{% endblock %}

{% block breadcrumbs %}
    <li><a href="/servers" class="hover:text-primary transition-colors">Servers</a></li>
    <li><i class="fas fa-chevron-right text-[10px] mx-2 opacity-50"></i></li>
    <li class="text-primary font-semibold">Telemetry & SLO Diagnostics</li>
{% endblock %}

{% block styles %}
<style>
    .glass-panel {
        background: var(--color-surface-panel);
        border: 1px solid var(--color-surface-border);
        border-radius: 24px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: var(--shadow-sm);
    }
    .glass-panel:hover {
        border-color: var(--color-primary);
        box-shadow: var(--shadow-md);
    }
    .ring-progress {
        transform: rotate(-90deg);
        transform-origin: 50% 50%;
        transition: stroke-dashoffset 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .terminal-window {
        background: var(--color-surface-base);
        border: 1px solid var(--color-surface-border);
        border-radius: 16px;
        font-family: 'Geist Mono', monospace;
    }
</style>
{% endblock %}

{% block content %}
<div class="space-y-8 animate-fade-in text-content-primary">
    <!-- Header with Pulse Status -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-content-primary flex items-center gap-3">
                <span class="relative flex h-3 w-3">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                </span>
                Servers Telemetry Operations Center
            </h1>
            <p class="text-content-secondary mt-1">Real-time closed-loop control system, SLO compliance audits, and failure modeling.</p>
        </div>
        <div class="flex items-center gap-3">
            <button onclick="runStabilitySweep()" class="btn-primary px-5 py-2.5 flex items-center gap-2">
                <i class="fas fa-satellite-dish"></i> Run Stability Sweep
            </button>
        </div>
    </div>

    <!-- Core SLO Compliance Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <!-- SLO Ingestion Ring -->
        <div class="glass-panel p-6 flex flex-col items-center text-center">
            <div class="relative w-32 h-32">
                <svg class="w-full h-full">
                    <circle cx="64" cy="64" r="50" fill="transparent" stroke="var(--color-surface-border)" stroke-width="8" opacity="0.3"/>
                    <circle id="ring-ingest" class="ring-progress" cx="64" cy="64" r="50" fill="transparent" stroke="var(--color-status-active)" stroke-width="8" stroke-dasharray="314" stroke-dashoffset="314"/>
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span id="txt-ingest" class="text-2xl font-bold text-content-primary">0%</span>
                    <span class="text-[9px] text-content-muted uppercase tracking-widest mt-0.5">SLO Target</span>
                </div>
            </div>
            <h3 class="text-sm font-semibold text-content-primary mt-4">Ingestion Latency</h3>
            <p class="text-xs text-content-muted mt-1">$p95 < 20\text{ms}$ contract threshold</p>
        </div>

        <!-- SLO DB Ring -->
        <div class="glass-panel p-6 flex flex-col items-center text-center">
            <div class="relative w-32 h-32">
                <svg class="w-full h-full">
                    <circle cx="64" cy="64" r="50" fill="transparent" stroke="var(--color-surface-border)" stroke-width="8" opacity="0.3"/>
                    <circle id="ring-db" class="ring-progress" cx="64" cy="64" r="50" fill="transparent" stroke="var(--color-primary)" stroke-width="8" stroke-dasharray="314" stroke-dashoffset="314"/>
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span id="txt-db" class="text-2xl font-bold text-content-primary">0%</span>
                    <span class="text-[9px] text-content-muted uppercase tracking-widest mt-0.5">SLO Target</span>
                </div>
            </div>
            <h3 class="text-sm font-semibold text-content-primary mt-4">DB Transactions</h3>
            <p class="text-xs text-content-muted mt-1">$p95 < 15\text{ms}$ transaction locks</p>
        </div>

        <!-- SLO WebSocket Ring -->
        <div class="glass-panel p-6 flex flex-col items-center text-center">
            <div class="relative w-32 h-32">
                <svg class="w-full h-full">
                    <circle cx="64" cy="64" r="50" fill="transparent" stroke="var(--color-surface-border)" stroke-width="8" opacity="0.3"/>
                    <circle id="ring-ws" class="ring-progress" cx="64" cy="64" r="50" fill="transparent" stroke="var(--color-status-warning)" stroke-width="8" stroke-dasharray="314" stroke-dashoffset="314"/>
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span id="txt-ws" class="text-2xl font-bold text-content-primary">0%</span>
                    <span class="text-[9px] text-content-muted uppercase tracking-widest mt-0.5">SLO Target</span>
                </div>
            </div>
            <h3 class="text-sm font-semibold text-content-primary mt-4">WebSocket Fanout</h3>
            <p class="text-xs text-content-muted mt-1">Publish delay < 10ms boundaries</p>
        </div>

        <!-- SLO Freshness Ring -->
        <div class="glass-panel p-6 flex flex-col items-center text-center">
            <div class="relative w-32 h-32">
                <svg class="w-full h-full">
                    <circle cx="64" cy="64" r="50" fill="transparent" stroke="var(--color-surface-border)" stroke-width="8" opacity="0.3"/>
                    <circle id="ring-fresh" class="ring-progress" cx="64" cy="64" r="50" fill="transparent" stroke="#ec4899" stroke-width="8" stroke-dasharray="314" stroke-dashoffset="314"/>
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span id="txt-fresh" class="text-2xl font-bold text-content-primary">0%</span>
                    <span class="text-[9px] text-content-muted uppercase tracking-widest mt-0.5">SLO Target</span>
                </div>
            </div>
            <h3 class="text-sm font-semibold text-content-primary mt-4">Node Freshness</h3>
            <p class="text-xs text-content-muted mt-1">Telemetry update window < 30s</p>
        </div>
    </div>

    <!-- Main Node Matrix & Simulator Split -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Node Fleet Status Table -->
        <div class="lg:col-span-2 glass-panel p-6">
            <h2 class="text-lg font-bold text-content-primary flex items-center gap-2 mb-4">
                <i class="fas fa-server text-primary"></i> Active Telemetry Nodes
            </h2>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-surface-border/50 text-content-muted text-xs font-semibold uppercase tracking-wider">
                            <th class="pb-3">Node Name</th>
                            <th class="pb-3">Current State</th>
                            <th class="pb-3 text-center">Health Grade</th>
                            <th class="pb-3 text-right">Metrics & Drift</th>
                            <th class="pb-3 text-right">Diagnostics</th>
                        </tr>
                    </thead>
                    <tbody id="nodes-table-body" class="divide-y divide-surface-border/30 text-sm text-content-secondary">
                        <tr>
                            <td colspan="5" class="py-8 text-center text-content-muted">
                                <i class="fas fa-circle-notch fa-spin mr-2"></i> Querying server diagnostics...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- SRE Simulator Box -->
        <div class="glass-panel p-6 flex flex-col gap-6">
            <div>
                <h2 class="text-lg font-bold text-content-primary flex items-center gap-2">
                    <i class="fas fa-flask text-warning"></i> Resiliency Chaos Lab
                </h2>
                <p class="text-xs text-content-muted mt-1">Inject failure patterns into the local ingestion framework to evaluate recovery behavior.</p>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <button onclick="triggerScenario('db_slow')" class="p-3 text-left rounded-xl bg-surface-base border border-surface-border hover:border-warning/50 hover:bg-warning/5 transition-all group">
                    <div class="text-xs font-bold text-content-primary group-hover:text-warning transition-colors">Slow Database</div>
                    <div class="text-[10px] text-content-muted mt-0.5">25ms simulated DB transaction lag</div>
                </button>
                <button onclick="triggerScenario('ws_outage')" class="p-3 text-left rounded-xl bg-surface-base border border-surface-border hover:border-primary/50 hover:bg-primary/5 transition-all group">
                    <div class="text-xs font-bold text-content-primary group-hover:text-primary transition-colors">WS Outage</div>
                    <div class="text-[10px] text-content-muted mt-0.5">Centrifugo circuit break trip</div>
                </button>
                <button onclick="triggerScenario('replay_storm')" class="p-3 text-left rounded-xl bg-surface-base border border-surface-border hover:border-primary/50 hover:bg-primary/5 transition-all group">
                    <div class="text-xs font-bold text-content-primary group-hover:text-primary transition-colors">Replay Storm</div>
                    <div class="text-[10px] text-content-muted mt-0.5">50% out-of-order stale packets</div>
                </button>
                <button onclick="triggerScenario('mixed_failures')" class="p-3 text-left rounded-xl bg-surface-base border border-surface-border hover:border-error/50 hover:bg-error/5 transition-all group">
                    <div class="text-xs font-bold text-content-primary group-hover:text-error transition-colors">Mixed Cascade</div>
                    <div class="text-[10px] text-content-muted mt-0.5">Combined delays & packet replays</div>
                </button>
                <button onclick="triggerScenario('adversarial')" class="p-3 text-left rounded-xl bg-surface-base border border-surface-border hover:border-error/70 hover:bg-error/10 transition-all group col-span-2">
                    <div class="text-xs font-bold text-content-primary group-hover:text-error transition-colors flex items-center gap-1.5">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-error opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-error"></span>
                        </span>
                        Adversarial Sequencing Cascade
                    </div>
                    <div class="text-[10px] text-content-muted mt-0.5">Worst-case compounding cascading failure storm over 4 ticking stages</div>
                </button>
            </div>

            <div class="terminal-window p-4 flex-grow flex flex-col min-h-[220px]">
                <div class="flex items-center justify-between border-b border-surface-border/30 pb-2 mb-3">
                    <div class="flex items-center gap-1.5">
                        <span class="w-3 h-3 rounded-full bg-error"></span>
                        <span class="w-3 h-3 rounded-full bg-warning"></span>
                        <span class="w-3 h-3 rounded-full bg-success"></span>
                    </div>
                    <span class="text-[10px] text-content-muted tracking-wider uppercase">SRE Chaos Terminal</span>
                </div>
                <div id="terminal-content" class="text-xs text-success overflow-y-auto max-h-[240px] flex-grow space-y-1.5 scrollbar-thin">
                    <div class="text-content-muted">> Waiting for scenario launch...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Transition Graph Analysis Modal -->
<div id="transition-modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="glass-panel max-w-2xl w-full p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-surface-border pb-4">
            <h2 class="text-lg font-bold text-content-primary flex items-center gap-2">
                <i class="fas fa-project-diagram text-primary"></i> Nonlinear Control Loop Damping Graph
                <span id="modal-loop-state" class="text-[10px] font-bold badge-state idle ml-2">STABLE</span>
            </h2>
            <button onclick="closeTransitionModal()" class="text-content-muted hover:text-content-primary transition-colors">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
            <div class="bg-surface-base p-4 rounded-xl border border-surface-border">
                <div id="modal-instability-index" class="text-xl font-bold text-content-primary">0.00</div>
                <div class="text-[10px] text-content-muted uppercase mt-1">Instability Index</div>
            </div>
            <div class="bg-surface-base p-4 rounded-xl border border-surface-border">
                <div id="modal-reciprocal-cycles" class="text-xl font-bold text-primary">0</div>
                <div class="text-[10px] text-content-muted uppercase mt-1">Reciprocal Cycles</div>
            </div>
            <div class="bg-surface-base p-4 rounded-xl border border-surface-border">
                <div id="modal-entropy" class="text-xl font-bold text-success">0.00</div>
                <div class="text-[10px] text-content-muted uppercase mt-1">Shannon Entropy</div>
            </div>
            <div class="bg-surface-base p-4 rounded-xl border border-surface-border">
                <div id="modal-damping" class="text-xl font-bold text-error">1.00</div>
                <div class="text-[10px] text-content-muted uppercase mt-1">Damping Ratio</div>
            </div>
        </div>

        <div class="space-y-3">
            <h3 class="text-sm font-semibold text-content-primary">Transition History Logs</h3>
            <div id="modal-transitions-list" class="max-h-[240px] overflow-y-auto space-y-2 pr-2 scrollbar-thin text-xs text-content-secondary">
                <!-- Transition items inject dynamically -->
            </div>
        </div>
    </div>
</div>

<!-- Explainability Trace Modal -->
<div id="explain-modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="glass-panel max-w-xl w-full p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-surface-border pb-4">
            <h2 class="text-lg font-bold text-content-primary flex items-center gap-2">
                <i class="fas fa-search text-success"></i> Decision Path Explainability Trace
            </h2>
            <button onclick="closeExplainModal()" class="text-content-muted hover:text-content-primary transition-colors">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="bg-surface-base p-4 rounded-xl border border-surface-border font-mono text-xs text-success max-h-[300px] overflow-y-auto space-y-2 scrollbar-thin">
            <div id="explain-modal-trace"></div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        pollDiagnostics();
        setInterval(pollDiagnostics, 5000);
    });

    async function pollDiagnostics() {
        try {
            const response = await fetch('/api/system/nodes');
            const data = await response.json();
            if (data.success && data.nodes) {
                renderNodesTable(data.nodes);
                calculateAggregateSLOs(data.nodes);
            }
        } catch (e) {
            console.error("Failed to sync server diagnostics: ", e);
        }
    }

    function renderNodesTable(nodes) {
        const tbody = document.getElementById('nodes-table-body');
        if (!tbody) return;

        if (nodes.length === 0) {
            tbody.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-content-muted">No servers active.</td></tr>`;
            return;
        }

        tbody.innerHTML = nodes.map(node => {
            let stateClass = 'idle';
            if (node.telemetry_state === 'ACTIVE_5S') stateClass = 'active';
            if (node.telemetry_state === 'BACKPRESSURE_30S') stateClass = 'backpressure';

            const healthColor = node.server_health_score > 90 ? 'text-success' : (node.server_health_score > 60 ? 'text-warning' : 'text-error');
            const decisionJson = JSON.stringify(node.decision_path || []);

            return `
                <tr class="hover:bg-surface-hover/50 transition-colors">
                    <td class="py-4 font-semibold text-content-primary">
                        ${node.name}
                        <div class="text-[10px] text-content-muted font-normal mt-0.5">${node.host}</div>
                    </td>
                    <td class="py-4">
                        <span class="badge-state ${stateClass}">
                            <span class="relative flex h-2 w-2">
                                <span class="relative inline-flex rounded-full h-2 w-2 ${node.telemetry_state === 'ACTIVE_5S' ? 'bg-success' : (node.telemetry_state === 'BACKPRESSURE_30S' ? 'bg-error' : 'bg-primary')}"></span>
                            </span>
                            ${node.telemetry_state || 'IDLE_15S'}
                        </span>
                    </td>
                    <td class="py-4 text-center font-bold ${healthColor}">${node.server_health_score}/100</td>
                    <td class="py-4 text-right font-mono text-xs text-content-primary">
                        <div class="text-content-primary">${node.last_db_time_ms ? parseFloat(node.last_db_time_ms).toFixed(1) + 'ms' : '0.0ms'}</div>
                        <div class="text-[10px] text-content-muted">Drift: ${node.baseline_drift_index ? parseFloat(node.baseline_drift_index).toFixed(1) + '%' : '0%'}</div>
                    </td>
                    <td class="py-4 text-right space-x-2 whitespace-nowrap">
                        <button onclick='openExplainModal(${decisionJson})' class="px-3 py-1.5 rounded-lg bg-success/10 text-success border border-success/20 hover:bg-success/20 transition-colors text-xs font-semibold">
                            Explain
                        </button>
                        <button onclick="openTransitionModal(${node.id})" class="px-3 py-1.5 rounded-lg bg-primary/10 text-primary border border-primary/20 hover:bg-primary/20 transition-colors text-xs font-semibold">
                            Transitions
                        </button>
                    </td>
                </tr>
            `;
        }).join('');
    }

    function calculateAggregateSLOs(nodes) {
        if (nodes.length === 0) return;

        let ingestViolations = 0;
        let dbViolations = 0;
        let wsViolations = 0;
        let freshnessViolations = 0;

        const now = Math.floor(Date.now() / 1000);

        nodes.forEach(node => {
            if (parseFloat(node.last_ingest_latency_ms) > 20.0) ingestViolations++;
            if (parseFloat(node.last_db_time_ms) > 15.0) dbViolations++;
            if (parseFloat(node.last_centrifugo_time_ms) > 10.0) wsViolations++;

            const lastTelemetry = node.last_telemetry_ts ? parseInt(node.last_telemetry_ts) : 0;
            if (now - lastTelemetry > 30) freshnessViolations++;
        });

        const ingestComp = ((1 - ingestViolations / nodes.length) * 100).toFixed(0);
        const dbComp = ((1 - dbViolations / nodes.length) * 100).toFixed(0);
        const wsComp = ((1 - wsViolations / nodes.length) * 100).toFixed(0);
        const freshComp = ((1 - freshnessViolations / nodes.length) * 100).toFixed(0);

        updateSLORing('ingest', ingestComp);
        updateSLORing('db', dbComp);
        updateSLORing('ws', wsComp);
        updateSLORing('fresh', freshComp);
    }

    function updateSLORing(id, percent) {
        const ring = document.getElementById(`ring-${id}`);
        const txt = document.getElementById(`txt-${id}`);
        if (!ring || !txt) return;

        txt.textContent = `${percent}%`;
        const offset = 314 - (314 * percent) / 100;
        ring.setAttribute('stroke-dashoffset', offset);

        if (percent >= 95) ring.setAttribute('stroke', 'var(--color-status-active)');
        else if (percent >= 80) ring.setAttribute('stroke', 'var(--color-status-warning)');
        else ring.setAttribute('stroke', 'var(--color-status-error)');
    }

    async function openTransitionModal(serverId) {
        const modal = document.getElementById('transition-modal');
        if (!modal) return;

        try {
            const response = await fetch(`/api/system/transitions?server_id=${serverId}`);
            const data = await response.json();
            if (data.success) {
                document.getElementById('modal-instability-index').textContent = data.metrics.cumulative_instability_index.toFixed(2);
                document.getElementById('modal-reciprocal-cycles').textContent = data.metrics.reciprocal_cycle_count;
                document.getElementById('modal-entropy').textContent = data.metrics.loop_entropy.toFixed(2);
                document.getElementById('modal-damping').textContent = data.metrics.control_loop_damping.toFixed(2);
                
                const stateEl = document.getElementById('modal-loop-state');
                stateEl.textContent = data.status.toUpperCase();
                stateEl.className = `text-[10px] font-bold badge-state justify-center ml-2 ${data.status === 'stable' ? 'idle' : 'backpressure'}`;

                const list = document.getElementById('modal-transitions-list');
                if (data.transitions.length === 0) {
                    list.innerHTML = `<div class="text-content-muted p-4 text-center">No state transitions recorded yet for this server loop.</div>`;
                } else {
                    list.innerHTML = data.transitions.map(t => {
                        return `
                            <div class="flex items-center justify-between p-3 bg-surface-panel border border-surface-border rounded-xl">
                                <div>
                                    <div class="font-semibold text-content-primary flex items-center gap-1.5">
                                        <span class="text-content-muted">${t.from_state}</span>
                                        <i class="fas fa-arrow-right text-[10px] opacity-40"></i>
                                        <span class="text-primary">${t.to_state}</span>
                                    </div>
                                    <div class="text-[10px] text-content-muted mt-0.5">Trigger: ${t.trigger_event}</div>
                                </div>
                                <div class="text-right">
                                    <div class="font-mono font-semibold text-content-primary">+${parseFloat(t.instability_weight).toFixed(2)}</div>
                                    <div class="text-[9px] text-content-muted">${t.created_at}</div>
                                </div>
                            </div>
                        `;
                    }).join('');
                }

                modal.classList.remove('hidden');
            }
        } catch (e) {
            console.error("Failed to load transition logs: ", e);
        }
    }

    function closeTransitionModal() {
        document.getElementById('transition-modal').classList.add('hidden');
    }

    function openExplainModal(decisionPath) {
        const modal = document.getElementById('explain-modal');
        const traceEl = document.getElementById('explain-modal-trace');
        if (!modal || !traceEl) return;

        if (decisionPath.length === 0) {
            traceEl.innerHTML = `<div class="text-content-muted">No decision trace recorded. Wait for next telemetry tick.</div>`;
        } else {
            traceEl.innerHTML = decisionPath.map(trace => {
                return `<div class="flex items-start gap-2">
                    <span class="text-content-muted select-none">↳</span>
                    <span>${trace}</span>
                </div>`;
            }).join('');
        }
        modal.classList.remove('hidden');
    }

    function closeExplainModal() {
        document.getElementById('explain-modal').classList.add('hidden');
    }

    async function triggerScenario(scenario) {
        const term = document.getElementById('terminal-content');
        if (!term) return;

        term.innerHTML = `<div class="text-content-muted">> Launching scenario: ${scenario} simulation...</div>`;
        
        try {
            const response = await fetch(`/api/system/replay?scenario=${scenario}`);
            const data = await response.json();

            if (data.success && data.logs) {
                // Pipe SRE console output into the terminal live!
                term.innerHTML = '';
                let i = 0;
                const interval = setInterval(() => {
                    if (i < data.logs.length) {
                        const line = document.createElement('div');
                        // Colorize specific terminal flags
                        let text = data.logs[i];
                        if (text.includes('🚨') || text.includes('💥')) {
                            line.className = 'text-content-primary font-bold';
                        } else if (text.includes('⚠️')) {
                            line.className = 'text-warning';
                        } else if (text.includes('📡')) {
                            line.className = 'text-content-secondary';
                        } else if (text.includes('📊')) {
                            line.className = 'text-primary';
                        }
                        line.textContent = text;
                        term.appendChild(line);
                        term.scrollTop = term.scrollHeight;
                        i++;
                    } else {
                        clearInterval(interval);
                        pollDiagnostics();
                    }
                }, 150);
            }
        } catch (e) {
            term.innerHTML += `<div class="text-error">> Error executing chaos harness. Check logs.</div>`;
        }
    }

    async function runStabilitySweep() {
        const term = document.getElementById('terminal-content');
        if (!term) return;

        term.innerHTML = `<div class="text-content-muted">> Starting stability envelope sweep matrix...</div>`;
        term.innerHTML += `<div>> Sweeping Region A to Region D boundaries...</div>`;

        try {
            const response = await fetch(`/api/system/replay?scenario=sweep`);
            const data = await response.json();
            if (data.success && data.logs) {
                term.innerHTML = '';
                let i = 0;
                const interval = setInterval(() => {
                    if (i < data.logs.length) {
                        const line = document.createElement('div');
                        let text = data.logs[i];
                        if (text.includes('MAP') || text.includes('===')) {
                            line.className = 'text-content-primary font-bold';
                        } else if (text.includes('Region')) {
                            line.className = 'text-primary';
                        }
                        line.textContent = text;
                        term.appendChild(line);
                        term.scrollTop = term.scrollHeight;
                        i++;
                    } else {
                        clearInterval(interval);
                        pollDiagnostics();
                    }
                }, 100);
            }
        } catch (e) {
            term.innerHTML += `<div class="text-error">> Error executing sweep matrix.</div>`;
        }
    }
</script>
{% endblock %}
