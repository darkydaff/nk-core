{% extends "layout.twig" %}
{% block title %}{{ t('servers.deploy') }} {{ server.name }}{% endblock %}
{% block content %}
<div class="max-w-4xl mx-auto px-4 py-8 w-full">
    <div class="mb-8 text-center">
        <div class="w-16 h-16 rounded-xl bg-surface-hover text-primary flex items-center justify-center mx-auto mb-4">
            <i class="fas fa-rocket text-3xl"></i>
        </div>
        <h1 class="text-2xl font-bold text-primary mb-2">{{ t('servers.deploying') }}: {{ server.name }}</h1>
        <p class="text-secondary">{{ t('servers.deploy_init') }} <code class="text-primary">{{ server.host }}</code></p>
    </div>

    <div class="panel p-2 mb-6">
        <div class="flex items-center gap-2 px-4 py-2 bg-panel rounded-t-lg border-b border-default">
            <div class="w-3 h-3 rounded-full bg-red-500"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
            <span class="ml-3 text-xs font-mono text-muted">root@{{ server.host }}:~</span>
        </div>
        
        <div id="deployLog" class="bg-base text-primary p-4 rounded-b-lg font-mono text-sm leading-relaxed h-[300px] overflow-y-auto">
            <div class="text-muted mb-2">amnezia@panel:~$ ./deploy.sh</div>
            <div class="text-secondary">{{ t('servers.ready_to_deploy') }}</div>
        </div>
    </div>

    <div class="text-center">
        <button id="deployBtn" onclick="deploy()" class="btn-primary px-8 py-3 text-base font-semibold">
            <span id="btnText">{{ t('servers.start_deploy') }}</span>
            <i id="btnSpinner" class="fas fa-spinner fa-spin ml-2 hidden"></i>
            <i class="fas fa-rocket ml-2" id="btnIcon"></i>
        </button>
    </div>
</div>

<script>
function deploy() {
    const btn = document.getElementById('deployBtn');
    const btnText = document.getElementById('btnText');
    const btnSpinner = document.getElementById('btnSpinner');
    const btnIcon = document.getElementById('btnIcon');
    const log = document.getElementById('deployLog');
    
    btn.disabled = true;
    btnText.textContent = '{{ t('servers.deploying')|e('js') }}...';
    btnSpinner.classList.remove('hidden');
    if(btnIcon) btnIcon.classList.add('hidden');
    
    log.innerHTML = '<div class="text-muted mb-2">amnezia@panel:~$ ./deploy.sh</div>';
    log.innerHTML += '<div class="text-primary mb-2">{{ t('servers.connecting_server')|e('js') }}</div>';
    
    setTimeout(() => log.innerHTML += '<div class="text-blue-400 mb-2">{{ t('servers.installing_docker')|e('js') }}</div>', 800);
    setTimeout(() => log.innerHTML += '<div class="text-secondary mb-2">{{ t('servers.building_awg')|e('js') }}</div>', 1600);
    setTimeout(() => log.innerHTML += '<div class="text-yellow-400 mb-2">{{ t('servers.generating_keys')|e('js') }}</div>', 2400);
    
    const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
    fetch('/servers/{{ server.id }}/deploy', {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'X-CSRF-Token': csrfToken }
    })
    .then(async (r) => {
        const raw = await r.text();
        let d;
        try { d = JSON.parse(raw); }
        catch (e) { throw new Error('{{ t('servers.non_json_response')|e('js') }}: ' + raw.slice(0, 240)); }
        if (!r.ok && !d.error) d.error = 'HTTP ' + r.status;
        return d;
    })
    .then(d => {
        if (d.success) {
            log.innerHTML += '<div class="text-primary font-bold mt-4 p-2 bg-primary/10 border border-primary/30 rounded">{{ t('message.deployed')|e('js') }}</div>';
            log.innerHTML += '<div class="text-secondary mt-2">{{ t('servers.deploy_queued')|e('js')|default('Deployment queued — waiting for worker…') }}</div>';
            btnText.textContent = '{{ t('servers.deploying')|e('js') }}…';
            btnSpinner.classList.remove('hidden');
            log.scrollTop = log.scrollHeight;
            // Smart polling: redirect as soon as the worker finishes
            let pollAttempts = 0;
            const maxPollAttempts = 240; // 240 × 2.5s = 10 minutes max
            const pollTimer = setInterval(() => {
                if (++pollAttempts > maxPollAttempts) {
                    clearInterval(pollTimer);
                    log.innerHTML += '<div class="text-yellow-400 mt-2">Polling timed out. <a href="/servers/{{ server.id }}" class="underline">Click here</a> to check status.</div>';
                    log.scrollTop = log.scrollHeight;
                    btn.disabled = false;
                    btnText.textContent = '{{ t('servers.retry_deploy')|e('js') }}';
                    btnSpinner.classList.add('hidden');
                    if (btnIcon) btnIcon.classList.remove('hidden');
                    return;
                }
                // GET request — no CSRF token required
                fetch('/servers/{{ server.id }}/status', {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(r => r.json())
                .then(data => {
                    if (data.status && data.status !== 'deploying') {
                        clearInterval(pollTimer);
                        log.innerHTML += `<div class="text-green-400 font-bold mt-2">Status: ${data.status} — redirecting…</div>`;
                        log.scrollTop = log.scrollHeight;
                        localStorage.removeItem('globalScrollPos');
                        setTimeout(() => window.location.href = '/servers/{{ server.id }}', 800);
                    }
                })
                .catch(() => { /* keep polling on transient network error */ });
            }, 2500);
        } else {
            log.innerHTML += '<div class="text-red-400 font-bold mt-4 p-2 bg-red-500/10 border border-red-500/30 rounded">{{ t('message.error')|e('js') }}: ' + (d.error || '{{ t('message.unknown_error')|e('js') }}') + '</div>';
            btn.disabled = false;
            btnText.textContent = '{{ t('servers.retry_deploy')|e('js') }}';
            btnSpinner.classList.add('hidden');
            if(btnIcon) btnIcon.classList.remove('hidden');
        }
    })
    .catch(e => {
        log.innerHTML += '<div class="text-red-400 font-bold mt-4 p-2 bg-red-500/10 border border-red-500/30 rounded">{{ t('message.connection_error')|e('js') }}: ' + e.message + '</div>';
        btn.disabled = false;
        btnText.textContent = '{{ t('servers.retry_deploy')|e('js') }}';
        btnSpinner.classList.add('hidden');
        if(btnIcon) btnIcon.classList.remove('hidden');
    });
}
</script>
{% endblock %}
