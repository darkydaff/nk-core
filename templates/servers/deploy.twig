{% extends "layout.twig" %}
{% block title %}{{ t('servers.deploy') }} {{ server.name }}{% endblock %}

{% block breadcrumbs %}
    <li class="flex items-center">
        <a href="/servers" class="hover:text-primary">{{ t('menu.servers') }}</a>
    </li>
    <li class="flex items-center">
        <i class="fas fa-chevron-right mx-2 opacity-30"></i>
        <a href="/servers/{{ server.id }}" class="hover:text-primary">{{ server.name }}</a>
    </li>
    <li class="flex items-center">
        <i class="fas fa-chevron-right mx-2 opacity-30"></i>
        <span>{{ t('servers.deploy') }}</span>
    </li>
{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto px-4 py-8 w-full">
    <div class="mb-8 text-center">
        <div class="w-16 h-16 rounded-xl bg-surface-hover text-primary flex items-center justify-center mx-auto mb-4">
            <i class="fas fa-rocket text-3xl"></i>
        </div>
        <h1 class="text-2xl font-bold text-primary mb-2">{{ t('servers.deploying') }}: {{ server.name }}</h1>
        <p class="text-secondary">{{ t('servers.deploy_init') }} <code class="text-primary">{{ server.host }}</code></p>
    </div>

    <div class="panel p-0 mb-6 overflow-hidden border-2 border-primary/20 shadow-lg shadow-primary/5">
        <!-- Terminal Header -->
        <div class="flex items-center justify-between px-4 py-2 bg-surface-hover border-b border-default">
            <div class="flex items-center gap-2">
                <div class="w-3 h-3 rounded-full bg-red-500/80 shadow-sm shadow-red-500/20"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500/80 shadow-sm shadow-yellow-500/20"></div>
                <div class="w-3 h-3 rounded-full bg-green-500/80 shadow-sm shadow-green-500/20"></div>
                <span class="ml-3 text-[10px] uppercase tracking-widest font-bold text-muted">deployment_console.sh</span>
            </div>
            <div class="text-[10px] font-mono text-muted/50 uppercase tracking-wider">SSHv2 / AES-256</div>
        </div>
        
        <!-- Terminal Body -->
        <div class="relative group">
            <!-- Scanline Overlay -->
            <div class="pointer-events-none absolute inset-0 bg-scanlines opacity-[0.03] z-10"></div>
            
            <div id="deployLog" class="bg-[#0c0c0d] text-primary/90 p-6 font-mono text-xs leading-relaxed h-[400px] overflow-y-auto scrollbar-thin scrollbar-thumb-primary/20">
                <div class="text-muted/60 mb-2 flex items-center gap-2">
                    <span class="text-green-500">➜</span>
                    <span class="text-blue-400">~/nk-panel</span>
                    <span class="text-primary/40 font-bold">./deploy --target={{ server.host }}</span>
                </div>
                <div class="text-primary/40 italic mb-4 border-b border-primary/5 pb-2">Initializing secure handshake...</div>
                <div id="logContent">
                    <div class="text-muted/50 italic">{{ t('servers.ready_to_deploy') }}</div>
                </div>
                <!-- Blinking Cursor -->
                <div class="inline-block w-1.5 h-4 bg-primary/40 ml-1 terminal-cursor align-middle"></div>
            </div>
        </div>
    </div>

    <div class="text-center">
        <button id="deployBtn" onclick="deploy()" class="btn-primary px-10 py-4 text-base font-bold shadow-xl shadow-primary/20 hover:scale-[1.02] transition-all active:scale-[0.98]">
            <span id="btnText">{{ t('servers.start_deploy') }}</span>
            <i id="btnSpinner" class="fas fa-spinner fa-spin ml-2 hidden"></i>
            <i class="fas fa-rocket ml-2" id="btnIcon"></i>
        </button>
    </div>
</div>

<style>
/* Performance-optimized scanlines using a simple repeating pattern */
.bg-scanlines {
    background: linear-gradient(
        to bottom,
        transparent,
        transparent 50%,
        rgba(0, 0, 0, 0.15) 50%,
        rgba(0, 0, 0, 0.15)
    );
    background-size: 100% 4px;
}

/* Fast opacity-based blink for the cursor */
@keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
}
.terminal-cursor {
    animation: blink 1s step-end infinite;
}
</style>

<script>
function deploy() {
    const btn = document.getElementById('deployBtn');
    const btnText = document.getElementById('btnText');
    const btnSpinner = document.getElementById('btnSpinner');
    const btnIcon = document.getElementById('btnIcon');
    const log = document.getElementById('deployLog');
    const logContent = document.getElementById('logContent');
    
    btn.disabled = true;
    btnText.textContent = '{{ t('servers.deploying')|e('js') }}...';
    btnSpinner.classList.remove('hidden');
    if(btnIcon) btnIcon.classList.add('hidden');
    
    logContent.innerHTML = '<div class="text-primary/60 mb-2">Connecting to deployment engine...</div>';
    
    const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
    fetch('/servers/{{ server.id }}/deploy', {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'X-CSRF-Token': csrfToken }
    })
    .then(async (r) => {
        const raw = await r.text();
        let d;
        try { d = JSON.parse(raw); }
        catch (e) { throw new Error('{{ t('servers.non_json_response')|e('js') }}: ' + raw.slice(0, 240)); }
        if (!r.ok && !d.error) d.error = 'HTTP ' + r.status;
        return d;
    })
    .then(d => {
        if (d.success) {
            btnText.textContent = '{{ t('servers.deploying')|e('js') }}…';
            btnSpinner.classList.remove('hidden');

            const displayedLogs = new Set();
            let isUserScrolling = false;

            // Detect if user is manually scrolling up
            log.addEventListener('scroll', () => {
                const distanceToBottom = log.scrollHeight - log.scrollTop - log.clientHeight;
                isUserScrolling = distanceToBottom > 50; 
            });

            // Polling logs every second
            const logTimer = setInterval(() => {
                fetch('/api/servers/{{ server.id }}/deployment-logs', {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success && data.logs) {
                        data.logs.forEach(entry => {
                            // Unique key using timestamp, message and level
                            const logKey = `${entry.datetime}_${entry.level}_${entry.message}`;
                            if (!displayedLogs.has(logKey)) {
                                const time = new Date(entry.datetime).toLocaleTimeString();
                                let color = 'text-primary/80';
                                let icon = '<span class="text-blue-500/50">⬡</span>';
                                
                                if (entry.level_name === 'WARNING') {
                                    color = 'text-yellow-400';
                                    icon = '<span class="text-yellow-500">⚠</span>';
                                } else if (entry.message.toLowerCase().includes('successful') || entry.message.toLowerCase().includes('complete')) {
                                    color = 'text-green-400 font-bold';
                                    icon = '<span class="text-green-500">✓</span>';
                                } else if (entry.message.includes('Starting') || entry.message.includes('Initiating')) {
                                    color = 'text-blue-300 font-bold';
                                    icon = '<span class="text-blue-500">➜</span>';
                                }

                                const logLine = document.createElement('div');
                                logLine.className = `${color} mb-1 flex gap-3 opacity-0 translate-y-1 transition-all duration-300`;
                                logLine.innerHTML = `
                                    <span class="text-muted/30 text-[10px] w-16 shrink-0 font-mono">${time}</span>
                                    <span class="shrink-0 w-4 text-center">${icon}</span>
                                    <span class="break-words">${entry.message}</span>
                                `;
                                
                                logContent.appendChild(logLine);
                                displayedLogs.add(logKey);
                                
                                // Trigger entry animation
                                setTimeout(() => logLine.classList.remove('opacity-0', 'translate-y-1'), 10);

                                // Only auto-scroll if user isn't reading history
                                if (!isUserScrolling) {
                                    log.scrollTo({ top: log.scrollHeight, behavior: 'smooth' });
                                }
                            }
                        });
                    }
                })
                .catch(() => {});
            }, 1000);

            // Polling status for completion
            let pollAttempts = 0;
            const maxPollAttempts = 240; 
            const pollTimer = setInterval(() => {
                if (++pollAttempts > maxPollAttempts) {
                    clearInterval(pollTimer);
                    clearInterval(logTimer);
                    log.innerHTML += '<div class="text-yellow-400 mt-2">Polling timed out. <a href="/servers/{{ server.id }}" class="underline">Click here</a> to check status.</div>';
                    log.scrollTop = log.scrollHeight;
                    btn.disabled = false;
                    btnText.textContent = '{{ t('servers.retry_deploy')|e('js') }}';
                    btnSpinner.classList.add('hidden');
                    if (btnIcon) btnIcon.classList.remove('hidden');
                    return;
                }
                
                fetch('/servers/{{ server.id }}/status', {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(r => r.json())
                .then(data => {
                    if (data.status && data.status !== 'deploying') {
                        clearInterval(pollTimer);
                        setTimeout(() => clearInterval(logTimer), 2000); 
                        logContent.innerHTML += `<div class="text-green-400 font-bold mt-4 p-3 bg-green-500/5 border border-green-500/20 rounded-lg flex items-center gap-3">
                            <i class="fas fa-check-circle"></i>
                            <span>Deployment successful! Redirecting to server dashboard...</span>
                        </div>`;
                        log.scrollTo({ top: log.scrollHeight, behavior: 'smooth' });
                        setTimeout(() => window.location.href = '/servers/{{ server.id }}', 2000);
                    }
                })
                .catch(() => {});
            }, 2500);
        } else {
            logContent.innerHTML += `<div class="text-red-400 font-bold mt-4 p-3 bg-red-500/5 border border-red-500/20 rounded-lg flex items-center gap-3">
                <i class="fas fa-exclamation-triangle"></i>
                <span>{{ t('message.error')|e('js') }}: ${d.error || '{{ t('message.unknown_error')|e('js') }}'}</span>
            </div>`;
            btn.disabled = false;
            btnText.textContent = '{{ t('servers.retry_deploy')|e('js') }}';
            btnSpinner.classList.add('hidden');
            if(btnIcon) btnIcon.classList.remove('hidden');
        }
    })
    .catch(e => {
        logContent.innerHTML += `<div class="text-red-400 font-bold mt-4 p-3 bg-red-500/5 border border-red-500/20 rounded-lg flex items-center gap-3">
            <i class="fas fa-wifi"></i>
            <span>{{ t('message.connection_error')|e('js') }}: ${e.message}</span>
        </div>`;
        btn.disabled = false;
        btnText.textContent = '{{ t('servers.retry_deploy')|e('js') }}';
        btnSpinner.classList.add('hidden');
        if(btnIcon) btnIcon.classList.remove('hidden');
    });
}
</script>
{% endblock %}
