{% extends "layout.twig" %}
{% block title %}{{ t('servers.add') }}{% endblock %}

{% block breadcrumbs %}
    <li class="flex items-center">
        <a href="/servers" class="hover:text-primary">{{ t('menu.servers') }}</a>
    </li>
    <li class="flex items-center">
        <i class="fas fa-chevron-right mx-2 opacity-30"></i>
        <span>{{ t('servers.add') }}</span>
    </li>
{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto px-4 w-full py-6">
    <div class="mb-6">
        <h1 class="text-2xl font-bold flex items-center">
            <div class="w-10 h-10 rounded-lg bg-surface-hover text-primary flex items-center justify-center mr-3">
                <i class="fas fa-plus-circle"></i>
            </div>
            {{ t('servers.add_new') }}
        </h1>
        <p class="mt-2 ml-13 text-secondary">{{ t('servers.create_description') }}</p>
    </div>

    {% if error %}
    <div role="alert" class="mb-6 bg-red-500/10 border border-red-500/30 text-red-300 px-4 py-3 rounded-lg flex items-center">
        <i class="fas fa-exclamation-circle mr-3 text-red-400"></i>
        {{ error }}
    </div>
    {% endif %}

    <form method="POST" enctype="multipart/form-data" class="panel p-6 space-y-6">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="md:col-span-2">
                <label for="name" class="block text-sm font-medium mb-2">{{ t('servers.name') }}</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-muted">
                        <i class="fas fa-tag"></i>
                    </div>
                     <input id="name" name="name" required class="input-field w-full !pl-11 pr-4 py-2.5" placeholder="{{ t('servers.placeholder_name') }}" autocomplete="off" spellcheck="false">
                </div>
            </div>

            <div>
                <label for="host" class="block text-sm font-medium mb-2">{{ t('servers.host_ip') }}</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-muted">
                        <i class="fas fa-network-wired text-xs"></i>
                    </div>
                     <input id="host" name="host" required class="input-field w-full !pl-11 pr-4 py-2.5" placeholder="{{ t('servers.placeholder_ip') }}" autocomplete="off" spellcheck="false">
                </div>
            </div>
            
            <div>
                <label for="port" class="block text-sm font-medium mb-2">{{ t('servers.ssh_port') }}</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-muted">
                        <i class="fas fa-plug text-xs"></i>
                    </div>
                    <input id="port" name="port" type="number" required class="input-field w-full !pl-11 pr-4 py-2.5" value="22">
                </div>
            </div>

            <div>
                <label for="vpn_port" class="block text-sm font-medium mb-2">{{ t('servers.vpn_port_udp') }}</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-muted">
                        <i class="fas fa-door-open text-xs"></i>
                    </div>
                    <input id="vpn_port" name="vpn_port" type="number" required class="input-field w-full !pl-11 pr-4 py-2.5" value="{{ random_port }}">
                </div>
            </div>

            <div>
                <label for="username" class="block text-sm font-medium mb-2">{{ t('servers.ssh_username') }}</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-muted">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <input id="username" name="username" value="root" class="input-field w-full !pl-11 pr-4 py-2.5 font-mono" autocomplete="username" spellcheck="false">
                </div>
            </div>

            <div class="md:col-span-2">
                <label for="password" class="block text-sm font-medium mb-2">{{ t('servers.ssh_password') }}</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-muted">
                        <i class="fas fa-key"></i>
                    </div>
                    <input id="password" name="password" type="password" required class="input-field w-full !pl-11 pr-4 py-2.5 font-mono" autocomplete="new-password">
                </div>
            </div>
        </div>

        <div class="border-t border-default pt-6">
            <h3 class="text-base font-semibold mb-4 flex items-center">
                <i class="fas fa-shield-alt mr-2 text-muted"></i>
                {{ t('servers.awg_settings') }}
            </h3>
            
            <div class="p-4 bg-panel/30 rounded-lg border border-default">
                <label class="block text-sm font-medium mb-2">{{ t('servers.mimicry') }}</label>
                <div class="relative mb-3">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-muted">
                        <i class="fas fa-mask"></i>
                    </div>
                    <select name="mimicry_type" class="input-field w-full !pl-11 pr-10 py-2.5 appearance-none">
                        <option value="quic">{{ t('servers.mimicry_quic') }}</option>
                        <option value="dns">{{ t('servers.mimicry_dns') }}</option>
                        <option value="stun">{{ t('servers.mimicry_stun') }}</option>
                        <option value="sip">{{ t('servers.mimicry_sip') }}</option>
                        <option value="none">{{ t('servers.mimicry_none') }}</option>
                    </select>
                    <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none text-muted">
                        <i class="fas fa-chevron-down text-xs"></i>
                    </div>
                </div>
                <p class="text-xs text-muted">{{ t('servers.mimicry_hint') }}</p>
            </div>
        </div>
        
        
        <div class="pt-4">
            <button type="submit" class="btn-primary w-full py-3 text-sm font-semibold">
                <i class="fas fa-save mr-2"></i>{{ t('servers.create') }}
            </button>
        </div>
    </form>
</div>

<script>
function toggleImportFields() {
    const checkbox = document.getElementById('enableImport');
    const fields = document.getElementById('importFields');
    fields.style.display = checkbox.checked ? 'block' : 'none';
}
</script>
{% endblock %}
