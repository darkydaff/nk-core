{% extends "layout.twig" %}

{% block title %}{{ t('auth.login') }} - {{ app_name }}{% endblock %}

{% block content %}
<div class="fixed inset-0 flex items-center justify-center bg-surface-base p-4 z-[1000]">
    <div class="max-w-md w-full">
        <!-- Logo & Header -->
        <div class="text-center mb-10">
            <div class="w-20 h-20 bg-primary/10 rounded-3xl flex items-center justify-center mx-auto mb-6 border border-primary/20 shadow-xl shadow-primary/5">
                <img src="/img/logo.svg" alt="Logo" class="w-12 h-12">
            </div>
            <h2 class="text-4xl font-extrabold tracking-tight leading-none">{{ t('auth.welcome_back', [], 'NK-CORE') }}</h2>
            <p class="mt-4 text-secondary text-sm font-medium opacity-70">{{ t('auth.signin_hint', [], 'Secure Control Plane Access') }}</p>
        </div>

        <!-- Login Card -->
        <div class="panel p-8 md:p-10 !bg-surface-panel shadow-2xl border-primary/10 relative overflow-hidden">
            <!-- Subtle accent glow -->
            <div class="absolute -top-24 -right-24 w-48 h-48 bg-primary/10 blur-[80px] rounded-full"></div>
            
            {% if error %}
            <div class="mb-8 bg-red-500/10 border border-red-500/20 text-red-400 px-5 py-4 rounded-2xl flex items-center text-sm font-bold animate-in fade-in slide-in-from-top-2">
                <i class="fas fa-exclamation-circle mr-3 text-lg"></i>
                <span>{{ error }}</span>
            </div>
            {% endif %}

            <form class="space-y-6 relative" method="POST" action="/login">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                
                <div class="space-y-2.5">
                    <label for="email" class="block text-[11px] font-bold text-muted uppercase tracking-[0.15em] ml-1">{{ t('common.username', [], 'Username') }}</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 w-12 flex items-center justify-center text-muted pointer-events-none transition-colors group-focus-within:text-primary">
                            <i class="fas fa-user-shield text-sm"></i>
                        </div>
                        <input id="email" name="email" type="text" required
                               class="input-field input-with-icon !py-4 text-sm font-medium tracking-wide focus:ring-2 focus:ring-primary/20"
                               placeholder="admin" autocomplete="username">
                    </div>
                </div>

                <div class="space-y-2.5">
                    <div class="flex items-center justify-between">
                        <label for="password" class="block text-[11px] font-bold text-muted uppercase tracking-[0.15em] ml-1">{{ t('auth.password', [], 'Password') }}</label>
                    </div>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 w-12 flex items-center justify-center text-muted pointer-events-none transition-colors group-focus-within:text-primary">
                            <i class="fas fa-key text-sm"></i>
                        </div>
                        <input id="password" name="password" type="password" required
                               class="input-field input-with-icon !py-4 text-sm font-medium tracking-wide focus:ring-2 focus:ring-primary/20"
                               placeholder="••••••••" autocomplete="current-password">
                    </div>
                </div>

                <div class="pt-4">
                    <button type="submit" class="btn-primary w-full !py-4 text-sm font-bold shadow-xl shadow-primary/20 hover:shadow-primary/40 active:scale-[0.98] transition-all">
                        <span>{{ t('auth.sign_in', [], 'Authorize Access') }}</span>
                        <i class="fas fa-arrow-right ml-3 text-xs opacity-60"></i>
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>
{% endblock %}
