{% extends "layout.twig" %}
{% import "macros/ui.twig" as ui %}

{% block title %}
    {{ t('menu.dashboard') }} - {{ app_name }}
{% endblock %}

{% block breadcrumbs %}
    <li class="flex items-center">
        <span>{{ t('menu.dashboard') }}</span>
    </li>
{% endblock %}

{% block content %}
    <div class="space-y-6">
        <!-- Dashboard Header -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8">
            <div>
                <h1 class="text-3xl font-bold tracking-tight">NK-CORE</h1>
                <p class="text-secondary mt-1 text-sm">{{ t('dashboard.overview_subtitle', [], 'Global fleet and client overview') }}</p>
            </div>
            <div class="flex items-center gap-3">
                <div class="bg-surface-base px-4 py-2.5 rounded-xl border border-default flex items-center gap-3">
                    <span class="w-2 h-2 rounded-full bg-status-active animate-pulse"></span>
                    <span class="text-xs font-bold uppercase tracking-widest opacity-60">{{ t('status.live_monitoring', [], 'Live Monitoring') }}</span>
                </div>
            </div>
        </div>

        <!-- Summary Stats -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Active Nodes -->
            <div class="panel p-6 flex items-center gap-5">
                <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center text-primary border border-primary/20">
                    <i class="fas fa-globe-americas text-xl"></i>
                </div>
                <div>
                    <div class="flex items-baseline gap-2">
                        <span class="text-2xl font-bold">{{ servers|length }}</span>
                    </div>
                    <p class="text-xs font-bold text-muted uppercase tracking-widest mt-1">{{ t('dashboard.active_nodes', [], 'Nodes across regions') }}</p>
                </div>
            </div>

            <!-- Total Clients -->
            <div class="panel p-6 flex items-center gap-5">
                <div class="w-12 h-12 rounded-2xl bg-surface-hover flex items-center justify-center text-muted border border-default">
                    <i class="fas fa-users text-xl"></i>
                </div>
                <div>
                    <div class="flex items-center gap-3">
                        <span class="text-3xl font-bold tracking-tighter" id="summary-total-clients">{{ summary.total_clients }}</span>
                        {{ ui.status_badge('online', summary.active_clients ~ ' ' ~ t('status.online'), 'summary-active-clients') }}
                    </div>
                    <p class="text-xs font-bold text-muted uppercase tracking-widest mt-1">{{ t('dashboard.provisioned_access', [], 'Access Keys') }}</p>
                </div>
            </div>

            <!-- Downloaded -->
            <div class="panel p-6 flex items-center gap-5">
                <div class="w-12 h-12 rounded-2xl bg-status-active/10 flex items-center justify-center text-status-active border border-status-active/20">
                    <i class="fas fa-arrow-down text-xl"></i>
                </div>
                <div>
                    <span class="text-2xl font-bold" id="summary-total-download">{{ (summary.total_download / 1024 / 1024 / 1024)|number_format(2) }}&nbsp;GB</span>
                    <p class="text-xs font-bold text-muted uppercase tracking-widest mt-1">{{ t('dashboard.total_ingress', [], 'Total Inbound') }}</p>
                </div>
            </div>

            <!-- Uploaded -->
            <div class="panel p-6 flex items-center gap-5">
                <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center text-primary border border-primary/20">
                    <i class="fas fa-arrow-up text-xl"></i>
                </div>
                <div>
                    <span class="text-2xl font-bold" id="summary-total-upload">{{ (summary.total_upload / 1024 / 1024 / 1024)|number_format(2) }}&nbsp;GB</span>
                    <p class="text-xs font-bold text-muted uppercase tracking-widest mt-1">{{ t('dashboard.total_egress', [], 'Total Outbound') }}</p>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Traffic Analytics Chart -->
            <div class="lg:col-span-2 panel p-6 flex flex-col">
                <div class="flex items-center justify-between mb-8">
                    <h2 class="text-xs font-bold text-primary uppercase tracking-widest opacity-70">{{ t('dashboard.traffic_analytics', [], 'Traffic Analytics') }}</h2>
                    <div class="flex items-center gap-4">
                        <span class="flex items-center gap-1.5 text-xs font-bold text-muted uppercase tracking-wider"><span class="w-2 h-2 rounded-full bg-status-active"></span>{{ t('common.download', [], 'Download') }}</span>
                        <span class="flex items-center gap-1.5 text-xs font-bold text-muted uppercase tracking-wider"><span class="w-2 h-2 rounded-full bg-primary"></span>{{ t('common.upload', [], 'Upload') }}</span>
                    </div>
                </div>
                <div class="flex-grow min-h-[300px] relative">
                    <canvas id="trafficChart"></canvas>
                </div>
            </div>

            <!-- Fleet Health -->
            <div class="panel overflow-hidden">
                <div class="px-5 py-4 border-b border-default bg-surface-base/30">
                    <h2 class="text-xs font-bold uppercase tracking-widest opacity-70">{{ t('dashboard.fleet_health', [], 'Fleet Health') }}</h2>
                </div>
                <div class="p-4 pr-2 grid grid-cols-1 xl:grid-cols-2 gap-3 max-h-[380px] overflow-y-auto custom-scrollbar">
                    {% for server in servers %}
                        <a href="/servers/{{ server.id }}" class="flex items-center p-3 rounded-xl border border-default hover:border-primary transition-all group" data-server-ip="{{ server.host }}" data-server-id="{{ server.id }}">
                            <div class="w-8 h-8 rounded-lg bg-base border border-default flex items-center justify-center mr-3 group-hover:bg-primary/5 overflow-hidden flex-shrink-0 leading-none">
                                {% if server.country_code %}
                                    <span class="text-2xl leading-none flex items-center justify-center">{{ getFlag(server.country_code)|raw }}</span>
                                {% else %}
                                    <i class="fas fa-server text-[10px] text-muted group-hover:text-primary"></i>
                                {% endif %}
                            </div>
                            <div class="flex-grow min-w-0">
                                <div class="flex items-center justify-between mb-1.5 gap-2">
                                    <div class="flex items-center gap-1.5 min-w-0">
                                        <div class="server-status-dot w-2 h-2 rounded-full flex-shrink-0 {% if server.status == 'active' or server.status == 'online' %}bg-emerald-500 animate-pulse{% else %}bg-red-500{% endif %}"></div>
                                        <span class="text-xs font-bold text-primary truncate" title="{{ server.name }}">{{ server.name }}</span>
                                    </div>
                                    <span class="text-[10px] font-mono text-muted server-bw-val flex-shrink-0">- Mbps</span>
                                </div>
                                <div class="grid grid-cols-2 gap-2.5">
                                    <div class="flex flex-col gap-1">
                                        <div class="flex justify-between text-[10px] font-bold uppercase opacity-50 tracking-tight">
                                            <span>CPU</span>
                                            <span class="server-cpu-val">-</span>
                                        </div>
                                        <div class="h-1 bg-base rounded-full overflow-hidden">
                                            <div class="h-full bg-amber-500 server-cpu-bar" style="width: 0%"></div>
                                        </div>
                                    </div>
                                    <div class="flex flex-col gap-1">
                                        <div class="flex justify-between text-[10px] font-bold uppercase opacity-50 tracking-tight">
                                            <span>RAM</span>
                                            <span class="server-ram-val">-</span>
                                        </div>
                                        <div class="h-1 bg-base rounded-full overflow-hidden">
                                            <div class="h-full bg-cyan-500 server-ram-bar" style="width: 0%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- Fleet Search Section -->
        <div class="panel overflow-hidden">
            <div class="px-5 py-4 border-b border-default bg-panel/30 flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                    <h2 class="text-sm font-semibold uppercase tracking-widest opacity-70">{{ t('dashboard.fleet_search', [], 'Fleet Search') }}</h2>
                    
                    <!-- Batch Action Bar (Integrated) -->
                    <div id="batchActionBar" class="hidden items-center gap-2 px-3 py-1 bg-primary/10 border border-primary/20 rounded-full animate-in fade-in slide-in-from-left-2">
                        <span id="selectedCountText" class="text-[10px] font-bold text-primary uppercase tracking-widest mr-2">0 SELECTED</span>
                        <div class="flex items-center gap-1 border-l border-primary/20 pl-2">
                            <button onclick="NK_Dashboard.handleBatchAction('revoke')" class="text-[10px] font-bold text-amber-500 hover:text-amber-400 uppercase tracking-tight px-2 py-1 transition-colors">{{ t('common.revoke', [], 'Revoke') }}</button>
                            <button onclick="NK_Dashboard.handleBatchAction('restore')" class="text-[10px] font-bold text-green-500 hover:text-green-400 uppercase tracking-tight px-2 py-1 transition-colors">{{ t('common.restore', [], 'Restore') }}</button>
                            <button onclick="NK_Dashboard.handleBatchAction('delete')" class="text-[10px] font-bold text-red-500 hover:text-red-400 uppercase tracking-tight px-2 py-1 transition-colors">{{ t('common.delete', [], 'Delete') }}</button>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    <div class="relative w-full md:w-48 lg:w-64">
                        <input type="text" id="fleetSearch" class="input-field input-with-icon !py-2 text-sm" placeholder="{{ t('dashboard.search_placeholder', [], 'Search servers by name or IP…') }}">
                        <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-muted text-xs"></i>
                    </div>
                    <select id="statusFilter" class="input-field !w-auto !py-2 px-3 text-[11px] font-bold">
                        <option value="all">{{ t('common.status_all', [], 'All Status') }}</option>
                        <option value="online">{{ t('common.status_online', [], 'Online') }}</option>
                        <option value="offline">{{ t('common.status_offline', [], 'Offline') }}</option>
                        <option value="revoked">{{ t('status.revoked', [], 'Revoked') }}</option>
                    </select>
                    <select id="trafficFilter" class="input-field !w-auto !py-2 px-3 text-[11px] font-bold">
                        <option value="all">{{ t('common.traffic_all', [], 'All Traffic') }}</option>
                        <option value="medium">{{ t('common.traffic_medium', [], '> 100MB') }}</option>
                        <option value="high">{{ t('common.traffic_high', [], '> 1GB') }}</option>
                    </select>
                    <select id="sortFilter" class="input-field !w-auto !py-2 px-3 text-[11px] font-bold">
                        <option value="recent">{{ t('common.sort_newest', [], 'Newest First') }}</option>
                        <option value="traffic">{{ t('common.sort_traffic', [], 'Most Traffic') }}</option>
                        <option value="handshake">{{ t('common.sort_handshake', [], 'Last Activity') }}</option>
                        <option value="oldest">{{ t('common.sort_oldest', [], 'Oldest First') }}</option>
                    </select>
                </div>
            </div>

            <div id="searchResults" class="min-h-[300px]">
                <!-- Results injected here -->
                {{ ui.skeleton_loader(5, 'h-16') }}
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
<script src="/js/modules/monitoring.js"></script>
<script src="/js/modules/dashboard.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        NK_Dashboard.init({
            labels: {
                client: "{{ t('clients.list', [], 'Client') }}",
                status: "{{ t('common.status', [], 'Status') }}",
                traffic: "{{ t('common.traffic', [], 'Traffic') }}",
                actions: "{{ t('common.actions') }}",
                download: "{{ t('common.download') }}",
                upload: "{{ t('common.upload') }}",
                online: "{{ t('status.online') }}",
                offline: "{{ t('status.offline') }}",
                revoked: "{{ t('status.revoked') }}",
                never: "{{ t('status.never') }}",
                confirmDelete: "{{ t('common.confirm_delete') }}",
                sync: "{{ t('common.sync') }}",
                restore: "{{ t('common.restore') }}",
                revoke: "{{ t('common.revoke') }}",
                delete: "{{ t('common.delete') }}",
                edit: "{{ t('common.edit') }}",
                noMatches: "{{ t('common.no_matches') }}",
                provisioning: "{{ t('status.provisioning') }}",
                deleting: "{{ t('status.deleting') }}",
                verifying: "{{ t('status.verifying') }}",
                error: "{{ t('status.error') }}",
                lastSeenLabel: "{{ t('clients.last_seen') }}",
                selected: "{{ t('common.selected_count', [], '%s items selected') }}"
            }
        });

        // Legacy Beszel polling for metrics (CPU/RAM)
        // We'll keep this until we have a batch metrics API
        function updateMetrics() {
            if (document.visibilityState !== 'visible') return;
            document.querySelectorAll('[data-server-ip]').forEach(card => {
                const ip = card.dataset.serverIp;
                NK_Monitoring.fetchServerDetails(ip).then(res => {
                    if (res.success && res.data) {
                        const info = res.data.info || {};
                        card.querySelector('.server-cpu-val').innerText = Math.round(info.cpu || 0) + '%';
                        card.querySelector('.server-cpu-bar').style.width = (info.cpu || 0) + '%';
                        card.querySelector('.server-ram-val').innerText = Math.round(info.mp || 0) + '%';
                        card.querySelector('.server-ram-bar').style.width = (info.mp || 0) + '%';
                        card.querySelector('.server-bw-val').innerText = NK_Monitoring.formatBandwidth(info.bb || 0);
                    }
                });
            });
        }
        updateMetrics();
        let metricsInterval = NK.registerInterval(updateMetrics, 15000);

        document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'visible') {
                updateMetrics();
                if (!metricsInterval) {
                    metricsInterval = NK.registerInterval(updateMetrics, 15000);
                }
            } else {
                if (metricsInterval) {
                    clearInterval(metricsInterval);
                    metricsInterval = null;
                }
            }
        });
    });
</script>
{% endblock %}
