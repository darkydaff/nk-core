{% extends "layout.twig" %}

{% block title %}
	{{ t('proxies.title') }} - {{ app_name }}
{% endblock %}

{% block breadcrumbs %}
    <li class="flex items-center">
        <span>{{ t('proxies.title') }}</span>
    </li>
{% endblock %}

{% block content %}
	<div class="w-full space-y-8">
		<!-- Page Header & Search Bar -->
		<div class="flex flex-col gap-6">
			<div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
				<div>
					<h1 class="text-3xl font-bold tracking-tight">{{ t('proxies.title') }}</h1>
					<p class="text-secondary mt-1 text-sm flex items-center gap-2">
						<span class="w-1.5 h-1.5 rounded-full bg-status-active animate-pulse"></span>
						{{ t('proxies.description')|default('Manage high-performance HTTP/SOCKS5 proxies') }}
					</p>
				</div>
				<button onclick="openCreateModal()" class="btn-primary px-6 py-3.5 flex items-center gap-2 whitespace-nowrap shadow-xl shadow-primary/20 hover:scale-[1.02] transition-all">
					<i class="fas fa-plus"></i>
					{{ t('proxies.create')|default('Create Proxy') }}
				</button>
			</div>

			<div class="panel p-4 flex flex-wrap items-center justify-between gap-4">
				<div class="flex flex-wrap items-center gap-3">
					<div class="relative w-full md:w-80 group">
						<i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 dark:text-muted group-focus-within:text-primary transition-colors text-xs"></i>
						<input type="text" id="proxySearch" onkeyup="filterProxies()" placeholder="{{ t('common.search')|default('Search by username, server or IP…') }}" 
							   class="input-field input-with-icon !py-2.5 text-sm bg-slate-50 dark:bg-panel/60 border-slate-200/80 dark:border-default focus:ring-4 focus:ring-primary/10 transition-all">
					</div>
					<select id="typeFilter" onchange="filterProxies()" class="input-field !w-auto !py-2.5 px-4 text-[11px] font-bold uppercase tracking-wider bg-slate-50 dark:bg-panel/60 border-slate-200/80 dark:border-default">
						<option value="all">All Types</option>
						<option value="http">HTTP</option>
						<option value="socks5">SOCKS5</option>
					</select>
					<select id="statusFilter" onchange="filterProxies()" class="input-field !w-auto !py-2.5 px-4 text-[11px] font-bold uppercase tracking-wider bg-slate-50 dark:bg-panel/60 border-slate-200/80 dark:border-default">
						<option value="all">All Status</option>
						<option value="active">Active</option>
						<option value="paused">Paused</option>
					</select>
				</div>
				<button onclick="globalSyncAll(this)" class="px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-surface-hover hover:bg-slate-100 dark:hover:bg-surface-hover/85 text-slate-600 dark:text-slate-300 hover:text-primary transition-all border border-slate-200 dark:border-default flex items-center gap-2 text-xs font-bold uppercase tracking-widest">
					<i class="fas fa-sync-alt"></i>
					{{ t('common.sync_all')|default('Sync All') }}
				</button>
			</div>
		</div>

		<!-- Proxy Grid -->
		<div id="proxyGrid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
			{% for proxy in proxies %}
				{% set proto = proxy.type == 'socks5' ? 'socks5' : 'http' %}
				{% set full_url = proto ~ '://' ~ proxy.username|url_encode ~ ':' ~ proxy.password|url_encode ~ '@' ~ proxy.server_host ~ ':' ~ proxy.port %}
				
				<div class="panel p-0 flex flex-col group/card proxy-row hover:shadow-2xl hover:shadow-primary/5 transition-all duration-500 border-l-4 {% if proxy.status == 'active' %}border-l-primary{% elseif proxy.status == 'paused' %}border-l-orange-500{% else %}border-l-red-500{% endif %}" 
					 data-search="{{ proxy.username }} {{ proxy.server_name }} {{ proxy.server_host }} {{ proxy.type }}"
					 data-type="{{ proxy.type }}"
					 data-status="{{ proxy.status }}">
					
					<!-- Header Section -->
					<div class="p-5 flex items-start justify-between gap-3 bg-slate-50/50 dark:bg-panel/20 min-w-0 border-b border-slate-100 dark:border-default/50">
						<div class="flex items-center gap-3 min-w-0 flex-1">
							<div class="w-11 h-11 min-w-[2.75rem] rounded-2xl bg-slate-100 dark:bg-surface-hover flex items-center justify-center text-primary border border-slate-200 dark:border-default shadow-inner group-hover/card:scale-105 transition-transform duration-500 flex-shrink-0">
								<i class="fas {{ proxy.type == 'socks5' ? 'fa-socks' : 'fa-shield-halved' }} text-lg"></i>
							</div>
							<div class="min-w-0 flex-1">
								<div class="flex items-center gap-2 flex-wrap">
									<h3 class="font-bold text-base tracking-tight truncate text-slate-800 dark:text-slate-200" style="max-width: 16ch" title="{{ proxy.username }}">{{ proxy.username }}</h3>
									<span class="text-[9px] font-extrabold uppercase tracking-widest px-2 py-0.5 rounded-md bg-slate-100 dark:bg-surface-border text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-white/5 flex-shrink-0">
										{{ proxy.type|upper }}
									</span>
								</div>
								<div class="flex items-center gap-2 mt-1.5">
									{{ ui.status_badge(proxy.status, t('proxies.' ~ proxy.status)) }}
								</div>
							</div>
						</div>
						<div class="flex items-center gap-1.5 flex-shrink-0 flex-wrap justify-end">
							<button onclick="checkProxy({{ proxy.id }}, this)" class="w-9 h-9 min-w-[2.25rem] rounded-xl bg-sky-500/5 text-sky-600 dark:text-sky-400 hover:bg-sky-500 hover:text-white transition-all flex items-center justify-center border border-sky-500/10" title="{{ t('proxies.test_connection')|default('Test Connection') }}">
								<i class="fas fa-plug-circle-check text-sm"></i>
							</button>
							{% if proxy.status == 'active' %}
								<button onclick="handleAjaxAction('/proxies/{{ proxy.id }}/pause')" class="w-9 h-9 min-w-[2.25rem] rounded-xl bg-amber-500/5 text-amber-600 dark:text-amber-400 hover:bg-amber-500 hover:text-white transition-all flex items-center justify-center border border-amber-500/10" title="{{ t('common.revoke')|default('Revoke') }}">
									<i class="fas fa-user-slash text-sm"></i>
								</button>
							{% else %}
								<button onclick="handleAjaxAction('/proxies/{{ proxy.id }}/resume')" class="w-9 h-9 min-w-[2.25rem] rounded-xl bg-emerald-500/5 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-500 hover:text-white transition-all flex items-center justify-center border border-emerald-500/10" title="{{ t('common.restore')|default('Restore') }}">
									<i class="fas fa-user-check text-sm"></i>
								</button>
							{% endif %}
							<button onclick="handleAjaxAction('/proxies/{{ proxy.id }}/delete', {}, '{{ t('proxies.delete_confirm') }}')" class="w-9 h-9 min-w-[2.25rem] rounded-xl bg-rose-500/5 text-rose-600 dark:text-rose-400 hover:bg-rose-500 hover:text-white transition-all flex items-center justify-center border border-rose-500/10" title="{{ t('common.delete')|default('Delete') }}">
								<i class="fas fa-trash-alt text-sm"></i>
							</button>
						</div>
					</div>

					<!-- Copy Zone (High Information Density) -->
					<div class="px-5 py-5 space-y-4">
						<div class="space-y-3">
							<!-- Row 1: Credentials -->
							<div class="grid grid-cols-2 gap-3">
								<div class="relative group/field">
									<label class="text-[10px] dark:text-slate-400 text-slate-500 uppercase font-bold tracking-wider ml-1 mb-1 block">{{ t('proxies.username') }}</label>
									<div class="flex items-center bg-slate-50/80 dark:bg-surface-base/50 rounded-xl border border-slate-200 dark:border-default p-0.5 group-hover/field:border-primary/20 transition-colors min-w-0">
										<span class="px-3 py-1.5 text-xs font-mono truncate flex-grow leading-none min-w-0 text-slate-700 dark:text-slate-300">{{ proxy.username }}</span>
										<button onclick="copyToClipboard('{{ proxy.username }}', this)" class="p-1.5 text-slate-400 hover:text-primary transition-colors flex-shrink-0" aria-label="{{ t('common.copy')|default('Copy') }}">
											<i class="fas fa-copy text-[10px]"></i>
										</button>
									</div>
								</div>
								<div class="relative group/field">
									<label class="text-[10px] dark:text-slate-400 text-slate-500 uppercase font-bold tracking-wider ml-1 mb-1 block">{{ t('proxies.password') }}</label>
									<div class="flex items-center bg-slate-50/80 dark:bg-surface-base/50 rounded-xl border border-slate-200 dark:border-default p-0.5 group-hover/field:border-primary/20 transition-colors min-w-0">
										<span class="px-3 py-1.5 text-xs font-mono truncate flex-grow leading-none min-w-0 text-slate-700 dark:text-slate-300">{{ proxy.password }}</span>
										<button onclick="copyToClipboard('{{ proxy.password }}', this)" class="p-1.5 text-slate-400 hover:text-primary transition-colors flex-shrink-0" aria-label="{{ t('common.copy')|default('Copy') }}">
											<i class="fas fa-copy text-[10px]"></i>
										</button>
									</div>
								</div>
							</div>

							<!-- Row 2: Connection Details -->
							<div class="grid grid-cols-2 gap-3">
								<div class="relative group/field">
									<label class="text-[10px] dark:text-slate-400 text-slate-500 uppercase font-bold tracking-wider ml-1 mb-1 block">{{ t('proxies.host')|default('Server IP') }}</label>
									<div class="flex items-center bg-slate-50/80 dark:bg-surface-base/50 rounded-xl border border-slate-200 dark:border-default p-0.5 group-hover/field:border-primary/20 transition-colors min-w-0">
										<span class="px-3 py-1.5 text-xs font-mono truncate flex-grow leading-none min-w-0 text-slate-700 dark:text-slate-300">{{ proxy.server_host }}</span>
										<button onclick="copyToClipboard('{{ proxy.server_host }}', this)" class="p-1.5 text-slate-400 hover:text-primary transition-colors flex-shrink-0">
											<i class="fas fa-copy text-[10px]"></i>
										</button>
									</div>
								</div>
								<div class="relative group/field">
									<label class="text-[10px] dark:text-slate-400 text-slate-500 uppercase font-bold tracking-wider ml-1 mb-1 block">{{ t('proxies.port')|default('Port') }}</label>
									<div class="flex items-center bg-slate-50/80 dark:bg-surface-base/50 rounded-xl border border-slate-200 dark:border-default p-0.5 group-hover/field:border-primary/20 transition-colors min-w-0">
										<span class="px-3 py-1.5 text-xs font-mono truncate flex-grow leading-none min-w-0 text-slate-700 dark:text-slate-300">{{ proxy.port }}</span>
										<button onclick="copyToClipboard('{{ proxy.port }}', this)" class="p-1.5 text-slate-400 hover:text-primary transition-colors flex-shrink-0">
											<i class="fas fa-copy text-[10px]"></i>
										</button>
									</div>
								</div>
							</div>

							<div class="relative group/field">
								<label class="text-[8px] dark:text-slate-400 text-slate-500 uppercase font-bold tracking-wider ml-1 mb-1 block">Full Proxy Configuration</label>
								<div class="flex items-center bg-slate-100 dark:bg-surface-base rounded-2xl border border-slate-200 dark:border-default p-1 group-hover/field:border-primary/30 transition-all shadow-inner min-w-0">
									<div class="px-4 py-2.5 text-[11px] text-slate-700 dark:text-cyan-400 font-mono truncate select-all flex-grow leading-none min-w-0">
										{{ full_url }}
									</div>
									<button onclick="copyToClipboard('{{ full_url }}', this)" 
											class="w-10 h-10 min-w-[2.5rem] bg-slate-200 dark:bg-surface-hover hover:bg-primary hover:text-white text-slate-500 dark:text-muted transition-all rounded-xl flex items-center justify-center flex-shrink-0"
											title="{{ t('common.copy') }}">
										<i class="fas fa-copy"></i>
									</button>
								</div>
							</div>
						</div>

						<!-- Stats & Context Footer -->
						<div class="grid grid-cols-2 gap-4 pt-4 border-t border-slate-100 dark:border-white/5">
							<div class="flex flex-col gap-1.5">
								<span class="text-[8px] dark:text-slate-400 text-slate-500 uppercase font-bold tracking-wider">{{ t('proxies.server') }}</span>
								<div class="flex items-center gap-2">
									<div class="w-6 h-6 rounded-md bg-slate-100 dark:bg-surface-hover flex items-center justify-center text-xl text-primary border border-slate-200 dark:border-white/5 overflow-hidden">
										{% if proxy.server_country_code %}
											{{ getFlag(proxy.server_country_code)|raw }}
										{% else %}
											<i class="fas fa-server opacity-50 text-[10px]"></i>
										{% endif %}
									</div>
									<span class="text-xs font-bold truncate text-slate-700 dark:text-slate-300">{{ proxy.server_name }}</span>
								</div>
								<code class="text-[9px] text-slate-500 dark:text-primary font-mono ml-8">{{ proxy.server_host }}:{{ proxy.port }}</code>
							</div>
							<div class="flex flex-col gap-1.5 items-end">
								<span class="text-[8px] dark:text-slate-400 text-slate-500 uppercase font-bold tracking-wider">{{ t('proxies.traffic') }}</span>
								<div class="flex flex-col items-end">
									<span class="text-sm font-bold tracking-tight text-slate-800 dark:text-slate-200">{{ ( (proxy.bytes_sent + proxy.bytes_received) / 1024 / 1024 )|number_format(1) }}&nbsp;MB</span>
									<div class="flex items-center gap-3 mt-1">
										<span class="text-[9px] text-sky-600 dark:text-primary flex items-center gap-1 font-bold">
											<i class="fas fa-arrow-up text-[7px]"></i>{{ (proxy.bytes_sent / 1024 / 1024)|number_format(1) }}
										</span>
										<span class="text-[9px] text-emerald-600 dark:text-emerald-400 flex items-center gap-1 font-bold">
											<i class="fas fa-arrow-down text-[7px]"></i>{{ (proxy.bytes_received / 1024 / 1024)|number_format(1) }}
										</span>
									</div>
								</div>
								{% if proxy.last_sync_at %}
									<span class="text-[8px] text-muted opacity-30 italic mt-1">
										{{ t('common.last_checked')|default('Checked') }}: {{ proxy.last_sync_at|date('H:i') }}
									</span>
								{% endif %}
							</div>
						</div>
					</div>
				</div>
			{% else %}
				<div class="col-span-full py-20 text-center bg-panel border border-default rounded-3xl">
					<div class="flex flex-col items-center">
						<div class="w-20 h-20 rounded-full bg-surface-hover flex items-center justify-center text-muted mb-6 opacity-20">
							<i class="fas fa-shield-halved text-5xl"></i>
						</div>
						<h3 class="text-xl font-bold">{{ t('proxies.no_proxies') }}</h3>
						<p class="text-secondary mt-2">{{ t('proxies.no_proxies_hint')|default('You haven\'t created any proxies yet.') }}</p>
						<button onclick="openCreateModal()" class="mt-8 btn-primary px-8 py-3">
							{{ t('proxies.create') }}
						</button>
					</div>
				</div>
			{% endfor %}

			<!-- No Search Results -->
			<div id="noResults" class="hidden col-span-full py-20 text-center bg-panel border border-dashed border-default rounded-3xl animate-in">
				<div class="flex flex-col items-center">
					<i class="fas fa-search text-muted text-5xl mb-6 opacity-20"></i>
					<h3 class="text-xl font-bold">{{ t('common.no_results')|default('No proxies found') }}</h3>
					<p class="text-secondary mt-2">{{ t('common.try_another_query')|default('Try searching for something else.') }}</p>
					<button onclick="document.getElementById('proxySearch').value=''; filterProxies();" class="mt-6 text-primary font-bold hover:underline">
						{{ t('common.clear_search')|default('Clear Search') }}
					</button>
				</div>
			</div>
		</div>
	</div>

	<!-- Create Proxy Modal -->
	<div id="createModal" class="modal fixed inset-0 z-50 flex items-center justify-center hidden p-4" role="dialog" aria-modal="true" aria-labelledby="createModalTitle">
		<div class="modal-overlay absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
		<div class="modal-container bg-panel w-full max-w-lg mx-auto rounded-3xl shadow-2xl z-50 overflow-hidden border border-slate-200 dark:border-white/5 animate-in">
			<div class="px-8 py-6 border-b border-default flex justify-between items-center bg-slate-50/50 dark:bg-panel/50">
				<div>
					<h3 id="createModalTitle" class="text-2xl font-bold tracking-tight">{{ t('proxies.create') }}</h3>
					<p class="text-xs dark:text-slate-400 text-slate-500 mt-1 uppercase tracking-wider font-bold">Setup new instance</p>
				</div>
				<button onclick="closeCreateModal()" class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-surface-hover text-slate-500 dark:text-muted hover:text-primary transition-all flex items-center justify-center" aria-label="{{ t("common.close")|default("Close") }}">
					<i class="fas fa-times"></i>
				</button>
			</div>
			<form onsubmit="handleAjaxForm(event, '/proxies/create')" class="p-8 space-y-6">
				<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
				
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<div>
						<label class="block text-[10px] font-bold dark:text-slate-400 text-slate-500 uppercase tracking-wider mb-2 ml-1">{{ t('proxies.type')|default('Proxy Type') }}</label>
						<div class="relative">
							<i class="fas fa-layer-group absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 dark:text-muted text-xs"></i>
							<select name="type" required class="input-field input-with-icon bg-slate-50 dark:bg-panel/60 border-slate-200 dark:border-default">
								<option value="http">HTTP</option>
								<option value="socks5">SOCKS5</option>
							</select>
						</div>
					</div>

					<div>
						<label class="block text-[10px] font-bold dark:text-slate-400 text-slate-500 uppercase tracking-wider mb-2 ml-1">{{ t('proxies.server') }}</label>
						<div class="relative">
							<i class="fas fa-server absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 dark:text-muted text-xs"></i>
							<select name="server_id" required class="input-field input-with-icon bg-slate-50 dark:bg-panel/60 border-slate-200 dark:border-default">
								<option value="">{{ t('form.select_server') }}</option>
								{% for server in servers %}
									<option value="{{ server.id }}">{{ server.name }}</option>
								{% endfor %}
							</select>
						</div>
					</div>
				</div>

				<div class="space-y-6">
					<div>
						<label class="block text-[10px] font-bold dark:text-slate-400 text-slate-500 uppercase tracking-wider mb-2 ml-1">{{ t('proxies.username') }}</label>
						<div class="flex gap-3">
							<div class="relative flex-grow">
								<i class="fas fa-user absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 dark:text-muted text-xs"></i>
								<input type="text" name="username" id="proxy_username" class="input-field input-with-icon bg-slate-50 dark:bg-panel border-slate-200 dark:border-default" placeholder="{{ t('proxies.leave_blank_auto') }}">
							</div>
							<button type="button" onclick="generateUsername()" class="w-12 h-12 bg-slate-100 dark:bg-surface-hover text-slate-500 dark:text-muted hover:text-primary rounded-xl transition-all flex items-center justify-center shadow-sm" title="{{ t('common.generate') }}">
								<i class="fas fa-magic"></i>
							</button>
						</div>
					</div>

					<div>
						<label class="block text-[10px] font-bold dark:text-slate-400 text-slate-500 uppercase tracking-wider mb-2 ml-1">{{ t('proxies.password') }}</label>
						<div class="flex gap-3">
							<div class="relative flex-grow">
								<i class="fas fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 dark:text-muted text-xs"></i>
								<input type="text" name="password" id="proxy_password" class="input-field input-with-icon bg-slate-50 dark:bg-panel border-slate-200 dark:border-default" placeholder="{{ t('proxies.leave_blank_auto') }}">
							</div>
							<button type="button" onclick="generatePassword()" class="w-12 h-12 bg-slate-100 dark:bg-surface-hover text-slate-500 dark:text-muted hover:text-primary rounded-xl transition-all flex items-center justify-center shadow-sm" title="{{ t('common.generate') }}">
								<i class="fas fa-magic"></i>
							</button>
						</div>
					</div>
				</div>

				<div class="pt-6 flex gap-4">
					<button type="button" onclick="closeCreateModal()" class="flex-grow py-4 bg-slate-100 dark:bg-surface-hover text-slate-600 dark:text-secondary font-bold rounded-2xl hover:bg-slate-200 dark:hover:bg-surface-border transition-all">
						{{ t('form.cancel') }}
					</button>
					<button type="submit" class="flex-grow py-4 btn-primary font-bold rounded-2xl shadow-xl shadow-primary/30 hover:shadow-primary/40">
						{{ t('form.create') }}
					</button>
				</div>
			</form>
		</div>
	</div>

	<script>
		function openCreateModal() {
			document.getElementById('createModal').classList.remove('hidden');
		}
		function closeCreateModal() {
			document.getElementById('createModal').classList.add('hidden');
		}

		function filterProxies() {
			const query = document.getElementById('proxySearch').value.toLowerCase();
			const type = document.getElementById('typeFilter').value;
			const status = document.getElementById('statusFilter').value;
			const cards = document.querySelectorAll('.proxy-row');
			let visibleCount = 0;
			
			cards.forEach(card => {
				const text = card.getAttribute('data-search').toLowerCase();
				const cardType = card.getAttribute('data-type');
				const cardStatus = card.getAttribute('data-status');
				
				const matchesQuery = text.includes(query);
				const matchesType = type === 'all' || cardType === type;
				const matchesStatus = status === 'all' || cardStatus === status;
				
				const isVisible = matchesQuery && matchesType && matchesStatus;
				// Restore original display so grid layout is respected (flex-col for cards)
				const originalDisplay = card.dataset.originalDisplay || (getComputedStyle(card).display !== 'none' ? getComputedStyle(card).display : 'flex');
				card.style.display = isVisible ? '' : 'none';
				if (isVisible) visibleCount++;
			});

			document.getElementById('noResults').classList.toggle('hidden', visibleCount > 0 || cards.length === 0);
		}

		function checkProxy(id, btn) {
			const icon = btn.querySelector('i');
			const originalClass = icon.className;
			icon.className = 'fas fa-spinner fa-spin text-xs';
			btn.disabled = true;

			fetch(`/proxies/${id}/check`, {
				method: 'POST',
				headers: {
					'X-Requested-With': 'XMLHttpRequest',
					'X-CSRF-Token': '{{ csrf_token }}'
				}
			})
			.then(r => r.json())
			.then(res => {
				icon.className = originalClass;
				btn.disabled = false;
				if (res.success) {
					showToast(res.message, 'success');
					// Optional: update a status dot or similar
				} else {
					showToast(res.message, 'error');
				}
			})
			.catch(err => {
				icon.className = originalClass;
				btn.disabled = false;
				showToast('Connection check failed', 'error');
			});
		}


		function generateUsername() {
			const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
			let res = 'user_';
			for(let i=0; i<8; i++) res += chars.charAt(Math.floor(Math.random() * chars.length));
			document.getElementById('proxy_username').value = res;
		}
		function generatePassword() {
			const chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
			let res = '';
			for(let i=0; i<16; i++) res += chars.charAt(Math.floor(Math.random() * chars.length));
			document.getElementById('proxy_password').value = res;
		}
	</script>
{% endblock %}
