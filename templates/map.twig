{% extends "layout.twig" %}
{% block title %}{{ t('map.title')|default('Intelligence Map') }} — {{ app_name }}{% endblock %}

{% block breadcrumbs %}
    <li class="flex items-center">
        <span>{{ t('map.title')|default('Intelligence Map') }}</span>
    </li>
{% endblock %}


{% block styles %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
    /* Isolate Leaflet's z-indexes so they never cover the sticky navbar */
    #mapWrapper {
        isolation: isolate;
        position: relative;
    }

    #map {
        height: calc(100vh - 200px);
        min-height: 400px;
        width: 100%;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.07);
        overflow: hidden;
    }

    /* Pulsing dot for online clients */
    .pulse-dot {
        width: 14px; height: 14px; border-radius: 50%;
        background: var(--color-primary);
        border: 2px solid var(--color-primary-light);
        box-shadow: 0 0 8px var(--color-primary-light);
        position: absolute; top: 50%; left: 50%;
        transform: translate(-50%, -50%);
    }
    .pulse-ring {
        width: 28px; height: 28px; border-radius: 50%;
        background: var(--color-primary-light);
        border: 2px solid var(--color-primary-light);
        position: absolute; top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        animation: pulse-expand 2s ease-out infinite;
    }
    @keyframes pulse-expand {
        0%   { transform: translate(-50%,-50%) scale(0.5); opacity: 1; }
        100% { transform: translate(-50%,-50%) scale(2);   opacity: 0; }
    }

    /* Cluster badge (number of clients) */
    .cluster-badge {
        position: absolute; top: -6px; right: -6px;
        background: var(--color-status-error); color: #fff;
        font-size: 10px; font-weight: 700;
        min-width: 18px; height: 18px;
        border-radius: 999px;
        display: flex; align-items: center; justify-content: center;
        padding: 0 4px;
        border: 2px solid var(--color-surface-panel);
        pointer-events: none;
    }

    /* Popup styles */
    .leaflet-popup-content-wrapper {
        background: var(--color-surface-panel);
        border: 1px solid var(--color-surface-border);
        border-radius: 12px; 
        color: var(--color-content-primary);
        box-shadow: var(--shadow-md);
    }
    .leaflet-popup-tip { background: var(--color-surface-panel); }
    .leaflet-popup-content { margin: 0; min-width: 240px; max-width: 300px; }
    .leaflet-popup-close-button { color: var(--color-content-secondary) !important; top: 12px !important; right: 12px !important; }

    /* Single client popup */
    .popup-inner { padding: 16px; }
    .popup-name {
        font-size: 14px; font-weight: 700; color: var(--color-content-primary);
        margin-bottom: 10px; display: flex; align-items: center; gap: 8px;
        padding-right: 20px;
    }
    .popup-status-badge {
        font-size: 10px; padding: 2px 8px; border-radius: 999px;
        font-weight: 700; uppercase; tracking-wider; white-space: nowrap;
    }
    .popup-status-online  { background: var(--color-status-active-light); color: var(--color-status-active); border: 1px solid var(--color-status-active-border); }
    .popup-status-offline { background: var(--color-status-offline-light); color: var(--color-status-offline); border: 1px solid var(--color-status-offline-border); }
    
    .popup-row {
        font-size: 12px; color: var(--color-content-secondary);
        display: flex; align-items: flex-start; gap: 8px; margin-bottom: 6px;
    }
    .popup-row i { width: 14px; text-align: center; margin-top: 1px; color: var(--color-content-muted); flex-shrink: 0; }
    .popup-link {
        display: inline-flex; align-items: center; gap: 6px;
        margin-top: 12px; font-size: 11px; color: var(--color-primary);
        text-decoration: none; font-weight: 700; text-transform: uppercase; tracking-wider;
    }
    .popup-link:hover { color: var(--color-primary-hover); }

    /* Multi-client popup (list) */
    .popup-header {
        padding: 14px 16px 12px;
        border-bottom: 1px solid var(--color-surface-border);
        font-size: 11px; font-weight: 800;
        color: var(--color-content-secondary); text-transform: uppercase; letter-spacing: 0.08em;
    }
    .popup-list { max-height: 280px; overflow-y: auto; padding: 4px 0; }
    .popup-list::-webkit-scrollbar { width: 4px; }
    .popup-list::-webkit-scrollbar-thumb { background: var(--color-surface-border); border-radius: 4px; }
    .popup-list-item {
        padding: 10px 16px;
        border-bottom: 1px solid var(--color-surface-border);
        cursor: pointer; transition: all 0.2s;
    }
    .popup-list-item:hover { background: var(--color-surface-hover); }
    .popup-list-item:last-child { border-bottom: none; }
    .popup-item-name { font-size: 13px; font-weight: 700; color: var(--color-content-primary); display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
    .popup-item-meta { font-size: 11px; color: var(--color-content-secondary); display: flex; flex-wrap: wrap; gap: 10px; }
    .popup-item-meta i { color: var(--color-content-muted); }

    /* Map toolbar */
    #mapToolbar {
        position: absolute; top: 16px; right: 16px;
        z-index: 1000; display: flex; gap: 8px;
    }
    .map-btn {
        background: var(--color-surface-panel); 
        border: 1px solid var(--color-surface-border);
        color: var(--color-content-secondary); 
        padding: 8px 16px; border-radius: 10px;
        font-size: 11px; font-weight: 700; cursor: pointer;
        display: flex; align-items: center; gap: 8px;
        transition: all 0.2s; white-space: nowrap;
        text-transform: uppercase; tracking-wider;
    }
    .map-btn:hover { border-color: var(--color-primary); color: var(--color-content-primary); background: var(--color-surface-base); }
    .map-btn.active { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }

    /* Server Icon Marker */
    .server-icon-wrapper {
        position: relative;
        width: 32px;
        height: 32px;
        background: rgba(147, 51, 234, 0.2);
        border: 2px solid #a855f7;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #c084fc;
        box-shadow: 0 0 15px rgba(168, 85, 247, 0.5);
        animation: server-glow 3s ease-in-out infinite alternate;
        cursor: pointer;
    }
    @keyframes server-glow {
        0% { box-shadow: 0 0 5px rgba(168, 85, 247, 0.3); border-color: #a855f7; }
        100% { box-shadow: 0 0 20px rgba(168, 85, 247, 0.8); border-color: #c084fc; }
    }

    /* Offline client dot */
    .offline-dot {
        width: 10px; height: 10px; border-radius: 50%;
        background: #64748b;
        border: 2px solid #475569;
        box-shadow: 0 0 4px rgba(100, 116, 139, 0.4);
        position: absolute; top: 50%; left: 50%;
        transform: translate(-50%, -50%);
    }

    /* Animated flowing active line */
    .animated-flow-line {
        stroke-dasharray: 8, 8;
        animation: flow-anim 1.5s linear infinite;
        stroke-linecap: round;
    }
    @keyframes flow-anim {
        to {
            stroke-dashoffset: -32;
        }
    }

    /* Static inactive line */
    .static-inactive-line {
        stroke-dasharray: 6, 6;
        stroke-linecap: round;
    }

    /* Server Info Card inside popup */
    .server-info-card {
        padding: 12px 14px;
    }
    .server-card-title {
        font-size: 13px;
        font-weight: 700;
        color: #c084fc;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
    }
    .server-card-row {
        font-size: 11px;
        color: var(--color-content-secondary);
        display: flex;
        gap: 8px;
        margin-bottom: 4px;
        align-items: center;
    }
    .server-card-row i {
        width: 14px;
        text-align: center;
        color: var(--color-content-muted);
    }
    .server-card-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 10px;
        font-size: 10px;
        color: #a855f7;
        text-decoration: none;
        font-weight: 700;
        text-transform: uppercase;
        tracking-wider;
    }
    .server-card-link:hover {
        color: #c084fc;
    }
</style>
{% endblock %}

{% block content %}
<div class="w-full">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
        <h1 class="text-2xl font-bold flex items-center">
            <div class="w-10 h-10 rounded-lg bg-surface-hover text-primary flex items-center justify-center mr-3">
                <i class="fas fa-globe-europe"></i>
            </div>
            {{ t('map.title')|default('Intelligence Map') }}
        </h1>
    </div>

    <!-- Stats Bar -->
    <div id="mapStats" class="panel px-5 py-4 flex flex-wrap items-center justify-between gap-4 mb-6">
        <div class="flex items-center gap-3 flex-wrap">
            <span class="text-xs font-bold uppercase tracking-widest text-content-muted">{{ t('map.fleet_distribution')|default('Client Distribution') }}</span>
            <div class="hidden sm:block h-4 w-px bg-surface-border"></div>
            <div class="flex items-center gap-2">
                <span class="badge-active text-[11px] px-2.5 py-1 rounded-lg flex items-center font-bold">
                    <span class="w-1.5 h-1.5 rounded-full bg-success mr-1.5 animate-pulse"></span>
                    {{ t('status.online')|default('Online') }}: <span class="ml-1 font-mono text-xs" id="countOnline">—</span>
                </span>
                <span class="badge-error text-[11px] px-2.5 py-1 rounded-lg flex items-center font-bold">
                    <span class="w-1.5 h-1.5 rounded-full bg-error mr-1.5"></span>
                    {{ t('status.offline')|default('Offline') }}: <span class="ml-1 font-mono text-xs" id="countOffline">—</span>
                </span>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <span class="badge-muted text-[11px] px-2.5 py-1 rounded-lg flex items-center font-bold">
                <i class="fas fa-map-marker-alt text-content-secondary mr-1.5 text-[10px]"></i>
                {{ t('map.clients_plotted')|default('clients plotted') }}: <span class="ml-1 font-mono text-xs text-content-primary" id="countTotal">—</span>
            </span>
        </div>
    </div>

    <!-- Map Container — isolated so Leaflet z-indexes don't escape -->
    <div id="mapWrapper">
        <div id="map"></div>
        <!-- Filter Toolbar overlaid on map -->
        <div id="mapToolbar">
            <button class="map-btn active" id="btnAll" onclick="setFilter('all')">
                <i class="fas fa-globe"></i> {{ t('status.all', [], 'All') }}
            </button>
            <button class="map-btn" id="btnOnline" onclick="setFilter('online')">
                <i class="fas fa-circle text-[8px] text-status-active"></i> {{ t('status.online', [], 'Online') }}
            </button>
            <button class="map-btn" id="btnOffline" onclick="setFilter('offline')">
                <i class="fas fa-circle text-[8px] text-muted"></i> {{ t('status.offline', [], 'Offline') }}
            </button>
        </div>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {

    const map = L.map('map', { center: [58, 60], zoom: 4 });
    let tileLayer;

    function updateMapTheme() {
        if (tileLayer) map.removeLayer(tileLayer);
        
        const isDark = document.documentElement.classList.contains('dark');
        const tileUrl = isDark 
            ? 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png'
            : 'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png';
            
        tileLayer = L.tileLayer(tileUrl, {
            attribution: '&copy; <a href="https://carto.com/">CARTO</a>',
            subdomains: 'abcd', maxZoom: 19
        }).addTo(map);
    }

    updateMapTheme();
    window.addEventListener('themeChanged', updateMapTheme);

    let allClientMarkers = [];
    let allServerMarkers = [];
    let activeLines = [];
    let currentFilter = 'all';
    let cachedClients = [];
    let cachedServers = [];
    let currentOpenServerId = null;

    // ── Helpers ──────────────────────────────────────────────────────────

    function formatTraffic(mb) {
        return mb >= 1024 ? (mb / 1024).toFixed(2) + ' GB' : mb.toFixed(2) + ' MB';
    }

    function statusBadge(status) {
        const cls = status === 'online' ? 'popup-status-online' : 'popup-status-offline';
        const label = status === 'online'
            ? '{{ t("status.online", [], "Online") }}'
            : '{{ t("status.offline", [], "Offline") }}';
        return `<span class="popup-status-badge ${cls}">${label}</span>`;
    }

    function clearLines() {
        activeLines.forEach(line => map.removeLayer(line));
        activeLines = [];
        // Map overlay text is no longer used, keeping clean
    }

    function drawConnection(clientCoords, serverCoords, status, isServerHover = false) {
        const isOnline = status === 'online';
        
        let weight = isOnline ? 3 : 1.5;
        let opacity = isOnline ? 0.8 : 0.4;
        
        if (isServerHover) {
            weight = isOnline ? 2.0 : 1.0;
            opacity = isOnline ? 0.35 : 0.15;
        }
        
        const line = L.polyline([clientCoords, serverCoords], {
            color: isOnline ? '#a855f7' : '#64748b',
            weight: weight,
            opacity: opacity,
            className: isOnline ? 'animated-flow-line' : 'static-inactive-line'
        }).addTo(map);
        
        activeLines.push(line);
    }

    function drawServerConnections(serverId) {
        const srv = cachedServers.find(s => s.id === serverId);
        if (!srv) return;
        const connectedClients = cachedClients.filter(c => c.server_id === serverId && (currentFilter === 'all' || c.status === currentFilter));
        connectedClients.forEach(c => {
            drawConnection([c.lat, c.lon], [srv.lat, srv.lon], c.status, true);
        });
    }

    // ── Marker factories ─────────────────────────────────────────────────

    function makeServerIcon(count = 1) {
        const badge = count > 1 ? `<div class="cluster-badge" style="background:#a855f7; border-color:var(--color-surface-panel);">${count}</div>` : '';
        return L.divIcon({
            className: '',
            html: `<div class="server-icon-wrapper">
                       <i class="fas fa-server"></i>
                       ${badge}
                   </div>`,
            iconSize: [32, 32], iconAnchor: [16, 16], popupAnchor: [0, -20]
        });
    }

    function makeIcon(hasOnline, count) {
        const badge = count > 1 ? `<div class="cluster-badge">${count}</div>` : '';
        if (hasOnline) {
            return L.divIcon({
                className: '',
                html: `<div style="position:relative;width:28px;height:28px;">
                           <div class="pulse-ring"></div>
                           <div class="pulse-dot"></div>
                           ${badge}
                       </div>`,
                iconSize: [28, 28], iconAnchor: [14, 14], popupAnchor: [0, -18]
            });
        } else {
            return L.divIcon({
                className: '',
                html: `<div style="position:relative;width:28px;height:28px;">
                           <div class="offline-dot"></div>
                           ${badge}
                       </div>`,
                iconSize: [28, 28], iconAnchor: [14, 14], popupAnchor: [0, -18]
            });
        }
    }

    // ── Popup builders ───────────────────────────────────────────────────

    function buildSinglePopup(c) {
        return `<div class="popup-inner">
            <div class="popup-name">${c.name} ${statusBadge(c.status)}</div>
            ${c.city  ? `<div class="popup-row"><i class="fas fa-map-marker-alt"></i>${c.city}, ${c.country}</div>` : ''}
            ${c.isp   ? `<div class="popup-row"><i class="fas fa-network-wired"></i>${c.isp}</div>` : ''}
            <div class="popup-row"><i class="fas fa-server"></i>${c.server_name || '—'}</div>
            <div class="popup-row"><i class="fas fa-exchange-alt"></i>${formatTraffic(c.traffic_mb)}</div>
            <div class="popup-row"><i class="fas fa-clock"></i>${c.last_seen}</div>
            <a href="/clients/${c.id}" class="popup-link"><i class="fas fa-external-link-alt"></i> View Client</a>
        </div>`;
    }

    function buildMultiPopup(group) {
        const location = group[0].city ? `${group[0].city}, ${group[0].country}` : `${group[0].lat.toFixed(3)}, ${group[0].lon.toFixed(3)}`;
        const onlineCount = group.filter(c => c.status === 'online').length;

        const items = group.map(c => `
            <div class="popup-client-row popup-list-item" onclick="window.location='/clients/${c.id}'"
                 onmouseover="highlightClientConnection(${c.lat}, ${c.lon}, ${c.server_id}, '${c.name}', '${c.status}')"
                 onmouseout="clearClientConnection()">
                <div class="popup-item-name">
                    ${c.name}
                    ${statusBadge(c.status)}
                </div>
                <div class="popup-item-meta">
                    <span><i class="fas fa-server mr-1 text-content-muted"></i>${c.server_name || '—'}</span>
                    <span><i class="fas fa-exchange-alt mr-1 text-content-muted"></i>${formatTraffic(c.traffic_mb)}</span>
                    <span><i class="fas fa-clock mr-1 text-content-muted"></i>${c.last_seen}</span>
                </div>
            </div>`).join('');

        return `<div class="popup-header">
                    <i class="fas fa-map-marker-alt" style="margin-right:5px;color:var(--color-primary);"></i>
                    ${location} &mdash; ${group.length} clients, ${onlineCount} online
                </div>
                <div class="popup-list">${items}</div>`;
    }

    function buildServerPopup(srv) {
        const labelText = '{{ t("server.view", [], "View Server") }}';
        return `<div class="server-info-card">
            <div class="server-card-title"><i class="fas fa-server"></i> ${srv.name}</div>
            <div class="server-card-row"><i class="fas fa-network-wired"></i>IP: ${srv.host}</div>
            <div class="server-card-row"><i class="fas fa-map-marker-alt"></i>Location: ${srv.city || '—'}, ${srv.country || '—'}</div>
            <div class="server-card-row"><i class="fas fa-users"></i>Clients: ${srv.client_count} (${srv.online_count} online)</div>
            <a href="/servers/${srv.id}" class="server-card-link" onclick="event.stopPropagation();"><i class="fas fa-external-link-alt"></i> ${labelText}</a>
        </div>`;
    }

    function buildMultiServerPopup(group) {
        const location = group[0].city ? `${group[0].city}, ${group[0].country}` : `${group[0].lat.toFixed(3)}, ${group[0].lon.toFixed(3)}`;
        
        const items = group.map(srv => `
            <div class="popup-client-row popup-list-item" onclick="window.location='/servers/${srv.id}'"
                 onmouseover="highlightServerConnection(${srv.id})"
                 onmouseout="clearServerConnection()">
                <div class="popup-item-name" style="color: #c084fc;">
                    <i class="fas fa-server" style="font-size: 11px;"></i> ${srv.name}
                </div>
                <div class="popup-item-meta">
                    <span><i class="fas fa-network-wired mr-1 text-content-muted"></i>IP: ${srv.host}</span>
                    <span><i class="fas fa-users mr-1 text-content-muted"></i>Clients: ${srv.client_count} (${srv.online_count} online)</span>
                </div>
            </div>`).join('');

        return `<div class="popup-header" style="color:#c084fc; border-bottom: 1px solid rgba(168, 85, 247, 0.2);">
                    <i class="fas fa-server" style="margin-right:5px;color:#a855f7;"></i>
                    ${location} &mdash; ${group.length} servers
                </div>
                <div class="popup-list">${items}</div>`;
    }

    // ── Render ───────────────────────────────────────────────────────────

    function renderServerMarkers() {
        allServerMarkers.forEach(m => map.removeLayer(m));
        allServerMarkers = [];

        // Group by rounded coordinate key
        const groups = {};
        cachedServers.forEach(srv => {
            const key = `${srv.lat.toFixed(4)},${srv.lon.toFixed(4)}`;
            if (!groups[key]) groups[key] = [];
            groups[key].push(srv);
        });

        Object.entries(groups).forEach(([key, group]) => {
            const { lat, lon } = group[0];
            const count = group.length;

            const marker = L.marker([lat, lon], { icon: makeServerIcon(count) });
            const popup = count === 1 ? buildServerPopup(group[0]) : buildMultiServerPopup(group);
            marker.bindPopup(popup, { maxWidth: 300 });

            // Hover: draw connections (no text tooltip)
            marker.on('mouseover', () => {
                if (currentOpenServerId) return;
                clearLines();
                if (count === 1) {
                    drawServerConnections(group[0].id);
                } else {
                    group.forEach(srv => drawServerConnections(srv.id, true));
                }
            });

            marker.on('mouseout', () => {
                if (currentOpenServerId) return;
                clearLines();
            });

            // Click: smart panning and draw connections on popupopen
            marker.on('popupopen', () => {
                clearLines();
                if (count === 1) {
                    currentOpenServerId = group[0].id;
                    drawServerConnections(group[0].id);
                } else {
                    currentOpenServerId = `group_${key}`;
                    group.forEach(srv => drawServerConnections(srv.id, true));
                }
                map.panTo([lat, lon]);
            });

            marker.on('popupclose', () => {
                if (count === 1 && currentOpenServerId === group[0].id) {
                    clearLines();
                    currentOpenServerId = null;
                } else if (count > 1 && currentOpenServerId === `group_${key}`) {
                    clearLines();
                    currentOpenServerId = null;
                }
            });

            marker.addTo(map);
            allServerMarkers.push(marker);
        });
    }

    function renderClientMarkers(clients) {
        allClientMarkers.forEach(m => map.removeLayer(m));
        allClientMarkers = [];
        clearLines();

        if (currentOpenServerId) {
            if (currentOpenServerId.toString().startsWith('group_')) {
                const key = currentOpenServerId.substring(6);
                const srvs = cachedServers.filter(s => `${s.lat.toFixed(4)},${s.lon.toFixed(4)}` === key);
                srvs.forEach(srv => drawServerConnections(srv.id, true));
            } else {
                drawServerConnections(currentOpenServerId);
            }
        }

        const visible = clients.filter(c => currentFilter === 'all' || c.status === currentFilter);

        // Group by rounded coordinate key
        const groups = {};
        visible.forEach(c => {
            const key = `${c.lat.toFixed(4)},${c.lon.toFixed(4)}`;
            if (!groups[key]) groups[key] = [];
            groups[key].push(c);
        });

        let online = 0, offline = 0;

        Object.values(groups).forEach(group => {
            const hasOnline = group.some(c => c.status === 'online');
            const { lat, lon } = group[0];

            group.forEach(c => { c.status === 'online' ? online++ : offline++; });

            const count = group.length;

            const marker = L.marker([lat, lon], { icon: makeIcon(hasOnline, count) });
            const popup  = count === 1 ? buildSinglePopup(group[0]) : buildMultiPopup(group);
            marker.bindPopup(popup, { maxWidth: 300 });

            // Hover: single client dot directly highlights connection
            if (count === 1) {
                const c = group[0];
                marker.on('mouseover', () => {
                    if (currentOpenServerId) return;
                    clearLines();
                    const srv = cachedServers.find(s => s.id === c.server_id);
                    if (srv) {
                        drawConnection([c.lat, c.lon], [srv.lat, srv.lon], c.status, false);
                    }
                });
                marker.on('mouseout', () => {
                    if (currentOpenServerId) return;
                    clearLines();
                });
            }

            // Click: smart panning on client click
            marker.on('click', () => {
                clearLines();
                map.panTo([lat, lon]);
            });

            marker.addTo(map);
            allClientMarkers.push(marker);
        });

        document.getElementById('countOnline').textContent  = online;
        document.getElementById('countOffline').textContent = offline;
        document.getElementById('countTotal').textContent   = online + offline;
    }

    // ── Global handles ───────────────────────────────────────────────────

    window.highlightClientConnection = function(lat, lon, serverId, name, status) {
        if (currentOpenServerId) return;
        clearLines();
        const srv = cachedServers.find(s => s.id === serverId);
        if (srv) {
            drawConnection([lat, lon], [srv.lat, srv.lon], status, false);
        }
    };

    window.clearClientConnection = function() {
        if (currentOpenServerId) return;
        clearLines();
    };

    window.highlightServerConnection = function(serverId) {
        if (currentOpenServerId && !currentOpenServerId.toString().startsWith('group_')) return;
        clearLines();
        drawServerConnections(serverId, false);
    };

    window.clearServerConnection = function() {
        if (currentOpenServerId && !currentOpenServerId.toString().startsWith('group_')) return;
        clearLines();
        if (currentOpenServerId && currentOpenServerId.toString().startsWith('group_')) {
            const key = currentOpenServerId.substring(6);
            const srvs = cachedServers.filter(s => `${s.lat.toFixed(4)},${s.lon.toFixed(4)}` === key);
            srvs.forEach(srv => drawServerConnections(srv.id, true));
        }
    };

    // ── Filter toggle ────────────────────────────────────────────────────

    window.setFilter = function (filter) {
        currentFilter = filter;
        ['btnAll','btnOnline','btnOffline'].forEach(id => document.getElementById(id).classList.remove('active'));
        document.getElementById({ all:'btnAll', online:'btnOnline', offline:'btnOffline' }[filter]).classList.add('active');
        renderClientMarkers(cachedClients);
    };

    // ── Load data ────────────────────────────────────────────────────────

    fetch('/api/map/clients')
        .then(r => r.json())
        .then(data => {
            if (!data.success) return;
            cachedClients = data.clients;
            cachedServers = data.servers || [];
            renderServerMarkers();
            renderClientMarkers(cachedClients);
        })
        .catch(err => console.error('Map data error:', err));
});
</script>
{% endblock %}
