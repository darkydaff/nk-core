<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Blocking theme script -->
    <script>
        if (localStorage.getItem('theme') === 'dark' || !('theme' in localStorage)) {
            document.documentElement.classList.add('dark');
        }
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ app_name }}{% endblock %}</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@400;500;600;700&family=Geist+Mono:wght@100..900&display=swap" rel="stylesheet">
    
    
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8fafc">
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0e17">
    <meta name="color-scheme" content="light dark">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="NK-CORE">
    <link rel="apple-touch-icon" href="/img/logo.svg">
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/svg+xml" href="/img/logo.svg">
    <meta name="csrf-token" content="{{ csrf_token }}">
    
    <link rel="stylesheet" href="/css/tokens.css">
    <link rel="stylesheet" href="/css/output.css">
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        if (typeof Chart === 'undefined') {
            document.write('<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"><\/script>');
        }
    </script>
    <script src="/js/core.js"></script>
    
    <link rel="stylesheet" href="/css/twf-font.css">

    {% import "macros/ui.twig" as ui %}
    {% block styles %}{% endblock %}
    
</head>
<body class="antialiased text-[14px] {% if user %}has-sidebar{% endif %}">
    <a href="#main-content" class="sr-only focus:not-sr-only">Skip to content</a>
    {% if user %}
    <button id="sidebarOverlay" class="sidebar-overlay" onclick="toggleSidebar()" aria-label="Close sidebar" type="button"></button>
    
    <aside id="sidebar" class="sidebar">
        <div class="sidebar-logo">
            <img src="/img/logo.svg" alt="Logo" class="w-8 h-8 mr-3">
            <span class="text-xl font-bold tracking-tighter text-sidebar-text">{{ app_name }}</span>
        </div>

        <nav class="flex-grow mt-4">
            <a href="/dashboard" class="sidebar-item {% if current_uri == '/dashboard' %}active{% endif %}">
                <i class="fas fa-tachometer-alt w-5 mr-3"></i>{{ t('menu.dashboard') }}
            </a>
            <a href="/servers" class="sidebar-item {% if '/servers' in current_uri %}active{% endif %}">
                <i class="fas fa-server w-5 mr-3"></i>{{ t('menu.servers') }}
            </a>
            <a href="/map" class="sidebar-item {% if current_uri == '/map' %}active{% endif %}">
                <i class="fas fa-globe-europe w-5 mr-3"></i>{{ t('menu.map')|default('Map') }}
            </a>
            <a href="/proxies" class="sidebar-item {% if current_uri == '/proxies' %}active{% endif %}">
                <i class="fas fa-shield-alt w-5 mr-3"></i>{{ t('menu.proxies')|default('Proxies') }}
            </a>
            <a href="/jobs/dlq" class="sidebar-item {% if current_uri == '/jobs/dlq' %}active{% endif %}">
                <i class="fas fa-biohazard w-5 mr-3"></i>Queue Health
            </a>
        </nav>

        <div class="p-4 mt-auto border-t border-sidebar-border/30">
            <div class="flex flex-col gap-2">
                <a href="/settings" class="sidebar-item !mx-0 !my-0 {% if current_uri == '/settings' %}active{% endif %}">
                    <i class="fas fa-cog w-5 mr-3"></i>{{ t('menu.settings') }}
                </a>
                <div class="flex items-center p-2 rounded-xl bg-sidebar-hover">
                    <div class="w-10 h-10 rounded-lg bg-primary/20 flex items-center justify-center mr-3 text-primary">
                        <i class="fas fa-user"></i>
                    </div>
                    <div class="flex-grow min-w-0">
                        <span class="text-xs font-bold text-sidebar-text truncate block">{{ user.name }}</span>
                        <span class="text-[10px] opacity-50 uppercase tracking-widest">{{ user.role }}</span>
                    </div>
                    <a href="/logout" class="ml-2 text-sidebar-text/50 hover:text-red-400 p-2 transition-colors" title="{{ t('auth.logout')|default('Logout') }}">
                        <i class="fas fa-sign-out-alt"></i>
                    </a>
                </div>
            </div>
        </div>
    </aside>
    {% endif %}

    <div class="main-wrapper">
        {% if user %}
        <header class="top-bar">
            <div class="max-w-7xl w-full mx-auto flex items-center justify-between px-4 md:px-8">
                <div class="flex items-center">
                    <button onclick="toggleSidebar()" class="xl:hidden p-2 text-secondary mr-2" aria-label="Toggle Sidebar Menu" aria-expanded="false" aria-controls="sidebar">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                    <div class="hidden sm:block">
                        <nav class="flex" aria-label="Breadcrumb">
                            <ol class="flex items-center space-x-2 text-xs font-medium text-muted">
                                {% block breadcrumbs %}{% endblock %}
                            </ol>
                        </nav>
                    </div>
                </div>

                <div class="flex items-center space-x-4">
                    <div class="flex items-center bg-base rounded-xl p-1 border border-default">
                        <button onclick="globalSyncAll(this)" class="p-2 text-secondary hover:text-primary transition-colors global-sync-btn" title="{{ t('menu.sync_all') }}" aria-label="{{ t('menu.sync_all') }}">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                    </div>

                    <div class="relative">
                        <button id="lang-trigger" onclick="toggleLanguageDropdown()" class="flex items-center px-3 py-2 rounded-xl hover:bg-surface-hover transition-colors" aria-haspopup="listbox" aria-expanded="false" aria-controls="languageDropdown" aria-label="Select Language">
                            {% for lang in languages %}
                                {% if lang.code == current_language %}
                                    <span class="flag-emoji text-xl">{{ getFlag(lang.code)|raw }}</span>
                                {% endif %}
                            {% endfor %}
                            <i class="fas fa-chevron-down ml-2 text-[10px] opacity-50"></i>
                        </button>
                        <div id="languageDropdown" class="hidden absolute right-0 top-full mt-2 w-48 panel shadow-xl p-1 z-50" role="listbox" aria-labelledby="lang-trigger">
                            {% for lang in languages %}
                            <form method="POST" action="/language/change" class="block">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                <input type="hidden" name="language" value="{{ lang.code }}">
                                <input type="hidden" name="redirect" value="{{ current_uri }}">
                                <button type="submit" role="option" aria-selected="{% if lang.code == current_language %}true{% else %}false{% endif %}" class="w-full text-left px-4 py-2.5 text-sm text-secondary hover:text-primary hover:bg-surface-hover rounded-lg flex items-center transition-colors {% if lang.code == current_language %}bg-surface-hover text-primary font-medium{% endif %}">
                                    <span class="mr-3 text-xl">{{ getFlag(lang.code)|raw }}</span>
                                    <span>{{ lang.name }}</span>
                                </button>
                            </form>
                            {% endfor %}
                        </div>
                    </div>

                    <button onclick="toggleTheme()" class="w-10 h-10 rounded-xl bg-base border border-default flex items-center justify-center text-secondary hover:text-primary transition-all" id="theme-toggle" aria-label="Toggle dark and light themes">
                        <i class="fas fa-moon dark:fa-sun" id="themeIcon"></i>
                    </button>
                </div>
            </div>
        </header>
        {% endif %}

        <main id="main-content" class="flex-grow p-4 md:p-8 max-w-7xl w-full mx-auto animate-in">
            {% block content %}{% endblock %}
        </main>

        <footer class="py-6 px-8 border-t border-default text-center text-xs text-muted">
            {{ app_name }} &copy; {{ "now"|date("Y") }} • v1.0.0
        </footer>
    </div>

    <div id="toast-container" class="toast-container" aria-live="polite" aria-atomic="true"></div>

    <script>
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('sidebarOverlay').classList.toggle('open');
        }

        function toggleLanguageDropdown() {
            document.getElementById('languageDropdown').classList.toggle('hidden');
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            const icon = document.getElementById('themeIcon');
            if (icon) icon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
            window.dispatchEvent(new CustomEvent('themeChanged', { detail: { theme: isDark ? 'dark' : 'light' } }));
        }

        document.addEventListener('DOMContentLoaded', () => {
            const icon = document.getElementById('themeIcon');
            if (icon) icon.className = document.documentElement.classList.contains('dark') ? 'fas fa-sun' : 'fas fa-moon';
        });

        async function globalSyncAll(btn) {
            const icon = btn.querySelector('i');
            btn.disabled = true;
            icon.classList.add('fa-spin');
            
            try {
                const response = await fetch('/servers/sync-all', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'X-CSRF-Token': '{{ csrf_token }}' }
                });
                const data = await response.json();
                if (data.success) {
                    NK.toast('Servers synchronized', 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    NK.toast(data.error || 'Sync failed', 'error');
                }
            } catch (e) {
                NK.toast('Sync failed', 'error');
            } finally {
                btn.disabled = false;
                icon.classList.remove('fa-spin');
            }
        }
    </script>
    {% block scripts %}{% endblock %}
</body>
</html>

