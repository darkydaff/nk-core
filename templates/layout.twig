<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Blocking theme script: must run before any CSS to prevent flash -->
    <script>
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage))) {
            document.documentElement.classList.add('dark');
        }
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ app_name }}{% endblock %}</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/geist@1.3.0/dist/fonts/geist-mono/style.css">
    
    <meta name="theme-color" content="#0f172a">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="NK-CORE">
    <link rel="apple-touch-icon" href="/img/logo.svg">
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/svg+xml" href="/img/logo.svg">
    <meta name="csrf-token" content="{{ csrf_token }}">
    
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script>
        tailwind = { 
            config: { 
                darkMode: 'class',
                theme: {
                    extend: {
                        fontFamily: {
                            sans: ['Space Grotesk', 'sans-serif'],
                            mono: ['Geist Mono', 'monospace'],
                            brand: ['Geist Mono', 'monospace'],
                        },
                        colors: {
                            surface: {
                                base: 'var(--color-surface-base)',
                                panel: 'var(--color-surface-panel)',
                                hover: 'var(--color-surface-hover)',
                                border: 'var(--color-surface-border)',
                            },
                            content: {
                                primary: 'var(--color-content-primary)',
                                secondary: 'var(--color-content-secondary)',
                                muted: 'var(--color-content-muted)',
                            },
                            primary: {
                                DEFAULT: 'var(--color-primary)',
                                hover: 'var(--color-primary-hover)',
                                light: 'var(--color-primary-light)',
                            }
                        }
                    }
                } 
            } 
        };
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    
    {# SVG-based Flags (Reliable across all regions/VPNs) #}
    <link rel="stylesheet" href="/css/flags.css">

    {% block styles %}{% endblock %}
    
    <style>
        :root {
            /* ── Warm Parchment (Light) ── */
            --color-surface-base:   #f5f3ef;
            --color-surface-panel:  #fdfcfa;
            --color-surface-hover:  #ede9e2;
            --color-surface-border: #d9d3c8;

            --color-content-primary:   #1c1917;
            --color-content-secondary: #57534e;
            --color-content-muted:     #a8a29e;

            --color-primary:       #4f67e0;
            --color-primary-hover: #3b53d1;
            --color-primary-light: rgba(79, 103, 224, 0.08);

            --status-active:  #4f67e0;
            --status-warning: #d97706;
            --status-error:   #dc2626;
            --shadow: 0 2px 8px -2px rgba(0,0,0,0.08), 0 0 0 1px rgba(0,0,0,0.03);
        }

        .dark {
            /* ── Deep Indigo Night (Dark) ── */
            --color-surface-base:   #0d0f1a;
            --color-surface-panel:  #151826;
            --color-surface-hover:  #1e2235;
            --color-surface-border: #2a2f47;

            --color-content-primary:   #e2e4f0;
            --color-content-secondary: #8b90b0;
            --color-content-muted:     #4d5275;

            --color-primary:       #7c8ff5;
            --color-primary-hover: #9aaaf8;
            --color-primary-light: rgba(124, 143, 245, 0.12);

            --status-active:  #7c8ff5;
            --status-warning: #fbbf24;
            --status-error:   #f87171;
            --shadow: 0 4px 20px -4px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.04);
        }

        /* ── Base ── */
        body {
            font-family: 'Space Grotesk', sans-serif;
            background-color: var(--color-surface-base);
            color: var(--color-content-primary);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        /* Light: subtle warm texture */
        body {
            background-image: 
                radial-gradient(ellipse at top left, rgba(79,103,224,0.04) 0%, transparent 60%),
                radial-gradient(ellipse at bottom right, rgba(168,142,100,0.04) 0%, transparent 60%);
        }

        /* Dark: deep gradient + subtle grid */
        .dark body {
            background-image: 
                radial-gradient(ellipse at top right, rgba(124,143,245,0.07) 0%, transparent 50%),
                radial-gradient(ellipse at bottom left, rgba(99,67,181,0.06) 0%, transparent 50%),
                radial-gradient(circle at 2px 2px, rgba(255,255,255,0.015) 1px, transparent 0);
            background-size: auto, auto, 28px 28px;
            background-attachment: fixed, fixed, local;
        }

        /* ── Navigation ── */
        .nav {
            background: rgba(253,252,250,0.85);
            border-bottom: 1px solid var(--color-surface-border);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            transition: background-color 0.3s ease, border-color 0.3s ease;
        }
        .dark .nav {
            background: rgba(13,15,26,0.85);
            border-bottom-color: rgba(42,47,71,0.8);
        }

        /* ── Panels ── */
        .panel {
            background: var(--color-surface-panel);
            border: 1px solid var(--color-surface-border);
            border-radius: 14px;
            box-shadow: var(--shadow);
            transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
        }

        /* ── Inputs ── */
        .input-field {
            background: var(--color-surface-base);
            border: 1px solid var(--color-surface-border);
            color: var(--color-content-primary);
            border-radius: 8px;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .input-field:focus {
            border-color: var(--color-primary);
            box-shadow: 0 0 0 3px var(--color-primary-light);
            outline: none;
        }

        /* ── Buttons ── */
        .btn-primary {
            background: var(--color-primary);
            color: white;
            border-radius: 8px;
            font-weight: 600;
            transition: background-color 0.2s ease, box-shadow 0.2s ease, transform 0.1s ease;
        }
        .btn-primary:hover {
            background: var(--color-primary-hover);
            box-shadow: 0 4px 12px -2px rgba(79,103,224,0.4);
        }
        .btn-primary:active { transform: scale(0.98); }

        .btn-secondary {
            background: var(--color-primary-light);
            color: var(--color-primary);
            border: 1px solid rgba(79,103,224,0.2);
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.2s ease;
        }
        .btn-secondary:hover {
            background: rgba(79,103,224,0.14);
            border-color: rgba(79,103,224,0.35);
        }
        .dark .btn-secondary {
            border-color: rgba(124,143,245,0.25);
        }
        .dark .btn-secondary:hover {
            background: rgba(124,143,245,0.18);
            border-color: rgba(124,143,245,0.4);
        }

        /* ── Badges ── */
        .badge-active {
            background: rgba(79,103,224,0.1);
            color: var(--status-active);
            border: 1px solid rgba(79,103,224,0.25);
        }
        .dark .badge-active {
            background: rgba(124,143,245,0.12);
            color: var(--status-active);
            border-color: rgba(124,143,245,0.3);
        }

        .badge-warning {
            background: rgba(217,119,6,0.1);
            color: var(--status-warning);
            border: 1px solid rgba(217,119,6,0.25);
        }
        .dark .badge-warning {
            background: rgba(251,191,36,0.1);
            color: var(--status-warning);
            border-color: rgba(251,191,36,0.3);
        }

        .badge-error {
            background: rgba(220,38,38,0.08);
            color: var(--status-error);
            border: 1px solid rgba(220,38,38,0.2);
        }
        .dark .badge-error {
            background: rgba(248,113,113,0.1);
            color: var(--status-error);
            border-color: rgba(248,113,113,0.3);
        }

        /* ── Text utilities ── */
        .text-muted     { color: var(--color-content-muted); }
        .text-secondary { color: var(--color-content-secondary); }
        .text-primary   { color: var(--color-content-primary); }
        .text-accent    { color: var(--color-primary); }
        .text-cyan      { color: var(--status-active); }

        /* ── Background utilities ── */
        .bg-panel        { background: var(--color-surface-panel) !important; }
        .bg-base         { background: var(--color-surface-base) !important; }
        .bg-surface-hover { background: var(--color-surface-hover) !important; }
        .border-default  { border-color: var(--color-surface-border) !important; }
        .border-surface-border { border-color: var(--color-surface-border) !important; }

        /* Toggle */
        .toggle-bg { background-color: var(--color-surface-hover) !important; transition: background-color 0.2s ease; }
        input:checked + .toggle-bg,
        input:checked ~ .toggle-bg { background-color: var(--color-primary) !important; }

        /* ── Scrollbar ── */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--color-surface-border); border-radius: 99px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--color-content-muted); }

        /* ── Tech card ── */
        .tech-card {
            position: relative;
            border-left: 2px solid var(--color-primary);
        }
        .tech-card::before {
            content: "";
            position: absolute;
            top: 0; right: 0;
            width: 10px; height: 10px;
            border-top: 2px solid var(--color-primary-hover);
            border-right: 2px solid var(--color-primary-hover);
            opacity: 0.4;
        }

        /* ── Sync pulse animation ── */
        @keyframes pulse-sync {
            0%   { border-color: var(--color-surface-border); box-shadow: 0 0 0 0 rgba(124,143,245,0.25); }
            50%  { border-color: rgba(124,143,245,0.6);       box-shadow: 0 0 0 6px rgba(124,143,245,0); }
            100% { border-color: var(--color-surface-border); box-shadow: 0 0 0 0 rgba(124,143,245,0); }
        }
        .syncing-pulse {
            animation: pulse-sync 1.5s infinite !important;
            opacity: 0.9;
        }

        /* ── Responsive ── */
        .mobile-menu { display: none; }
        .mobile-menu.active { display: block; }
        .language-dropdown { display: none; }
        .language-dropdown.active { display: block; }

        @media (max-width: 768px) {
            .table-wrapper { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; }
            .hide-mobile { display: none !important; }
        }

        /* ── Toast ── */
        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .toast {
            background: var(--color-surface-panel);
            border: 1px solid var(--color-surface-border);
            border-radius: 12px;
            padding: 14px 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: var(--shadow);
            min-width: 280px;
            max-width: 400px;
            animation: toastIn 0.3s ease;
        }
        .toast.toast-out { animation: toastOut 0.3s ease forwards; }

        @keyframes toastIn {
            from { opacity: 0; transform: translateX(20px); }
            to   { opacity: 1; transform: translateX(0); }
        }
        @keyframes toastOut {
            from { opacity: 1; transform: translateX(0); }
            to   { opacity: 0; transform: translateX(20px); }
        }

        .toast-success { border-color: rgba(79,103,224,0.4); }
        .toast-success .toast-icon { color: var(--status-active); }
        .toast-error   { border-color: rgba(220,38,38,0.35); }
        .toast-error .toast-icon   { color: var(--status-error); }
        .toast-warning { border-color: rgba(217,119,6,0.35); }
        .toast-warning .toast-icon { color: var(--status-warning); }

        .toast-message { color: var(--color-content-primary); font-size: 14px; flex-grow: 1; }
        .toast-close {
            color: var(--color-content-muted);
            cursor: pointer;
            padding: 4px;
            transition: color 0.2s;
        }
        .toast-close:hover { color: var(--color-content-primary); }
    </style>
</head>
<body class="text-primary text-[13px] antialiased tracking-tight">
    {% if user %}
    <nav class="nav shadow-lg sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex">
                    <div class="flex-shrink-0 flex items-center">
                        <img src="/img/logo.svg" alt="Logo" class="w-8 h-8 mr-3">
                        <span class="text-primary text-xl font-bold font-brand tracking-tighter drop-shadow-[0_0_8px_rgba(37,99,235,0.3)]">{{ app_name }}</span>
                    </div>
                    <div class="hidden md:ml-8 md:flex md:space-x-2 items-center">
                        <a href="/dashboard" class="text-secondary hover:text-primary hover:bg-surface-hover px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center">
                            <i class="fas fa-tachometer-alt mr-2 opacity-70"></i>{{ t('menu.dashboard') }}
                        </a>
                        <a href="/servers" class="text-secondary hover:text-primary hover:bg-surface-hover px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center">
                            <i class="fas fa-server mr-2 opacity-70"></i>{{ t('menu.servers') }}
                        </a>
                        <a href="/map" class="text-secondary hover:text-primary hover:bg-surface-hover px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center">
                            <i class="fas fa-globe-europe mr-2 opacity-70"></i>{{ t('menu.map')|default('Map') }}
                        </a>
                        <a href="/proxies" class="text-secondary hover:text-primary hover:bg-surface-hover px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center">
                            <i class="fas fa-shield-alt mr-2 opacity-70"></i>{{ t('menu.proxies')|default('Proxies') }}
                        </a>
                        {% if user.role == 'admin' %}
                        <a href="/settings" class="text-secondary hover:text-primary hover:bg-surface-hover px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center">
                            <i class="fas fa-cog mr-2 opacity-70"></i>{{ t('menu.settings') }}
                        </a>
                        {% endif %}
                    </div>
                </div>
                <div class="flex items-center">
                    <div class="relative mr-4">
                        <button onclick="toggleLanguageDropdown()" class="text-secondary hover:text-primary flex items-center px-3 py-2 rounded-lg hover:bg-surface-hover transition-colors focus:outline-none">
                            {% for lang in languages %}
                                {% if lang.code == current_language %}
                                    <span class="mr-2 flag-emoji">{{ getFlag(lang.code)|raw }}</span>
                                {% endif %}
                            {% endfor %}
                            <i class="fas fa-chevron-down ml-1 text-xs opacity-70"></i>
                        </button>
                        <div id="languageDropdown" class="language-dropdown absolute right-0 mt-2 w-48 panel z-50 shadow-xl p-1">
                            {% for lang in languages %}
                            <form method="POST" action="/language/change" class="block">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                <input type="hidden" name="language" value="{{ lang.code }}">
                                <input type="hidden" name="redirect" value="{{ current_uri }}">
                                <button type="submit" class="w-full text-left px-4 py-2.5 text-sm text-secondary hover:text-primary hover:bg-surface-hover rounded-lg flex items-center transition-colors
                                    {% if lang.code == current_language %}bg-surface-hover text-primary font-medium{% endif %}">
                                    <span class="mr-3 flag-emoji">{{ getFlag(lang.code)|raw }}</span>
                                    <span>{{ lang.name }}</span>
                                    {% if lang.code == current_language %}
                                    <i class="fas fa-check dark:text-cyan-400 text-cyan-600 ml-auto"></i>
                                    {% endif %}
                                </button>
                            </form>
                            {% endfor %}
                        </div>
                    </div>
                    
                    <div class="flex items-center ml-2 border-l border-slate-700/50 pl-2">
                        <button onclick="globalSyncAll(this)" 
                                class="group/btn flex items-center gap-0 hover:gap-2 p-2 text-secondary hover:dark:text-cyan-400 hover:text-cyan-600 rounded-lg hover:bg-primary/10 transition-all global-sync-btn" 
                                title="{{ t('menu.sync_all') }}">
                            <i class="fas fa-sync-alt"></i>
                            <span class="max-w-0 overflow-hidden group-hover/btn:max-w-[100px] transition-all duration-300 text-[10px] font-bold uppercase tracking-wider whitespace-nowrap">
                                {{ t('menu.sync_all') }}
                            </span>
                        </button>
                    </div>

                    <div class="hidden md:flex items-center pl-4 space-x-4">
                        <button onclick="toggleTheme()" id="themeToggleBtn" class="text-secondary hover:text-primary p-2 rounded-lg hover:bg-surface-hover transition-colors" title="{{ t('common.toggle_theme') }}">
                            <i class="fas fa-sun" id="themeIcon"></i>
                        </button>
                        <div class="flex items-center text-secondary">
                            <div class="w-8 h-8 rounded-full bg-surface-hover flex items-center justify-center mr-2">
                                <i class="fas fa-user text-sm opacity-80"></i>
                            </div>
                            <span class="text-sm font-medium">{{ user.name }}</span>
                        </div>
                        <a href="/logout" class="text-secondary hover:text-primary px-3 py-2 rounded-lg hover:bg-red-500/20 hover:text-red-400 transition-colors flex items-center" title="{{ t('menu.logout') }}">
                            <i class="fas fa-sign-out-alt"></i>
                        </a>
                    </div>

                    <div class="md:hidden flex items-center ml-2">
                        <button onclick="toggleMobileMenu()" type="button" class="text-secondary hover:text-primary p-2.5 rounded-lg hover:bg-surface-hover focus:outline-none transition-colors">
                            <i class="fas fa-bars text-xl"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div id="mobileMenu" class="mobile-menu md:hidden border-t border-slate-700 panel mt-1 mx-2 mb-4 shadow-xl">
            <div class="px-3 pt-3 pb-4 space-y-1.5">
                <a href="/dashboard" class="text-secondary hover:text-primary hover:bg-surface-hover block px-4 py-3.5 rounded-lg text-base font-medium flex items-center transition-colors">
                    <i class="fas fa-tachometer-alt mr-4 w-6 text-center opacity-70 text-accent"></i>{{ t('menu.dashboard') }}
                </a>
                <button onclick="globalSyncAll(this)" class="w-full text-left text-secondary hover:text-primary hover:bg-surface-hover px-4 py-3.5 rounded-lg text-base font-medium flex items-center transition-colors">
                    <i class="fas fa-sync-alt mr-4 w-6 text-center opacity-70 text-accent"></i>{{ t('menu.sync_all') }}
                </button>
                <a href="/servers" class="text-secondary hover:text-primary hover:bg-surface-hover block px-4 py-3.5 rounded-lg text-base font-medium flex items-center transition-colors">
                    <i class="fas fa-server mr-4 w-6 text-center opacity-70 text-accent"></i>{{ t('menu.servers') }}
                </a>
                <a href="/map" class="text-secondary hover:text-primary hover:bg-surface-hover block px-4 py-3.5 rounded-lg text-base font-medium flex items-center transition-colors">
                    <i class="fas fa-globe-europe mr-4 w-6 text-center opacity-70 text-accent"></i>{{ t('menu.map')|default('Map') }}
                </a>
                <a href="/proxies" class="text-secondary hover:text-primary hover:bg-surface-hover block px-4 py-3.5 rounded-lg text-base font-medium flex items-center transition-colors">
                    <i class="fas fa-shield-alt mr-4 w-6 text-center opacity-70 text-accent"></i>{{ t('menu.proxies')|default('Proxies') }}
                </a>
                {% if user.role == 'admin' %}
                <a href="/settings" class="text-secondary hover:text-primary hover:bg-surface-hover block px-4 py-3.5 rounded-lg text-base font-medium flex items-center transition-colors">
                    <i class="fas fa-cog mr-4 w-6 text-center opacity-70 text-accent"></i>{{ t('menu.settings') }}
                </a>
                {% endif %}
                
                <div class="pt-2 mt-2 border-t border-slate-700/50">
                    <button onclick="toggleTheme()" class="w-full text-left text-secondary hover:text-primary hover:bg-surface-hover px-4 py-3.5 rounded-lg text-base font-medium flex items-center transition-colors">
                        <i class="fas fa-adjust mr-4 w-6 text-center opacity-70 text-accent"></i>{{ t('common.toggle_theme')|default('Toggle Theme') }}
                        <span class="ml-auto text-xs opacity-50 uppercase tracking-widest font-bold">
                            <span class="dark:hidden">Light</span>
                            <span class="hidden dark:inline">Dark</span>
                        </span>
                    </button>
                    <a href="/logout" class="text-secondary hover:text-primary hover:bg-surface-hover block px-4 py-3.5 rounded-lg text-base font-medium flex items-center transition-colors">
                        <i class="fas fa-sign-out-alt mr-4 w-6 text-center opacity-70 text-red-400"></i>{{ t('menu.logout') }}
                    </a>
                </div>
                <div class="text-secondary px-4 py-3 flex items-center bg-white/5 rounded-lg mx-1 mb-2">
                    <div class="w-9 h-9 rounded-full bg-surface-hover flex items-center justify-center mr-3">
                        <i class="fas fa-user text-sm opacity-80 text-accent"></i>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-sm font-semibold text-primary">{{ user.name }}</span>
                        <span class="text-[10px] text-muted uppercase tracking-widest">{{ user.role }}</span>
                    </div>
                </div>
                <a href="/logout" class="text-red-400 hover:text-red-300 hover:bg-red-500/20 block px-4 py-3.5 rounded-lg text-base font-medium flex items-center transition-colors">
                    <i class="fas fa-sign-out-alt mr-4 w-6 text-center"></i>{{ t('menu.logout') }}
                </a>
            </div>
        </div>
    </nav>
    {% endif %}

    <main class="flex-grow flex flex-col {% if user %}py-6 px-3 sm:py-8 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full{% endif %}">
        {% block content %}{% endblock %}
    </main>

    <div id="toastContainer" class="toast-container"></div>

    <footer class="mt-auto border-t border-slate-700 py-4 nav shrink-0">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <span class="text-sm text-muted font-brand tracking-tighter">{{ app_name }} &copy; {{ "now"|date("Y") }}</span>
        </div>
    </footer>

    <script>
        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('active');
        }

        function toggleLanguageDropdown() {
            const dropdown = document.getElementById('languageDropdown');
            dropdown.classList.toggle('active');
        }

        document.addEventListener('click', function(event) {
            const languageButton = event.target.closest('button[onclick="toggleLanguageDropdown()"]');
            const dropdown = document.getElementById('languageDropdown');
            const isInsideDropdown = dropdown && dropdown.contains(event.target);
            
            if (!languageButton && !isInsideDropdown && dropdown) {
                dropdown.classList.remove('active');
            }
        });

        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            if (!container) return;
            
            const toast = document.createElement('div');
            toast.className = `fixed bottom-6 right-6 px-6 py-3 rounded-xl shadow-2xl z-[100] transition-all duration-500 translate-y-12 opacity-0 flex items-center border border-white/10 ${
                type === 'success' ? 'bg-green-600 text-white' : (type === 'error' ? 'bg-red-600 text-white' : 'bg-amber-600 text-white')
            }`;
            
            const icons = {
                success: 'fa-check-circle',
                error: 'fa-exclamation-circle',
                warning: 'fa-exclamation-triangle'
            };

            const escapeHtml = (str) => {
                const div = document.createElement('div');
                div.textContent = str;
                return div.innerHTML;
            };

            toast.innerHTML = `
                <i class="fas ${icons[type] || icons.success} mr-3"></i>
                <span class="text-sm font-medium">${escapeHtml(message)}</span>
            `;

            container.appendChild(toast);
            
            // Animate in
            setTimeout(() => {
                toast.classList.remove('translate-y-12', 'opacity-0');
            }, 10);

            // Remove after 4s
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 500);
            }, 4000);
        }

        async function handleAjaxForm(event, url, isMultipart = false, callback = null) {
            if (event) event.preventDefault();
            const form = event ? event.target : null;
            const formData = form ? (isMultipart ? new FormData(form) : new URLSearchParams(new FormData(form))) : null;
            
            let btn = null;
            let originalHtml = '';
            if (form) {
                btn = form.querySelector('button[type="submit"]');
                if (btn) {
                    originalHtml = btn.innerHTML;
                    btn.innerHTML = '<i class="fas fa-circle-notch fa-spin mr-2"></i>';
                    btn.disabled = true;
                }
            }

            try {
                const response = await fetch(url, {
                    method: 'POST',
                    body: formData,
                    headers: (formData && !isMultipart) ? { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' } : { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const result = await response.json();
                
                if (result.success) {
                    showToast(result.message || 'Action completed successfully', 'success');
                    if (callback) {
                        callback(result);
                    } else if (result.redirect) {
                        setTimeout(() => window.location.href = result.redirect, 1000);
                    } else {
                        setTimeout(() => location.reload(), 1000);
                    }
                } else {
                    showToast(result.error || 'Action failed', 'error');
                }
            } catch (e) {
                showToast('Network error or server error occurred', 'error');
            } finally {
                if (btn) {
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                }
            }
        }

        async function handleAjaxAction(url, data = {}, confirmMsg = null) {
            if (confirmMsg && !confirm(confirmMsg)) return;

            let btn = null;
            let originalHtml = '';
            if (window.event && window.event.currentTarget && window.event.currentTarget.tagName === 'BUTTON') {
                btn = window.event.currentTarget;
                originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i>';
                btn.disabled = true;
            }

            try {
                const params = new URLSearchParams();
                for (const key in data) {
                    if (Array.isArray(data[key])) {
                        data[key].forEach(val => params.append(key + '[]', val));
                    } else {
                        params.append(key, data[key]);
                    }
                }
                params.append('csrf_token', '{{ csrf_token }}');

                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                    body: params
                });
                const result = await response.json();
                if (result.success) {
                    showToast(result.message || 'Action completed', 'success');
                    if (result.redirect) {
                        setTimeout(() => window.location.href = result.redirect, 1000);
                    } else {
                        setTimeout(() => location.reload(), 1000);
                    }
                } else {
                    showToast(result.error || 'Action failed', 'error');
                }
            } catch (e) {
                showToast('Network error', 'error');
            } finally {
                if (btn) {
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                }
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            const successMsg = urlParams.get('success');
            const errorMsg = urlParams.get('error');
            
            if (successMsg) {
                showToast(decodeURIComponent(successMsg), 'success');
                const cleanUrl = window.location.pathname;
                window.history.replaceState({}, '', cleanUrl);
            }
            if (errorMsg) {
                showToast(decodeURIComponent(errorMsg), 'error');
                const cleanUrl = window.location.pathname;
                window.history.replaceState({}, '', cleanUrl);
            }

            // Preserve scroll position
            const scrollPos = localStorage.getItem('globalScrollPos');
            if (scrollPos) {
                window.scrollTo(0, parseInt(scrollPos));
                localStorage.removeItem('globalScrollPos');
            }
        });

        window.addEventListener('beforeunload', () => {
            localStorage.setItem('globalScrollPos', window.scrollY);
        });

        async function globalSyncAll(btn) {
            const icon = btn.querySelector('i');
            const cards = document.querySelectorAll('.server-card');
            
            if (btn.disabled) return;
            
            btn.disabled = true;
            icon.classList.add('fa-spin');
            cards.forEach(card => card.classList.add('syncing-pulse'));
            
            try {
                const response = await fetch('/servers/sync-all', {
                    method: 'POST',
                    headers: { 
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-CSRF-Token': '{{ csrf_token }}'
                    }
                });
                const data = await response.json();
                if (data.success) {
                    setTimeout(() => location.reload(), 1200);
                } else {
                    throw new Error(data.error || 'Sync failed');
                }
            } catch (e) {
                console.error(e);
                showToast(e.message, 'error');
                icon.classList.remove('fa-spin');
                cards.forEach(card => card.classList.remove('syncing-pulse'));
                btn.disabled = false;
            }
        }

        // ── Theme Toggle ─────────────────────────────────
        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            const icon = document.getElementById('themeIcon');
            if (icon) icon.className = isDark ? 'fas fa-sun' : 'fas fa-moon text-muted';
        }

        // Sync icon on load
        document.addEventListener('DOMContentLoaded', function () {
            const icon = document.getElementById('themeIcon');
            if (icon && !document.documentElement.classList.contains('dark')) {
                icon.className = 'fas fa-moon text-muted';
            }
        });
    </script>

    {% block scripts %}{% endblock %}
</body>
</html>
