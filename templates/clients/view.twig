{% extends "layout.twig" %}
{% block title %}{{ t('clients.title') }}: {{ client.name }}{% endblock %}

{% block content %}
<div class="w-full mx-auto max-w-5xl">
    <div class="mb-6 flex flex-col md:flex-row md:items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-primary flex items-center">
                <div class="w-10 h-10 rounded-lg bg-surface-hover text-primary flex items-center justify-center mr-3">
                    <i class="fas fa-user"></i>
                </div>
                {{ client.name }}
            </h1>
            <div class="mt-2 ml-13 flex flex-wrap items-center gap-3">
                <code class="text-xs text-secondary bg-panel px-2 py-1 rounded">{{ client.client_ip }}</code>
                {% if client.external_ip %}
                <code class="text-xs text-primary bg-panel px-2 py-1 rounded" title="{{ t('clients.external_ip') }}">
                    <i class="fas fa-globe mr-1"></i>{{ client.external_ip }}
                </code>
                {% endif %}
                <span class="text-xs text-muted">
                    <i class="fas fa-calendar-alt mr-1"></i>{{ client.created_at|date('Y-m-d H:i') }}
                </span>
                <div class="flex items-center px-2 py-1 rounded {% if client.status == 'disabled' %}bg-orange-500/10 border-orange-500/20 text-orange-500{% elseif client.connection_status == 'online' %}bg-sky-500/10 border-sky-500/20 text-sky-500{% elseif client.connection_status == 'never' %}bg-muted/10 border-muted/20 text-muted{% else %}bg-red-500/10 border-red-500/20 text-red-500{% endif %} border h-5">
                    <span class="w-1 h-1 rounded-full {% if client.status == 'disabled' %}bg-orange-500{% elseif client.connection_status == 'online' %}bg-sky-500 animate-pulse{% elseif client.connection_status == 'never' %}bg-muted{% else %}bg-red-500{% endif %} mr-1.5"></span>
                    <span class="text-[9px] uppercase tracking-wider font-bold leading-none">
                        {% if client.status == 'provisioning' %}
                            {{ t('status.provisioning')|default('PROVISIONING') }}
                        {% elseif client.status == 'error' %}
                            {{ t('status.error')|default('ERROR') }}
                        {% elseif client.status == 'disabled' %}
                            {{ t('common.revoked')|default('REVOKED') }}
                        {% elseif client.connection_status == 'online' %}
                            {{ t('status.online') }}
                        {% elseif client.connection_status == 'never' %}
                            {{ t('status.never') }}
                        {% else %}
                            {{ t('status.offline') }}
                        {% endif %}
                    </span>
                </div>
                {% if client.last_sync_at %}
                <span class="text-[10px] text-muted flex items-center opacity-60" title="Last data sync">
                    <i class="fas fa-sync-alt text-[8px] mr-1"></i>
                    {{ client.last_sync_at|date('H:i:s') }}
                </span>
                {% endif %}
            </div>
        </div>
        <a href="/servers/{{ client.server_id }}" class="btn-secondary px-4 py-2 text-sm">
            <i class="fas fa-arrow-left mr-2"></i>{{ t('servers.back_to_server') }}
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="panel p-5">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-medium text-muted uppercase tracking-wide">{{ t('common.uploaded') }}</span>
                <i class="fas fa-arrow-up text-primary text-sm"></i>
            </div>
            <div class="text-2xl font-bold text-primary font-mono"><span id="sent_val">{{ (client.bytes_sent / 1024 / 1024)|number_format(2) }}</span> <span class="text-xs text-muted">{{ t('common.mb') }}</span></div>
            <div class="text-[10px] text-cyan-500 font-bold mt-1 flex items-center">
                <i class="fas fa-arrow-up mr-1 opacity-70"></i><span id="speed_up_val">{{ client.speed_up|default('0 B/s') }}</span>
            </div>
        </div>
        <div class="panel p-5">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-medium text-muted uppercase tracking-wide">{{ t('common.downloaded') }}</span>
                <i class="fas fa-arrow-down text-blue-400 text-sm"></i>
            </div>
            <div class="text-2xl font-bold text-primary font-mono"><span id="received_val">{{ (client.bytes_received / 1024 / 1024)|number_format(2) }}</span> <span class="text-xs text-muted">{{ t('common.mb') }}</span></div>
            <div class="text-[10px] text-blue-400 font-bold mt-1 flex items-center">
                <i class="fas fa-arrow-down mr-1 opacity-70"></i><span id="speed_down_val">{{ client.speed_down|default('0 B/s') }}</span>
            </div>
        </div>
        <div class="panel p-5">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-medium text-muted uppercase tracking-wide">{{ t('clients.last_handshake') }}</span>
                <i class="fas fa-clock text-primary text-sm"></i>
            </div>
            <div class="text-lg font-medium text-primary">
                {% if client.last_handshake %}
                    {{ client.last_handshake }}
                {% else %}
                    <span class="text-muted italic">{{ t('clients.never') }}</span>
                {% endif %}
            </div>
        </div>
    </div>

    {% if client.external_ip %}
    <div class="panel p-5 mb-6">
        <h3 class="text-base font-semibold mb-4 text-primary flex items-center">
            <i class="fas fa-network-wired text-primary mr-2"></i>{{ t('clients.external_ip_info') }}
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="bg-panel/50 p-3 rounded-lg border border-default/50">
                <span class="text-[10px] text-muted uppercase tracking-widest block mb-1">{{ t('clients.country') }}</span>
                <div class="flex items-center text-sm text-primary">
                    {% if client.ip_country_code %}
                    <span class="flag-emoji mr-2 text-lg">{{ getFlag(client.ip_country_code)|raw }}</span>
                    {% endif %}
                    {{ client.ip_country|default('Unknown') }}
                </div>
            </div>
            <div class="bg-panel/50 p-3 rounded-lg border border-default/50">
                <span class="text-[10px] text-muted uppercase tracking-widest block mb-1">{{ t('clients.city') }}</span>
                <span class="text-sm text-primary">{{ client.ip_city|default('Unknown') }}</span>
            </div>
            <div class="bg-panel/50 p-3 rounded-lg border border-default/50 col-span-1 md:col-span-2">
                <span class="text-[10px] text-muted uppercase tracking-widest block mb-1">{{ t('clients.isp') }}</span>
                <span class="text-sm text-primary" title="{{ client.ip_org }}">
                    {{ client.ip_isp|default('Unknown') }}
                    {% if client.ip_org and client.ip_org != client.ip_isp %}
                    <span class="text-xs text-muted block mt-0.5">({{ client.ip_org }})</span>
                    {% endif %}
                </span>
            </div>
        </div>
    </div>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 panel p-5">
            <h3 class="text-base font-semibold mb-4 text-primary flex items-center">
                <i class="fas fa-edit text-primary mr-2"></i>{{ t('clients.settings') }}
            </h3>
            
            <form onsubmit="handleAjaxForm(event, '/clients/{{ client.id }}/update')" class="mb-6">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <label class="block text-xs font-medium text-muted uppercase tracking-wide mb-2">{{ t('clients.name') }}</label>
                <div class="flex gap-2">
                    <input name="name" value="{{ client.name }}" class="input-field flex-grow px-4 py-2.5 text-sm" required>
                    <button type="submit" class="btn-primary px-4 py-2.5 text-sm">
                        <i class="fas fa-save mr-2"></i>{{ t('form.save') }}
                    </button>
                </div>
            </form>

            <div class="border-t border-default pt-4">
                <label class="block text-xs font-medium text-muted uppercase tracking-wide mb-2">{{ t('clients.configuration') }}</label>
                {% if client.status == 'active' %}
                <div class="flex flex-wrap gap-2">
                    <a href="/clients/{{ client.id }}/download" class="btn-secondary px-4 py-2.5 text-sm flex-1 text-center">
                        <i class="fas fa-download mr-2"></i>{{ t('clients.download_config') }}
                    </a>
                    <button onclick="copyConfig()" id="copyBtn" class="btn-secondary px-4 py-2.5 text-sm flex-1 text-center">
                        <i class="fas fa-copy mr-2"></i>{{ t('clients.copy_config') }}
                    </button>
                </div>
                {% else %}
                <div class="bg-panel/50 p-4 rounded-lg border border-default/50 text-center">
                    <i class="fas fa-circle-notch fa-spin text-primary mb-2"></i>
                    <p class="text-xs text-muted">{{ t('clients.config_ready_soon')|default('Configuration will be available once provisioning is complete.') }}</p>
                </div>
                {% endif %}
            </div>
            <pre id="configData" class="hidden">{{ client.config }}</pre>
        </div>

        <div class="panel p-5">
            <h3 class="text-base font-semibold mb-4 text-primary flex items-center">
                <i class="fas fa-cog text-primary mr-2"></i>{{ t('common.actions') }}
            </h3>
            <div class="space-y-3">
                <button onclick="handleAjaxAction('/clients/{{ client.id }}/sync-stats')" id="refreshStatsBtn" class="btn-secondary w-full py-2.5 text-sm">
                    <i class="fas fa-sync-alt mr-2"></i>{{ t('clients.sync_stats') }}
                </button>
                
                {% if client.status != 'active' %}
                <button onclick="handleAjaxAction('/clients/{{ client.id }}/restore')" class="w-full bg-primary/10 hover:bg-primary/20 text-primary border border-primary/30 rounded-lg py-2.5 text-sm transition-colors font-medium">
                    <i class="fas fa-check mr-2"></i>{{ t('clients.restore') }}
                </button>
                {% endif %}

                <button onclick="handleAjaxAction('/clients/{{ client.id }}/delete', {}, '{{ t('clients.delete_confirm')|e('js') }}')" class="w-full bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 rounded-lg py-2.5 text-sm transition-colors font-medium">
                    <i class="fas fa-trash-alt mr-2"></i>{{ t('clients.delete') }}
                </button>
            </div>
        </div>
    </div>
</div>

<script>
function copyConfig() {
    const text = document.getElementById('configData').innerText;
    const btn = document.getElementById('copyBtn');
    const originalHtml = btn.innerHTML;

    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(() => {
            btn.innerHTML = '<i class="fas fa-check mr-2"></i>{{ t('common.copied')|e('js') }}';
            setTimeout(() => btn.innerHTML = originalHtml, 2000);
        });
    } else {
        fallbackCopy(text, () => {
            btn.innerHTML = '<i class="fas fa-check mr-2"></i>{{ t('common.copied')|e('js') }}';
            setTimeout(() => btn.innerHTML = originalHtml, 2000);
        });
    }
}

function fallbackCopy(text, callback) {
    const textArea = document.createElement("textarea");
    textArea.value = text;
    textArea.style.cssText = 'position:fixed;left:-9999px;top:-9999px';
    document.body.appendChild(textArea);
    textArea.focus();
    textArea.select();
    try { document.execCommand('copy'); if (callback) callback(); }
    catch (err) { alert('{{ t('clients.copy_failed')|e('js') }}'); }
    document.body.removeChild(textArea);
}

// Live Status & Traffic Polling
(function() {
    const clientId = {{ client.id }};
    const initialStatus = '{{ client.status }}';
    
    function checkStatus() {
        fetch(window.location.pathname + '/status', {
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
            }
        })
        .then(r => r.json())
        .then(data => {
            if (data.success && data.data) {
                const status = data.data.db_status;
                
                // Update Traffic & Speed Live
                if (data.data.traffic) {
                    const sentEl = document.getElementById('sent_val');
                    const recvEl = document.getElementById('received_val');
                    const upEl = document.getElementById('speed_up_val');
                    const downEl = document.getElementById('speed_down_val');
                    
                    if (sentEl) sentEl.innerText = data.data.traffic.sent;
                    if (recvEl) recvEl.innerText = data.data.traffic.received;
                    if (upEl) upEl.innerText = data.data.traffic.speed_up;
                    if (downEl) downEl.innerText = data.data.traffic.speed_down;
                }

                // If status changed from transition to terminal, reload once
                const isTransition = (s) => ['provisioning', 'verifying', 'deleting'].includes(s);
                if (isTransition(initialStatus) && !isTransition(status)) {
                    window.location.reload();
                    return;
                }

                // Continue polling: 5s for active, 2s for transitions
                let nextPoll = (status === 'active') ? 5000 : 2000;
                if (status !== 'error' && status !== 'disabled') {
                    setTimeout(checkStatus, nextPoll);
                }
            }
        })
        .catch(err => {
            console.error('Status poll failed:', err);
            // Retry after 10s on network error
            setTimeout(checkStatus, 10000);
        });
    }

    // Start polling if not in a permanent error/disabled state
    if (['active', 'provisioning', 'verifying', 'deleting'].includes(initialStatus)) {
        setTimeout(checkStatus, initialStatus === 'active' ? 5000 : 1000);
    }
})();
</script>
{% endblock %}
