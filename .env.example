# Environment Configuration
APP_ENV=local
APP_NAME="NK-CORE"
SESSION_NAME=amnezia_panel_session

# Default locale
DEFAULT_LOCALE=en

# Database Configuration
DB_HOST=db
DB_PORT=3306
DB_DATABASE=amnezia_panel
DB_USERNAME=amnezia
DB_PASSWORD=amnezia

# Centrifugo WebSocket Configuration (Security Critical)
CENTRIFUGO_API_KEY=REPLACE_WITH_SECURE_RANDOM_API_KEY
CENTRIFUGO_TOKEN_HMAC_SECRET=REPLACE_WITH_SECURE_RANDOM_HMAC_SECRET
CENTRIFUGO_API_URL=http://centrifugo:8000/api
CENTRIFUGO_WS_URL=ws://localhost:8000/connection/websocket
DB_ROOT_PASSWORD=REPLACE_WITH_SECURE_ROOT_PASSWORD

# Admin Account (auto-created on first run)
ADMIN_EMAIL=admin@amnez.ia
ADMIN_PASSWORD=admin123

# API Configuration
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_SECRET_KEY
API_RATE_LIMIT=100

# VPN Defaults
DEFAULT_VPN_PORT_MIN=30000
DEFAULT_VPN_PORT_MAX=65000
DEFAULT_VPN_SUBNET=10.8.1.0/24
DEFAULT_DNS=1.1.1.1,1.0.0.1

# S3 Backup Configuration
S3_ENDPOINT=
S3_KEY=
S3_SECRET=
S3_BUCKET=
S3_REGION=

# Telegram Backup Configuration
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_PROXY_ENABLED=true
TG_PROXY_TYPE=http
TG_PROXY_HOST=
TG_PROXY_PORT=
TG_PROXY_AUTH=login:pass


BESZEL_URL=http://

BESZEL_EMAIL=

BESZEL_PASSWORD=
